//unit8_t week[]= {"segunda","terca","quarta","quinta","sexta","sabado","domingo"};

void printtime(void) {
    rtc_time_t t;
    uint8_t last_sec = 0xFF; /* valor impossível, força primeira impressão */

    while (1) {
        ds3231_read_time(&t);

        if (t.sec != last_sec) {
            last_sec = t.sec;

            printf("%04d/%02d/%02d - %02d:%02d:%02d\n",
                   t.year + 2000, t.mon, t.mday,
                   t.hour, t.min, t.sec);
        }
    }
}

void printtim1e(){
    rtc_time_t t;
    while(1){
        ds3231_read_time(&t);

        printf("sec  %02d\n", t.sec   );
        printf("min  %02d\n", t.min );
        printf("hour %02d\n", t.hour );
        printf("mday %02d\n", t.mday );
        printf("mon  %02d\n", t.mon );
        printf("year %02d\n", t.year+2000);

        printf("%04d/%02d/%02d - %02d:%02d:%02d\n",t.year+2000,t.mon,t.mday,t.hour,t.min,t.sec);
        i2c_delay2();
    }
}

/*
./rtc -a 2000 -M 8 -d 14 -h 22 -m 22 -s 00 
*/
int main_acertoRTC(int argc, char * argv[]){
    rtc_time_t t;
    ds3231_read_time(&t);

    if( argc < 13){
        printf("Usage: %s -a|-m|-d|-h|-m|-s valor\n",argv[0]);
        return 1;
    }

    if( strstr(argv[1],"-a") ){
        printf("Ano %02d ",strtol(argv[2],NULL,10));
        t.year= atoi(argv[2]);
    }
    if( strstr(argv[1],"-a") ){
        printf("mes %02d ",strtol(argv[3],NULL,10));
        t.mon = atoi(argv[4]);
    }
    if( strstr(argv[1],"-a") ){
        printf("dia %02d ",strtol(argv[4],NULL,10));
        t.mday= atoi(argv[6]);
    }
    if( strstr(argv[1],"-a") ){
        printf("Hora %02d ",strtol(argv[5],NULL,10));
        t.hour= atoi(argv[8]);
    }
    if( strstr(argv[1],"-a") ){
        printf("Minu %02d ",strtol(argv[6],NULL,10));
        t.min = atoi(argv[10]);
    }
    if( strstr(argv[1],"-a") ){
        printf("Segu %02d\n ",strtol(argv[7],NULL,10));
        t.sec = atoi(argv[12]);
    }

    ds3231_set_time(&t);
    return 0;
}


int main( int argc, char ** argv ){
    uint16_t addr;
    uint8_t data;
    
    if( argc > 4 ){
        main_acertoRTC(argc,argv);
        return 1;
    }
    if( strstr(argv[1],"-r")){
        rtc_init();
        printtime();
    }

    if( strstr(argv[1],"-i")){
        i2c_scan();
    }
    printf("Teste do i2c e do rtc\n");


  
    

