                            	   478: *
                            	   479: * do format error
                            	   480: 
                            	   481: LAB_FOER
01:00082118 7E2C            	   482: 	MOVEQ		#$2C,d7			* error code $2C "Format" error
01:0008211A 6056            	   483: 	BRA.s		LAB_XERR			* do error #d7, then warm start
                            	   484: 
