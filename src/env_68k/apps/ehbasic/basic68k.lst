Source: "basic68k.asm"
                            	    79: 							* RAM offset definitions
                            	    80: 
                            	    81: * Use this value to run out of ROM
                            	    82: 	ORG		$082000			* past the vectors in a real system
                            	    83: * Use this value to run out of RAM
                            	    84: *	ORG		$000800			* past the vectors in a real system
                            	    85: 
                            	    86: ACIA_1   =      $00100400        * Console ACIA base address
                            	    87: ACIA_2   =      $00100410        * Auxiliary ACIA base address
                            	    88: 
01:00082000 6038            	    89:          BRA    code_start       * For convenience, so you can start from first address
                            	    90: 
                            	    91: *************************************************************************************
                            	    92: *
                            	    93: * the following code is simulator specific, change to suit your system
                            	    94: 
                            	    95: * Output character to the console from register d0.b
                            	    96: 
                            	    97: VEC_OUT
01:00082002 323C0002        	    98: 		move.w	#2,D1		; Call cconout
01:00082006 4E41            	    99: 		trap	#1
01:00082008 4E75            	   100: 		RTS
                            	   101: 
                            	   102: * Output character to the second (aux) serial port from register d0.b
                            	   103: 
                            	   104:  ifne   FLASH_SUPPORT
                            	   105: 
                            	   106: VEC_OUT2
                            	   107:         MOVEM.L  A0/D1,-(A7)    * Save working registers
                            	   108: 
                            	   109: 		jsr 	 UartWrCh
                            	   110: 
                            	   111:         MOVEM.L  (A7)+,A0/D1    * Restore working registers
                            	   112:         RTS
                            	   113: 
                            	   114: * Output null terminated string pointed to by A0 to first serial port.
                            	   115: 
                            	   116: PRINTSTRING1
                            	   117:         MOVEM.L  A0/D0,-(A7)    * Save working registers
                            	   118: LP1     CMP.B    #0,(A0)        * Is it null?
                            	   119:         BEQ      RET1           * If so, return
                            	   120:         MOVE.B   (A0)+,D0       * Get character and advance pointer
                            	   121:         JSR      VEC_OUT        * Output it
                            	   122:         BRA      LP1            * Continue for rest of string
                            	   123: 
                            	   124: RET1    MOVEM.L  (A7)+,A0/D0    * Restore working registers
                            	   125:         RTS                     * Return
                            	   126: 
                            	   127: * Output null terminated string pointed to by A0 to second serial port.
                            	   128: 
                            	   129: PRINTSTRING2
                            	   130:         MOVEM.L  A0/D0,-(A7)    * Save working registers
                            	   131: LP2     CMP.B    #0,(A0)        * Is it null?
                            	   132:         BEQ      RET2           * If so, return
                            	   133:         MOVE.B   (A0)+,D0       * Get character and advance pointer
                            	   134:         JSR      VEC_OUT2       * Output it
                            	   135:         BRA      LP2            * Continue for rest of string
                            	   136: 
                            	   137: RET2    MOVEM.L  (A7)+,A0/D0    * Restore working registers
                            	   138:         RTS                     * Return
                            	   139: 
                            	   140:  endc
                            	   141: 
                            	   142: *************************************************************************************
                            	   143: *
                            	   144: * input a character from the console into register d0
                            	   145: * else return Cb=0 if there's no character available
                            	   146: 
                            	   147: VEC_IN
01:0008200A 48E74080        	   148:         MOVEM.L  A0/D1,-(A7)    * Save working registers
01:0008200E 123C0001        	   149: 		MOVE.b	#1,D1
                            	   150: 
01:00082012 4E41            	   151: 		trap	#1
                            	   152: 
01:00082014 B07C00FF        	   153:         CMP.W   #255,D0        ; compara D0 com 255 (sem afetar D0)
01:00082018 620A            	   154:         BHI     RXNOTREADY
                            	   155: 
01:0008201A 4CDF0102        	   156:         MOVEM.L  (A7)+,A0/D1    * Restore working registers
01:0008201E 003C0001        	   157:         ORI.B    #1,CCR         * Set the carry, flag we got a byte
01:00082022 4E75            	   158:         RTS                     * Return
                            	   159: RXNOTREADY
01:00082024 4CDF0102        	   160:         MOVEM.L  (A7)+,A0/D1    * Restore working registers
01:00082028 023C00FE        	   161:         ANDI.B   #$FE,CCR       * Clear the carry, flag character not available
01:0008202C 4E75            	   162:         RTS
                            	   163: 
                            	   164: * Input routine used in LOAD mode to read file from USB flash storage.
                            	   165: 
                            	   166:  ifne   FLASH_SUPPORT
                            	   167: 
                            	   168: VEC_IN2
                            	   169:         MOVEM.L  A0/D1,-(A7)    * Save working registers
                            	   170:         LEA.L    VEC_OUT2,A0    * Redirect output to aux. port.
                            	   171:         MOVE.L   A0,V_OUTPv(a3)
                            	   172: 
                            	   173: * The first time, send READ <filename> 1 1
                            	   174: * Subsequent times, send READ <filename> n 1
                            	   175: 
                            	   176:         LEA      LAB_READN(pc),A0 * Send READ command string
                            	   177:         BSR      PRINTSTRING2   * Print null terminated string
                            	   178: 
                            	   179:         LEA      load_filename(A3),A0 * Send filename string
                            	   180:         BSR      PRINTSTRING2   * Print null terminated string
                            	   181: 
                            	   182:         MOVE.B   #' ',D0       * Send space
                            	   183:         JSR      VEC_OUT2
                            	   184: 
                            	   185:         CMP.B    #1,load_first(A3) * First time?
                            	   186:         BNE      NOTFIRST1
                            	   187:         MOVE.B   #'1',D0        * Send '1'
                            	   188:         CLR.B    load_first(A3) * Clear first flag
                            	   189:         BRA      SENDCMD1
                            	   190: NOTFIRST1
                            	   191:         MOVE.B   #'n',D0        * Send 'n'
                            	   192: SENDCMD1
                            	   193:         JSR      VEC_OUT2
                            	   194:         MOVE.B   #' ',D0        * Send space
                            	   195:         JSR      VEC_OUT2
                            	   196:         MOVE.B   #'1',D0        * Send '1'
                            	   197:         JSR      VEC_OUT2
                            	   198:         MOVE.B   #$0D,D0        * Send <Return>
                            	   199:         JSR      VEC_OUT2
                            	   200: 
                            	   201:         LEA.L    VEC_OUT,A0     * Redirect output back to console port.
                            	   202:         MOVE.L   A0,V_OUTPv(a3)
                            	   203: 
                            	   204: * Read one byte from USB host
                            	   205: 
                            	   206:         LEA.L    ACIA_2,A0      * A0 points to console ACIA
                            	   207: RXNOTREADY2
                            	   208:         MOVE.B   (A0),D1        * Read ACIA status
                            	   209:         BTST     #0,D1          * Test RDRF bit
                            	   210:         BEQ.S    RXNOTREADY2    * Branch if ACIA Rx not ready
                            	   211:         MOVE.B   2(A0),D0       * Read character received
                            	   212: 
                            	   213: * Check for end of file character ('~') and if found, redirect
                            	   214: * input back to console port.
                            	   215: 
                            	   216:         CMP.B    #'~',D0        * End of file marker?
                            	   217:         BNE      NOTEOF
                            	   218:         MOVE.B   #$0D,D0        * Convert '~' to a Return
                            	   219:         LEA.L    VEC_IN,A0      * Redirect input back to console port.
                            	   220:         MOVE.L   A0,V_INPTv(a3)
                            	   221: NOTEOF
                            	   222:         MOVEM.L  (A7)+,A0/D1    * Restore working registers
                            	   223:         ORI.b    #1,CCR         * Set the carry, flag we got a byte
                            	   224:         RTS                     * Return
                            	   225: 
                            	   226:  endc
                            	   227: 
                            	   228: *************************************************************************************
                            	   229: *
                            	   230: * LOAD routine for the TS2 computer (not implemented)
                            	   231: 
                            	   232:  ifeq   FLASH_SUPPORT
                            	   233: 
                            	   234: VEC_LD
01:0008202E 7E2E            	   235:        MOVEQ           #$2E,d7                         * error code $2E "Not implemented" error
01:00082030 60000140        	   236:        BRA             LAB_XERR                        * do error #d7, then warm start
                            	   237: 
                            	   238:  endc
                            	   239: 
                            	   240: * LOAD routine for the TS2 computer. Supports a Hobbytronics USB Flash
                            	   241: * Drive Host Board connected to the auxiliary serial port.
                            	   242: 
                            	   243:  ifne   FLASH_SUPPORT
                            	   244: 
                            	   245: VEC_LD  LEA             LAB_FILENAME(PC),A0             * Prompt for filename.
                            	   246:         BSR             PRINTSTRING1                    * Print null terminated string
                            	   247:         MOVE.L          A3,A2                           * Save pointer to RAM variables
                            	   248: GETFN1  JSR             VEC_IN                          * Get character
                            	   249:         BCC             GETFN1                          * Go back if carry clear, indicating no key pressed
                            	   250:         JSR             VEC_OUT                         * Echo the character
                            	   251:         CMP.B           #$0D,D0                         * Was it <Return>?
                            	   252:         BEQ             ENDLN1                          * If so, branch
                            	   253:         CMP.B           #$7F,D0                         * Was it <Delete>?
                            	   254:         BEQ             DELETE1                         * If so, handle delete
                            	   255:         CMP.B           #$08,D0                         * Was it <Backspace?
                            	   256:         BEQ             DELETE1                         * If so, handle as delete
                            	   257:         MOVE.B          D0,load_filename(A2)            * Save in buffer
                            	   258:         ADDQ.L          #1,A2                           * Advance string pointer
                            	   259:         BRA             GETFN1                          * Go back and get next character
                            	   260: DELETE1 SUBQ.L          #1,A2                           * Delete last character entered
                            	   261:         BRA             GETFN1                          * Go back and get next character
                            	   262: 
                            	   263: ENDLN1  MOVE.B          #0,load_filename(A2)            * Add terminating null to filename
                            	   264:         LEA.L           VEC_IN2,A0                      * Redirect input from aux. port.
                            	   265:         MOVE.L          A0,V_INPTv(a3)
                            	   266:         MOVE.B          #1,load_first(A3)               * Set load_first flag
                            	   267: 
                            	   268: * Input routine will detect end of file and redirect input back to
                            	   269: * console port.
                            	   270: 
                            	   271:         RTS
                            	   272: 
                            	   273:  endc
                            	   274: 
                            	   275: *************************************************************************************
                            	   276: *
                            	   277: * SAVE routine for the TS2 computer (not implemented)
                            	   278: 
                            	   279:  ifeq   FLASH_SUPPORT
                            	   280: VEC_SV
01:00082034 7E2E            	   281:        MOVEQ           #$2E,d7                         * error code $2E "Not implemented" error
01:00082036 6000013A        	   282:        BRA             LAB_XERR                        * do error #d7, then warm start
                            	   283:  endc
                            	   284: 
                            	   285:  ifne   FLASH_SUPPORT
                            	   286: 
                            	   287: * SAVE routine for the TS2 computer. Supports a Hobbytronics USB Flash
                            	   288: * Drive Host Board connected to the auxiliary serial port.
                            	   289: 
                            	   290: * TODO: Make configurable at build time
                            	   291: 
                            	   292: VEC_SV  LEA             LAB_FILENAME(PC),A0             * Prompt for filename.
                            	   293:         BSR             PRINTSTRING1                    * Print null terminated string
                            	   294:         MOVE.L          A3,A2                           * Save pointer to RAM variables
                            	   295: GETFN   JSR             VEC_IN                          * Get character
                            	   296:         BCC             GETFN                           * Go back if carry clear, indicating no key pressed
                            	   297:         JSR             VEC_OUT                         * Echo the character
                            	   298:         CMP.B           #$0D,D0                         * Was it <Return>?
                            	   299:         BEQ             ENDLN                           * If so, branch
                            	   300:         CMP.B           #$7F,D0                         * Was it <Delete>?
                            	   301:         BEQ             DELETE                          * If so, handle delete
                            	   302:         CMP.B           #$08,D0                         * Was it <Backspace?
                            	   303:         BEQ             DELETE                          * If so, handle as delete
                            	   304:         MOVE.B          D0,load_filename(A2)            * Save in buffer
                            	   305:         ADDQ.L          #1,A2                           * Advance string pointer
                            	   306:         BRA             GETFN                           * Go back and get next character
                            	   307: DELETE  SUBQ.L          #1,A2                           * Delete last character entered
                            	   308:         BRA             GETFN                           * Go back and get next character
                            	   309: 
                            	   310: ENDLN   MOVE.B          #0,load_filename(A2)            * Add terminating null to filename
                            	   311: 
                            	   312:         LEA.L           VEC_OUT2,A0                     * Redirect output to aux. port.
                            	   313:         MOVE.L          A0,V_OUTPv(a3)
                            	   314: 
                            	   315:         LEA             LAB_WRITE(pc),A0                * Send WRITE command string
                            	   316:         BSR             PRINTSTRING2                    * Print null terminated string
                            	   317: 
                            	   318:         LEA             load_filename(A3),A0            * Send filename string
                            	   319:         BSR             PRINTSTRING2                    * Print null terminated string
                            	   320: 
                            	   321:         MOVE.B          #$0D,D0                         * Send <Return>
                            	   322:         JSR             VEC_OUT2
                            	   323: 
                            	   324:         MOVE.l          #356000,d0                      * Delay approx. 1 second to allow USB to create file
                            	   325: DELAY   SUBQ.l          #1,d0
                            	   326:         BNE             DELAY
                            	   327: 
                            	   328:         MOVEQ           #0,d0                           * Tells LIST no arguments
                            	   329:         ANDI.b          #$FE,CCR                        * Clear carry
                            	   330:         BSR             LAB_LIST                        * Call LIST routine
                            	   331: 
                            	   332:         MOVEQ           #'~',d0                         * Send tilde symbol indicate end of file (used when loading)
                            	   333:         BSR             LAB_PRNA
                            	   334: 
                            	   335:         MOVEQ           #26,d0                          * Send Control-Z to indicate end of file save operation
                            	   336:         BSR             LAB_PRNA
                            	   337: 
                            	   338:         LEA.L           VEC_OUT,A0                      * Redirect output back to console port.
                            	   339:         MOVE.L          A0,V_OUTPv(a3)
                            	   340:         RTS                                             * Return
                            	   341: 
                            	   342: LAB_WRITE
                            	   343:         dc.b            '$WRITE ',$00
                            	   344: 
                            	   345: LAB_READN
                            	   346:         dc.b            '$READ ',$00
                            	   347: 
                            	   348: LAB_FILENAME
                            	   349:         dc.b            'Filename? ',$00
                            	   350: 
                            	   351:  endc
                            	   352:         even
                            	   353: 
                            	   354: *************************************************************************************
                            	   355: 
                            	   356: code_start
                            	   357:                                 * Set up ACIA parameters
01:0008203A 41F900100400    	   358:         LEA.L   ACIA_1,A0       * A0 points to console ACIA
01:00082040 10BC0015        	   359:         MOVE.B  #$15,(A0)       * Set up ACIA1 constants (no IRQ,
                            	   360:                                 * RTS* low, 8 bit, no parity, 1 stop)
01:00082044 41F900100410    	   361:         LEA.L   ACIA_2,A0       * A0 points to aux. ACIA
01:0008204A 10BC0015        	   362:         MOVE.B  #$15,(A0)       * Set up ACIA2 constants (no IRQ,
                            	   363:                                 * RTS* low, 8 bit, no parity, 1 stop)
                            	   364: 
                            	   365: * to tell EhBASIC where and how much RAM it has pass the address in a0 and the size
                            	   366: * in d0. these values are at the end of the .inc file
                            	   367: 
01:0008204E 307C2000        	   368: 	MOVEA.l	#ram_addr,a0		* tell BASIC where RAM starts
01:00082052 203C00006000    	   369: 	MOVE.l	#ram_size,d0		* tell BASIC how big RAM is
                            	   370: 
                            	   371: * end of simulator specific code
                            	   372: 
                            	   373: 
                            	   374: ****************************************************************************************
                            	   375: ****************************************************************************************
                            	   376: ****************************************************************************************
                            	   377: ****************************************************************************************
                            	   378: *
                            	   379: * Register use :- (must improve this !!)
                            	   380: *
                            	   381: *	a6 -	temp Bpntr				* temporary BASIC execute pointer
                            	   382: *	a5 -	Bpntr					* BASIC execute (get byte) pointer
                            	   383: *	a4 -	des_sk				        * descriptor stack pointer
                            	   384: *	a3 -	ram_strt				* start of RAM. all RAM references are offsets
                            	   385: *							* from this value
                            	   386: *
                            	   387: 
                            	   388: *************************************************************************************
                            	   389: *
                            	   390: * BASIC cold start entry point. assume entry with RAM address in a0 and RAM length
                            	   391: * in d0
                            	   392: 
                            	   393: LAB_COLD
01:00082058 B0BC00004000    	   394: 	CMP.l		#$4000,d0			* compare size with 16k
01:0008205E 6C06            	   395: 	BGE.s		LAB_sizok			* branch if >= 16k
                            	   396: 
                            	   397: 							* Fatal error - not enough RAM
01:00082060 1E3C00E4        	   398:         move.b          #228,D7                         * Go to TUTOR function
01:00082064 4E4E            	   399:         trap            #14                             * Call TRAP14 handler
                            	   400: 
                            	   401: LAB_sizok
01:00082066 2648            	   402: 	MOVEA.l	a0,a3				* copy RAM base to a3
01:00082068 D1C0            	   403: 	ADDA.l	d0,a0				* a0 is top of RAM
01:0008206A 2748044A        	   404: 	MOVE.l	a0,Ememl(a3)		* set end of mem
01:0008206E 4FEB0400        	   405: 	LEA		ram_base(a3),sp		* set stack to RAM start + 1k
                            	   406: 
01:00082072 303C4EF9        	   407: 	MOVE.w	#$4EF9,d0			* JMP opcode
01:00082076 204F            	   408: 	MOVEA.l	sp,a0				* point to start of vector table
                            	   409: 
01:00082078 30C0            	   410: 	MOVE.w	d0,(a0)+			* LAB_WARM
01:0008207A 43FAFFDC        	   411: 	LEA		LAB_COLD(pc),a1		* initial warm start vector
01:0008207E 20C9            	   412: 	MOVE.l	a1,(a0)+			* set vector
                            	   413: 
01:00082080 30C0            	   414: 	MOVE.w	d0,(a0)+			* Usrjmp
01:00082082 43FA00DC        	   415: 	LEA		LAB_FCER(pc),a1		* initial user function vector
                            	   416: 							* "Function call" error
01:00082086 20C9            	   417: 	MOVE.l	a1,(a0)+			* set vector
                            	   418: 
01:00082088 30C0            	   419: 	MOVE.w	d0,(a0)+			* V_INPT JMP opcode
01:0008208A 43FAFF7E        	   420: 	LEA		VEC_IN(pc),a1		* get byte from input device vector
01:0008208E 20C9            	   421: 	MOVE.l	a1,(a0)+			* set vector
                            	   422: 
01:00082090 30C0            	   423: 	MOVE.w	d0,(a0)+			* V_OUTP JMP opcode
01:00082092 43FAFF6E        	   424: 	LEA		VEC_OUT(pc),a1		* send byte to output device vector
01:00082096 20C9            	   425: 	MOVE.l	a1,(a0)+			* set vector
                            	   426: 
01:00082098 30C0            	   427: 	MOVE.w	d0,(a0)+			* V_LOAD JMP opcode
01:0008209A 43FAFF92        	   428: 	LEA		VEC_LD(pc),a1		* load BASIC program vector
01:0008209E 20C9            	   429: 	MOVE.l	a1,(a0)+			* set vector
                            	   430: 
01:000820A0 30C0            	   431: 	MOVE.w	d0,(a0)+			* V_SAVE JMP opcode
01:000820A2 43FAFF90        	   432: 	LEA		VEC_SV(pc),a1		* save BASIC program vector
01:000820A6 20C9            	   433: 	MOVE.l	a1,(a0)+			* set vector
                            	   434: 
01:000820A8 30C0            	   435: 	MOVE.w	d0,(a0)+			* V_CTLC JMP opcode
01:000820AA 43FA2608        	   436: 	LEA		VEC_CC(pc),a1		* save CTRL-C check vector
01:000820AE 20C9            	   437: 	MOVE.l	a1,(a0)+			* set vector
                            	   438: 
                            	   439: * set-up start values
                            	   440: 
                            	   441: *##LAB_GMEM
01:000820B0 7000            	   442: 	MOVEQ		#$00,d0			* clear d0
01:000820B2 174005E4        	   443: 	MOVE.b	d0,Nullct(a3)		* default NULL count
01:000820B6 174005E5        	   444: 	MOVE.b	d0,TPos(a3)			* clear terminal position
01:000820BA 174005E8        	   445: 	MOVE.b	d0,ccflag(a3)		* allow CTRL-C check
01:000820BE 374005EA        	   446: 	MOVE.w	d0,prg_strt-2(a3)		* clear start word
01:000820C2 374005D6        	   447: 	MOVE.w	d0,BHsend(a3)		* clear value to string end word
                            	   448: 
01:000820C6 177C005005E6    	   449: 	MOVE.b	#$50,TWidth(a3)		* default terminal width byte for simulator
01:000820CC 177C000E05E2    	   450: 	MOVE.b	#$0E,TabSiz(a3)		* save default tab size = 14
                            	   451: 
01:000820D2 177C003805E7    	   452: 	MOVE.b	#$38,Iclim(a3)		* default limit for TAB = 14 for simulator
                            	   453: 
01:000820D8 49EB048E        	   454: 	LEA		des_sk(a3),a4		* set descriptor stack start
                            	   455: 
01:000820DC 41EB05EC        	   456: 	LEA		prg_strt(a3),a0		* get start of mem
01:000820E0 2748042E        	   457: 	MOVE.l	a0,Smeml(a3)		* save start of mem
                            	   458: 
01:000820E4 61000322        	   459: 	BSR		LAB_1463			* do "NEW" and "CLEAR"
01:000820E8 61000896        	   460: 	BSR		LAB_CRLF			* print CR/LF
01:000820EC 202B044A        	   461: 	MOVE.l	Ememl(a3),d0		* get end of mem
01:000820F0 90AB042E        	   462: 	SUB.l		Smeml(a3),d0		* subtract start of mem
                            	   463: 
01:000820F4 61001BBE        	   464: 	BSR		LAB_295E			* print d0 as unsigned integer (bytes free)
01:000820F8 41FA33D6        	   465: 	LEA		LAB_SMSG(pc),a0		* point to start message
01:000820FC 610008E0        	   466: 	BSR		LAB_18C3			* print null terminated string from memory
                            	   467: 
01:00082100 41FA29BA        	   468: 	LEA		LAB_RSED(pc),a0		* get pointer to value
01:00082104 61001A5A        	   469: 	BSR		LAB_UFAC			* unpack memory (a0) into FAC1
                            	   470: 
01:00082108 41FA0092        	   471: 	LEA		LAB_1274(pc),a0		* get warm start vector
01:0008210C 27480402        	   472: 	MOVE.l	a0,Wrmjpv(a3)		* set warm start vector
01:00082110 61001FC4        	   473: 	BSR		LAB_RND			* initialise
01:00082114 4EEB0400        	   474: 	JMP		LAB_WARM(a3)		* go do warm start
