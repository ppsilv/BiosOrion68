                            	  7678: *************************************************************************************
                            	  7679: *
                            	  7680: * get ASCII string equivalent into FAC1 as integer32 or float
                            	  7681: 
                            	  7682: * entry is with a5 pointing to the first character of the string
                            	  7683: * exit with a5 pointing to the first character after the string
                            	  7684: 
                            	  7685: * d0 is character
                            	  7686: * d1 is mantissa
                            	  7687: * d2 is partial and table mantissa
                            	  7688: * d3 is mantissa exponent (decimal & binary)
                            	  7689: * d4 is decimal exponent
                            	  7690: 
                            	  7691: * get FAC1 from string
                            	  7692: * this routine now handles hex and binary values from strings
                            	  7693: * starting with "$" and "%" respectively
                            	  7694: 
                            	  7695: LAB_2887
01:00084882 48E77C00        	  7696: 	MOVEM.l	d1-d5,-(sp)			* save registers
01:00084886 7200            	  7697: 	MOVEQ		#$00,d1			* clear temp accumulator
01:00084888 2601            	  7698: 	MOVE.l	d1,d3				* set mantissa decimal exponent count
01:0008488A 2801            	  7699: 	MOVE.l	d1,d4				* clear decimal exponent
01:0008488C 17410595        	  7700: 	MOVE.b	d1,FAC1_s(a3)		* clear sign byte
01:00084890 174105B5        	  7701: 	MOVE.b	d1,Dtypef(a3)		* set float data type
01:00084894 174105AF        	  7702: 	MOVE.b	d1,expneg(a3)		* clear exponent sign
01:00084898 6100E510        	  7703: 	BSR		LAB_GBYT			* get first byte back
01:0008489C 653C            	  7704: 	BCS.s		LAB_28FE			* go get floating if 1st character numeric
                            	  7705: 
01:0008489E B03C002D        	  7706: 	CMP.b		#'-',d0			* or is it -ve number
01:000848A2 6608            	  7707: 	BNE.s		LAB_289A			* branch if not
                            	  7708: 
01:000848A4 177C00FF0595    	  7709: 	MOVE.b	#$FF,FAC1_s(a3)		* set sign byte
01:000848AA 6006            	  7710: 	BRA.s		LAB_289C			* now go scan & check for hex/bin/int
                            	  7711: 
                            	  7712: LAB_289A
                            	  7713: 							* first character wasn't numeric or -
01:000848AC B03C002B        	  7714: 	CMP.b		#'+',d0			* compare with '+'
01:000848B0 6606            	  7715: 	BNE.s		LAB_289D			* branch if not '+' (go check for '.'/hex/binary
                            	  7716: 							* /integer)
                            	  7717: 	
                            	  7718: LAB_289C
                            	  7719: 							* was "+" or "-" to start, so get next character
01:000848B2 6100E4F4        	  7720: 	BSR		LAB_IGBY			* increment & scan memory
01:000848B6 6522            	  7721: 	BCS.s		LAB_28FE			* branch if numeric character
                            	  7722: 
                            	  7723: LAB_289D
01:000848B8 B03C002E        	  7724: 	CMP.b		#'.',d0			* else compare with '.'
01:000848BC 67000092        	  7725: 	BEQ		LAB_2904			* branch if '.'
                            	  7726: 
                            	  7727: 							* code here for hex/binary/integer numbers
01:000848C0 B03C0024        	  7728: 	CMP.b		#'$',d0			* compare with '$'
01:000848C4 6700010A        	  7729: 	BEQ		LAB_CHEX			* branch if '$'
                            	  7730: 
01:000848C8 B03C0025        	  7731: 	CMP.b		#'%',d0			* else compare with '%'
01:000848CC 67000164        	  7732: 	BEQ		LAB_CBIN			* branch if '%'
                            	  7733: 
01:000848D0 6000008C        	  7734: 	BRA		LAB_2Y01			* not #.$%& so return 0
                            	  7735: 
