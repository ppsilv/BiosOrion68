                            	  7169: 
01:0008457E 2049            	  7170: 	MOVEA.l	a1,a0				* copy the result string pointer back
01:00084580 6000EE80        	  7171: 	BRA		LAB_RTST			* push a string on the descriptor stack and
                            	  7172: 							* return. a0 = pointer, d1 = length
                            	  7173: 
                            	  7174: 
                            	  7175: *************************************************************************************
                            	  7176: *
                            	  7177: * duplicate the processed format string section
                            	  7178: 
                            	  7179: 							* make a string as long as the format string
                            	  7180: LAB_DupFmt
01:00084584 226F0004        	  7181: 	MOVEA.l	4+fsd(sp),a1		* get the format string descriptor pointer
01:00084588 3E290004        	  7182: 	MOVE.w	4(a1),d7			* get the format string length
01:0008458C 342F000A        	  7183: 	MOVE.w	4+fsli(sp),d2		* get the format string last index
01:00084590 3C2F0008        	  7184: 	MOVE.w	4+fsti(sp),d6		* get the format string this index
01:00084594 3206            	  7185: 	MOVE.w	d6,d1				* copy the format string this index
01:00084596 9242            	  7186: 	SUB.w		d2,d1				* subtract the format string last index
01:00084598 6202            	  7187: 	BHI.s		LAB_D002			* if > 0 skip the correction
                            	  7188: 
01:0008459A D247            	  7189: 	ADD.w		d7,d1				* else add the format string length as the
                            	  7190: 							* correction
                            	  7191: LAB_D002
01:0008459C 6100EE7E        	  7192: 	BSR		LAB_2115			* make string space d1 bytes long
                            	  7193: 							* return a0/Sutill = pointer, others unchanged
                            	  7194: 
