                            	  7221: **************************************************************************************
                            	  7222: *
                            	  7223: * process the format string
                            	  7224: 
                            	  7225: LAB_ProcFo
01:000845C2 226F0004        	  7226: 	MOVEA.l	4+fsd(sp),a1		* get the format string descriptor pointer
01:000845C6 3E290004        	  7227: 	MOVE.w	4(a1),d7			* get the format string length
01:000845CA 2251            	  7228: 	MOVEA.l	(a1),a1			* get the format string pointer
01:000845CC 3C2F000A        	  7229: 	MOVE.w	4+fsli(sp),d6		* get the format string last index
                            	  7230: 
01:000845D0 3F47000C        	  7231: 	MOVE.w	d7,4+fsdpi(sp)		* set the format string decimal point index
                            	  7232: *##	MOVE.w	#-1,4+fsdpi(sp)		* set the format string decimal point index
01:000845D4 7A00            	  7233: 	MOVEQ		#0,d5				* no decimal point
01:000845D6 7600            	  7234: 	MOVEQ		#0,d3				* no decimal characters
01:000845D8 7400            	  7235: 	MOVEQ		#0,d2				* no special characters
                            	  7236: LAB_P004
01:000845DA 10316000        	  7237: 	MOVE.b	(a1,d6.w),d0		* get a format string byte
                            	  7238: 
01:000845DE B03C002C        	  7239: 	CMP.b		#',',d0			* compare it with ","
01:000845E2 6742            	  7240: 	BEQ.s		LAB_P01A			* if "," go do the next format string byte
                            	  7241: 
01:000845E4 B03C0023        	  7242: 	CMP.b		#'#',d0			* compare it with "#"
01:000845E8 6706            	  7243: 	BEQ.s		LAB_P008			* if "#" go flag special characters
                            	  7244: 
01:000845EA B03C0025        	  7245: 	CMP.b		#'%',d0			* compare it with "%"
01:000845EE 6608            	  7246: 	BNE.s		LAB_P00C			* if not "%" go try "+"
                            	  7247: 
                            	  7248: LAB_P008
01:000845F0 4A85            	  7249: 	TST.l		d5				* test the decimal point flag
01:000845F2 6A10            	  7250: 	BPL.s		LAB_P00E			* if no point skip counting decimal characters
                            	  7251: 
01:000845F4 5243            	  7252: 	ADDQ.w	#1,d3				* else increment the decimal character count
01:000845F6 602E            	  7253: 	BRA.s		LAB_P01A			* go do the next character
                            	  7254: 
                            	  7255: LAB_P00C
01:000845F8 B03C002B        	  7256: 	CMP.b		#'+',d0			* compare it with "+"
01:000845FC 6706            	  7257: 	BEQ.s		LAB_P00E			* if "+" go flag special characters
                            	  7258: 
01:000845FE B03C002D        	  7259: 	CMP.b		#'-',d0			* compare it with "-"
01:00084602 6604            	  7260: 	BNE.s		LAB_P010			* if not "-" go check decimal point
                            	  7261: 
                            	  7262: LAB_P00E
01:00084604 8400            	  7263: 	OR.b		d0,d2				* flag special characters
01:00084606 601E            	  7264: 	BRA.s		LAB_P01A			* go do the next character
                            	  7265: 
                            	  7266: LAB_P010
01:00084608 B03C002E        	  7267: 	CMP.b		#'.',d0			* compare it with "."
01:0008460C 6614            	  7268: 	BNE.s		LAB_P018			* if not "." go check next
                            	  7269: 
                            	  7270: * "." a decimal point
                            	  7271: 
01:0008460E 4A85            	  7272: 	TST.l		d5				* if there is already a decimal point
01:00084610 6B14            	  7273: 	BMI.s		LAB_P01A			* go do the next character
                            	  7274: 
01:00084612 3006            	  7275: 	MOVE.w	d6,d0				* copy the decimal point index
01:00084614 906F000A        	  7276: 	SUB.w		4+fsli(sp),d0		* calculate it from the scan start
01:00084618 3F40000C        	  7277: 	MOVE.w	d0,4+fsdpi(sp)		* save the decimal point index
01:0008461C 7AFF            	  7278: 	MOVEQ		#-1,d5			* flag decimal point
01:0008461E 8400            	  7279: 	OR.b		d0,d2				* flag special characters
01:00084620 6004            	  7280: 	BRA.s		LAB_P01A			* go do the next character
                            	  7281: 
                            	  7282: * was not a special character
                            	  7283: 
                            	  7284: LAB_P018
01:00084622 4A02            	  7285: 	TST.b		d2				* test if there have been special characters
01:00084624 6608            	  7286: 	BNE.s		LAB_P01E			* if so exit the format string process
                            	  7287: 
                            	  7288: LAB_P01A
01:00084626 5246            	  7289: 	ADDQ.w	#1,d6				* increment the format string index
01:00084628 BE46            	  7290: 	CMP.w		d6,d7				* compare it with the format string length
01:0008462A 62AE            	  7291: 	BHI.s		LAB_P004			* if length > index go get the next character
                            	  7292: 
01:0008462C 7C00            	  7293: 	MOVEQ		#0,d6				* length = index so reset the format string
                            	  7294: 							* index
                            	  7295: LAB_P01E
01:0008462E 3F460008        	  7296: 	MOVE.w	d6,4+fsti(sp)		* save the format string this index
01:00084632 3F43000E        	  7297: 	MOVE.w	d3,4+fsdc(sp)		* save the format string decimal characters
                            	  7298: 
01:00084636 4E75            	  7299: 	RTS
