01:000839D8 7A80            	  5282: 	MOVEQ		#$80-$100,d5		* make sign -ve
                            	  5283: LAB_LOXP
01:000839DA 17450595        	  5284: 	MOVE.b	d5,FAC1_s(a3)		* save original exponent sign
01:000839DE 4847            	  5285: 	SWAP		d7				* 16 bit shift
01:000839E0 E18F            	  5286: 	LSL.l		#8,d7				* easy first part
01:000839E2 7A88            	  5287: 	MOVEQ		#$88-$100,d5		* start with byte
                            	  5288: LAB_LONE
01:000839E4 5385            	  5289: 	SUBQ.l	#1,d5				* decrement exponent
01:000839E6 DE87            	  5290: 	ADD.l		d7,d7				* shift mantissa
01:000839E8 6AFA            	  5291: 	BPL.s		LAB_LONE			* loop if not normal
                            	  5292: 
                            	  5293: LAB_LOXO
01:000839EA 27470590        	  5294: 	MOVE.l	d7,FAC1_m(a3)		* save original exponent as mantissa
01:000839EE 17450594        	  5295: 	MOVE.b	d5,FAC1_e(a3)		* save exponent for this
01:000839F2 277CB17217F80598	  5296: 	MOVE.l	#$B17217F8,FAC2_m(a3)	* LOG(2) mantissa
01:000839FA 377C8000059C    	  5297: 	MOVE.w	#$8000,FAC2_e(a3)		* LOG(2) exponent & sign
01:00083A00 176B0595059E    	  5298: 	MOVE.b	FAC1_s(a3),FAC_sc(a3)	* make sign compare = FAC1 sign
01:00083A06 6118            	  5299: 	BSR.s		LAB_MULTIPLY		* do multiply
01:00083A08 27440598        	  5300: 	MOVE.l	d4,FAC2_m(a3)		* save cordic result
01:00083A0C 6710            	  5301: 	BEQ.s		LAB_LOWZ			* branch if zero
                            	  5302: 
01:00083A0E 377C8200059C    	  5303: 	MOVE.w	#$8200,FAC2_e(a3)		* set exponent & sign
01:00083A14 176B0595059E    	  5304: 	MOVE.b	FAC1_s(a3),FAC_sc(a3)	* clear sign compare
01:00083A1A 6100FE62        	  5305: 	BSR		LAB_ADD			* and add for final result
                            	  5306: 
                            	  5307: LAB_LOWZ
01:00083A1E 4E75            	  5308: 	RTS
                            	  5309: 
                            	  5310: 
                            	  5311: *************************************************************************************
                            	  5312: *
                            	  5313: * multiply FAC1 by FAC2
                            	  5314: 
                            	  5315: LAB_MULTIPLY
01:00083A20 48E7F800        	  5316: 	MOVEM.l	d0-d4,-(sp)			* save registers
01:00083A24 4A2B0594        	  5317: 	TST.b		FAC1_e(a3)			* test FAC1 exponent
01:00083A28 6776            	  5318: 	BEQ.s		LAB_MUUF			* if exponent zero go make result zero
                            	  5319: 
01:00083A2A 102B059C        	  5320: 	MOVE.b	FAC2_e(a3),d0		* get FAC2 exponent
01:00083A2E 6770            	  5321: 	BEQ.s		LAB_MUUF			* if exponent zero go make result zero
                            	  5322: 
01:00083A30 176B059E0595    	  5323: 	MOVE.b	FAC_sc(a3),FAC1_s(a3)	* sign compare becomes sign
                            	  5324: 
01:00083A36 D02B0594        	  5325: 	ADD.b		FAC1_e(a3),d0		* multiply exponents by adding
01:00083A3A 640A            	  5326: 	BCC.s		LAB_MNOC			* branch if no carry
                            	  5327: 
01:00083A3C 903C0080        	  5328: 	SUB.b		#$80,d0			* normalise result
01:00083A40 6400E71A        	  5329: 	BCC		LAB_OFER			* if no carry do overflow
                            	  5330: 
01:00083A44 6006            	  5331: 	BRA.s		LAB_MADD			* branch
                            	  5332: 
                            	  5333: 							* no carry for exponent add
                            	  5334: LAB_MNOC
01:00083A46 903C0080        	  5335: 	SUB.b		#$80,d0			* normalise result
01:00083A4A 6554            	  5336: 	BCS.s		LAB_MUUF			* return zero if underflow
                            	  5337: 
                            	  5338: LAB_MADD
01:00083A4C 17400594        	  5339: 	MOVE.b	d0,FAC1_e(a3)		* save exponent
                            	  5340: 
                            	  5341: 							* d1 (FAC1) x d2 (FAC2)
01:00083A50 222B0590        	  5342: 	MOVE.l	FAC1_m(a3),d1		* get FAC1 mantissa
01:00083A54 242B0598        	  5343: 	MOVE.l	FAC2_m(a3),d2		* get FAC2 mantissa
                            	  5344: 
01:00083A58 3801            	  5345: 	MOVE.w	d1,d4				* copy low word FAC1
01:00083A5A 2001            	  5346: 	MOVE.l	d1,d0				* copy long word FAC1
01:00083A5C 4840            	  5347: 	SWAP		d0				* high word FAC1 to low word FAC1
01:00083A5E 3600            	  5348: 	MOVE.w	d0,d3				* copy high word FAC1
                            	  5349: 
01:00083A60 C2C2            	  5350: 	MULU		d2,d1				* low word FAC2 x low word FAC1
01:00083A62 C0C2            	  5351: 	MULU		d2,d0				* low word FAC2 x high word FAC1
01:00083A64 4842            	  5352: 	SWAP		d2				* high word FAC2 to low word FAC2
01:00083A66 C8C2            	  5353: 	MULU		d2,d4				* high word FAC2 x low word FAC1
01:00083A68 C6C2            	  5354: 	MULU		d2,d3				* high word FAC2 x high word FAC1
                            	  5355: 
                            	  5356: * done multiply, now add partial products
                            	  5357: 
                            	  5358: *			d1 =					aaaa  ----	FAC2_L x FAC1_L
                            	  5359: *			d0 =				bbbb  aaaa		FAC2_L x FAC1_H
                            	  5360: *			d4 =				bbbb  aaaa		FAC2_H x FAC1_L
                            	  5361: *			d3 =			cccc  bbbb			FAC2_H x FAC1_H
                            	  5362: *			product =		mmmm  mmmm
                            	  5363: 
01:00083A6A D2BC00008000    	  5364: 	ADD.L		#$8000,d1			* round up lowest word
01:00083A70 4241            	  5365: 	CLR.w		d1				* clear low word, don't need it
01:00083A72 4841            	  5366: 	SWAP		d1				* align high word
01:00083A74 D280            	  5367: 	ADD.l		d0,d1				* add FAC2_L x FAC1_H (can't be carry)
                            	  5368: LAB_MUF1
01:00083A76 D284            	  5369: 	ADD.l		d4,d1				* now add intermediate (FAC2_H x FAC1_L)
01:00083A78 6406            	  5370: 	BCC.s		LAB_MUF2			* branch if no carry
                            	  5371: 
01:00083A7A D6BC00010000    	  5372: 	ADD.l		#$10000,d3			* else correct result
                            	  5373: LAB_MUF2
01:00083A80 D2BC00008000    	  5374: 	ADD.l		#$8000,d1			* round up low word
01:00083A86 4241            	  5375: 	CLR.w		d1				* clear low word
01:00083A88 4841            	  5376: 	SWAP		d1				* align for final add
01:00083A8A D283            	  5377: 	ADD.l		d3,d1				* add FAC2_H x FAC1_H, result
01:00083A8C 6B08            	  5378: 	BMI.s		LAB_MUF3			* branch if normalisation not needed
                            	  5379: 
01:00083A8E D281            	  5380: 	ADD.l		d1,d1				* shift mantissa
01:00083A90 532B0594        	  5381: 	SUBQ.b	#1,FAC1_e(a3)		* adjust exponent
01:00083A94 670A            	  5382: 	BEQ.s		LAB_MUUF			* branch if underflow
                            	  5383: 
                            	  5384: LAB_MUF3
01:00083A96 27410590        	  5385: 	MOVE.l	d1,FAC1_m(a3)		* save mantissa
                            	  5386: LAB_MUEX
01:00083A9A 4CDF001F        	  5387: 	MOVEM.l	(sp)+,d0-d4			* restore registers
01:00083A9E 4E75            	  5388: 	RTS
                            	  5389: 							* either zero or underflow result
                            	  5390: LAB_MUUF
01:00083AA0 7000            	  5391: 	MOVEQ		#0,d0				* quick clear
01:00083AA2 27400590        	  5392: 	MOVE.l	d0,FAC1_m(a3)		* clear mantissa
01:00083AA6 37400594        	  5393: 	MOVE.w	d0,FAC1_e(a3)		* clear sign and exponent
01:00083AAA 60EE            	  5394: 	BRA.s		LAB_MUEX			* restore regs & exit
                            	  5395: 
                            	  5396: 
                            	  5397: *************************************************************************************
                            	  5398: *
                            	  5399: * do FAC2/FAC1, result in FAC1
                            	  5400: * fast hardware divide version
                            	  5401: 
                            	  5402: LAB_DIVIDE
01:00083AAC 2F07            	  5403: 	MOVE.l	d7,-(sp)			* save d7
01:00083AAE 7000            	  5404: 	MOVEQ		#0,d0				* clear FAC2 exponent
01:00083AB0 2400            	  5405: 	MOVE.l	d0,d2				* clear FAC1 exponent
                            	  5406: 
01:00083AB2 142B0594        	  5407: 	MOVE.b	FAC1_e(a3),d2		* get FAC1 exponent
01:00083AB6 6700E690        	  5408: 	BEQ		LAB_DZER			* if zero go do /0 error
                            	  5409: 
01:00083ABA 102B059C        	  5410: 	MOVE.b	FAC2_e(a3),d0		* get FAC2 exponent
01:00083ABE 6766            	  5411: 	BEQ.s		LAB_DIV0			* if zero return zero
                            	  5412: 
01:00083AC0 9042            	  5413: 	SUB.w		d2,d0				* get result exponent by subtracting
01:00083AC2 D07C0080        	  5414: 	ADD.w		#$80,d0			* correct 16 bit exponent result
                            	  5415: 
01:00083AC6 176B059E0595    	  5416: 	MOVE.b	FAC_sc(a3),FAC1_s(a3)	* sign compare is result sign
                            	  5417: 
                            	  5418: * now to do 32/32 bit mantissa divide
                            	  5419: 
01:00083ACC 422B059F        	  5420: 	CLR.b		flag(a3)			* clear 'flag' byte
01:00083AD0 262B0590        	  5421: 	MOVE.l	FAC1_m(a3),d3		* get FAC1 mantissa
01:00083AD4 282B0598        	  5422: 	MOVE.l	FAC2_m(a3),d4		* get FAC2 mantissa
01:00083AD8 B883            	  5423: 	CMP.l		d3,d4				* compare FAC2 with FAC1 mantissa
01:00083ADA 6744            	  5424: 	BEQ.s		LAB_MAN1			* set mantissa result = 1 if equal
                            	  5425: 
01:00083ADC 6506            	  5426: 	BCS.s		AC1gtAC2			* branch if FAC1 > FAC2
                            	  5427: 
01:00083ADE 9883            	  5428: 	SUB.l		d3,d4				* subtract FAC1 from FAC2, result now must be <1
01:00083AE0 562B059F        	  5429: 	ADDQ.b	#3,flag(a3)			* FAC2>FAC1 so set 'flag' byte
                            	  5430: AC1gtAC2
01:00083AE4 6146            	  5431: 	BSR.s		LAB_32_16			* do 32/16 divide
01:00083AE6 4841            	  5432: 	SWAP		d1				* move 16 bit result to high word
01:00083AE8 2802            	  5433: 	MOVE.l	d2,d4				* copy remainder longword
01:00083AEA 6142            	  5434: 	BSR.s		LAB_3216			* do 32/16 divide again (skip copy d4 to d2)
01:00083AEC 84C5            	  5435: 	DIVU.w	d5,d2				* now divide remainder to make guard word
01:00083AEE 1E2B059F        	  5436: 	MOVE.b	flag(a3),d7			* now normalise, get flag byte back
01:00083AF2 6708            	  5437: 	BEQ.s		LAB_DIVX			* skip add if null
                            	  5438: 
                            	  5439: * else result was >1 so we need to add 1 to result mantissa and adjust exponent
                            	  5440: 
01:00083AF4 E20F            	  5441: 	LSR.b		#1,d7				* shift 1 into eXtend
01:00083AF6 E291            	  5442: 	ROXR.l	#1,d1				* shift extend result >>
01:00083AF8 E252            	  5443: 	ROXR.w	#1,d2				* shift extend guard word >>
01:00083AFA 5200            	  5444: 	ADDQ.b	#1,d0				* adjust exponent
                            	  5445: 
                            	  5446: * now round result to 32 bits
                            	  5447: 
                            	  5448: LAB_DIVX
01:00083AFC D442            	  5449: 	ADD.w		d2,d2				* guard bit into eXtend bit
01:00083AFE 6408            	  5450: 	BCC.s		L_DIVRND			* branch if guard=0
                            	  5451: 
01:00083B00 5281            	  5452: 	ADDQ.l	#1,d1				* add guard to mantissa
01:00083B02 6404            	  5453: 	BCC.s		L_DIVRND			* branch if no overflow
                            	  5454: 
                            	  5455: LAB_SET1
01:00083B04 E291            	  5456: 	ROXR.l	#1,d1				* shift extend result >>
01:00083B06 5240            	  5457: 	ADDQ.w	#1,d0				* adjust exponent
                            	  5458: 
                            	  5459: 							* test for over/under flow
                            	  5460: L_DIVRND
01:00083B08 3600            	  5461: 	MOVE.w	d0,d3				* copy exponent
01:00083B0A 6B1A            	  5462: 	BMI.s		LAB_DIV0			* if -ve return zero
                            	  5463: 
01:00083B0C 0243FF00        	  5464: 	ANDI.w	#$FF00,d3			* mask word high byte
01:00083B10 6600E64A        	  5465: 	BNE		LAB_OFER			* branch if overflow
                            	  5466: 
                            	  5467: 							* move result into FAC1
                            	  5468: LAB_XDIV
01:00083B14 2E1F            	  5469: 	MOVE.l	(sp)+,d7			* restore d7
01:00083B16 17400594        	  5470: 	MOVE.b	d0,FAC1_e(a3)		* save result exponent
01:00083B1A 27410590        	  5471: 	MOVE.l	d1,FAC1_m(a3)		* save result mantissa
01:00083B1E 4E75            	  5472: 	RTS
                            	  5473: 
                            	  5474: * FAC1 mantissa = FAC2 mantissa so set result mantissa
                            	  5475: 
                            	  5476: LAB_MAN1
01:00083B20 7201            	  5477: 	MOVEQ		#1,d1				* set bit
01:00083B22 E2A9            	  5478: 	LSR.l		d1,d1				* bit into eXtend
01:00083B24 60DE            	  5479: 	BRA.s		LAB_SET1			* set mantissa, adjust exponent and exit
                            	  5480: 
                            	  5481: * result is zero
                            	  5482: 
                            	  5483: LAB_DIV0
01:00083B26 7000            	  5484: 	MOVEQ		#0,d0				* zero exponent & sign
01:00083B28 2200            	  5485: 	MOVE.l	d0,d1				* zero mantissa
01:00083B2A 60E8            	  5486: 	BRA		LAB_XDIV			* exit divide
                            	  5487: 
                            	  5488: * divide 16 bits into 32, AB/Ex
                            	  5489: *
                            	  5490: * d4			AAAA	BBBB			* 32 bit numerator
                            	  5491: * d3			EEEE	xxxx			* 16 bit denominator
                            	  5492: *
                            	  5493: * returns -
                            	  5494: *
                            	  5495: * d1			xxxx	DDDD			* 16 bit result
                            	  5496: * d2				HHHH	IIII		* 32 bit remainder
                            	  5497: 
                            	  5498: LAB_32_16
01:00083B2C 2404            	  5499: 	MOVE.l	d4,d2				* copy FAC2 mantissa		(AB)
                            	  5500: LAB_3216
01:00083B2E 2A03            	  5501: 	MOVE.l	d3,d5				* copy FAC1 mantissa		(EF)
01:00083B30 4245            	  5502: 	CLR.w		d5				* clear low word d1		(Ex)
01:00083B32 4845            	  5503: 	SWAP		d5				* swap high word to low word	(xE)
                            	  5504: 
                            	  5505: * d3			EEEE	FFFF			* denominator copy
                            	  5506: * d5		0000	EEEE				* denominator high word
                            	  5507: * d2			AAAA	BBBB			* numerator copy
                            	  5508: * d4			AAAA	BBBB			* numerator
                            	  5509: 
01:00083B34 88C5            	  5510: 	DIVU.w	d5,d4				* do FAC2/FAC1 high word	(AB/E)
01:00083B36 6802            	  5511: 	BVC.s		LAB_LT_1			* if no overflow DIV was ok
                            	  5512: 
01:00083B38 78FF            	  5513: 	MOVEQ		#-1,d4			* else set default value
                            	  5514: 
                            	  5515: * done the divide, now check the result, we have ...
                            	  5516: 
                            	  5517: * d3			EEEE	FFFF			* denominator copy
                            	  5518: * d5		0000	EEEE				* denominator high word
                            	  5519: * d2			AAAA	BBBB			* numerator copy
                            	  5520: * d4			MMMM	DDDD			* result MOD and DIV
                            	  5521: 
                            	  5522: LAB_LT_1
01:00083B3A 3C04            	  5523: 	MOVE.w	d4,d6				* copy 16 bit result
01:00083B3C 3204            	  5524: 	MOVE.w	d4,d1				* copy 16 bit result again
                            	  5525: 
                            	  5526: * we now have ..
                            	  5527: * d3			EEEE	FFFF			* denominator copy
                            	  5528: * d5		0000	EEEE				* denominator high word
                            	  5529: * d6			xxxx  DDDD			* result DIV copy
                            	  5530: * d1			xxxx  DDDD			* result DIV copy
                            	  5531: * d2			AAAA	BBBB			* numerator copy
                            	  5532: * d4			MMMM	DDDD			* result MOD and DIV
                            	  5533: 
                            	  5534: * now multiply out 32 bit denominator by 16 bit result
                            	  5535: * QRS = AB*D
                            	  5536: 
01:00083B3E CCC3            	  5537: 	MULU.w	d3,d6				* FFFF * DDDD =       rrrr  SSSS
01:00083B40 C8C5            	  5538: 	MULU.w	d5,d4				* EEEE * DDDD = QQQQ  rrrr
                            	  5539: 
                            	  5540: * we now have ..
                            	  5541: * d3			EEEE	FFFF			* denominator copy
                            	  5542: * d5		0000	EEEE				* denominator high word
                            	  5543: * d6				rrrr  SSSS		* 48 bit result partial low
                            	  5544: * d1			xxxx  DDDD			* result DIV copy
                            	  5545: * d2			AAAA	BBBB			* numerator copy
                            	  5546: * d4			QQQQ	rrrr			* 48 bit result partial
                            	  5547: 
01:00083B42 3E06            	  5548: 	MOVE.w	d6,d7				* copy low word of low multiply
                            	  5549: 
                            	  5550: * d7				xxxx	SSSS		* 48 bit result partial low
                            	  5551: 
01:00083B44 4246            	  5552: 	CLR.w		d6				* clear low word of low multiply
01:00083B46 4846            	  5553: 	SWAP		d6				* high word of low multiply to low word
                            	  5554: 
                            	  5555: * d6			0000	rrrr			* high word of 48 bit result partial low
                            	  5556: 
01:00083B48 D886            	  5557: 	ADD.l		d6,d4
                            	  5558: 
                            	  5559: * d4			QQQQ	RRRR			* 48 bit result partial high longword
                            	  5560: 
01:00083B4A 7C00            	  5561: 	MOVEQ		#0,d6				* clear to extend numerator to 48 bits
                            	  5562: 
                            	  5563: * now do GHI = AB0 - QRS (which is the remainder)
                            	  5564: 
01:00083B4C 9C47            	  5565: 	SUB.w		d7,d6				* low word subtract
                            	  5566: 
                            	  5567: * d6				xxxx	IIII		* remainder low word
                            	  5568: 
01:00083B4E 9584            	  5569: 	SUBX.l	d4,d2				* high longword subtract
                            	  5570: 
                            	  5571: * d2			GGGG	HHHH			* remainder high longword
                            	  5572: 
                            	  5573: * now if we got the divide correct then the remainder high longword will be +ve
                            	  5574: 
01:00083B50 6A08            	  5575: 	BPL.s		L_DDIV			* branch if result is ok (<needed)
                            	  5576: 
                            	  5577: * remainder was -ve so DDDD is too big
                            	  5578: 
                            	  5579: LAB_REMM
01:00083B52 5341            	  5580: 	SUBQ.w	#1,d1				* adjust DDDD
                            	  5581: 
                            	  5582: * d3				xxxx	FFFF		* denominator copy
                            	  5583: * d6				xxxx	IIII		* remainder low word
                            	  5584: 
01:00083B54 DC43            	  5585: 	ADD.w		d3,d6				* add EF*1 low remainder low word
                            	  5586: 
                            	  5587: * d5			0000	EEEE			* denominator high word
                            	  5588: * d2			GGGG	HHHH			* remainder high longword
                            	  5589: 
01:00083B56 D585            	  5590: 	ADDX.l	d5,d2				* add extend EF*1 to remainder high longword
01:00083B58 6BF8            	  5591: 	BMI.s		LAB_REMM			* loop if result still too big
                            	  5592: 
                            	  5593: * all done and result correct or <
                            	  5594: 
                            	  5595: L_DDIV
01:00083B5A 4842            	  5596: 	SWAP		d2				* remainder mid word to high word
                            	  5597: 
                            	  5598: * d2			HHHH	GGGG			* (high word /should/ be $0000)
                            	  5599: 
01:00083B5C 3406            	  5600: 	MOVE.w	d6,d2				* remainder in high word
                            	  5601: 
                            	  5602: * d2				HHHH	IIII		* now is 32 bit remainder
                            	  5603: * d1			xxxx	DDDD			* 16 bit result
                            	  5604: 
01:00083B5E 4E75            	  5605: 	RTS
                            	  5606: 
                            	  5607: 
                            	  5608: *************************************************************************************
                            	  5609: *
                            	  5610: * unpack memory (a0) into FAC1
                            	  5611: 
                            	  5612: LAB_UFAC
01:00083B60 2010            	  5613: 	MOVE.l	(a0),d0			* get packed value
01:00083B62 4840            	  5614: 	SWAP		d0				* exponent and sign into least significant word
01:00083B64 37400594        	  5615: 	MOVE.w	d0,FAC1_e(a3)		* save exponent and sign
01:00083B68 6708            	  5616: 	BEQ.s		LAB_NB1T			* branch if exponent (and the rest) zero
                            	  5617: 
01:00083B6A 807C0080        	  5618: 	OR.w		#$80,d0			* set MSb
01:00083B6E 4840            	  5619: 	SWAP		d0				* word order back to normal
01:00083B70 E180            	  5620: 	ASL.l		#8,d0				* shift exponent & clear guard byte
                            	  5621: LAB_NB1T
01:00083B72 27400590        	  5622: 	MOVE.l	d0,FAC1_m(a3)		* move into FAC1
                            	  5623: 
01:00083B76 102B0594        	  5624: 	MOVE.b	FAC1_e(a3),d0		* get FAC1 exponent
01:00083B7A 4E75            	  5625: 	RTS
                            	  5626: 
                            	  5627: 
                            	  5628: *************************************************************************************
                            	  5629: *
                            	  5630: * set numeric variable, pack FAC1 into Lvarpl
                            	  5631: 
                            	  5632: LAB_PFAC
01:00083B7C 2F08            	  5633: 	MOVE.l	a0,-(sp)			* save pointer
01:00083B7E 206B0472        	  5634: 	MOVEA.l	Lvarpl(a3),a0		* get destination pointer
01:00083B82 082B000605B5    	  5635: 	BTST		#6,Dtypef(a3)		* test data type
01:00083B88 670C            	  5636: 	BEQ.s		LAB_277C			* branch if floating
                            	  5637: 
01:00083B8A 610000C6        	  5638: 	BSR		LAB_2831			* convert FAC1 floating to fixed
                            	  5639: 							* result in d0 and Itemp
01:00083B8E 2080            	  5640: 	MOVE.l	d0,(a0)			* save in var
01:00083B90 205F            	  5641: 	MOVE.l	(sp)+,a0			* restore pointer
01:00083B92 4E75            	  5642: 	RTS
                            	  5643: 
                            	  5644: 
                            	  5645: *************************************************************************************
                            	  5646: *
                            	  5647: * normalise round and pack FAC1 into (a0)
                            	  5648: 
                            	  5649: LAB_2778
01:00083B94 2F08            	  5650: 	MOVE.l	a0,-(sp)			* save pointer
                            	  5651: LAB_277C
01:00083B96 6100FD60        	  5652: 	BSR		LAB_24D5			* normalise FAC1
01:00083B9A 612C            	  5653: 	BSR.s		LAB_27BA			* round FAC1
01:00083B9C 202B0590        	  5654: 	MOVE.l	FAC1_m(a3),d0		* get FAC1 mantissa
01:00083BA0 E098            	  5655: 	ROR.l		#8,d0				* align 24/32 bit mantissa
01:00083BA2 4840            	  5656: 	SWAP		d0				* exponent/sign into 0-15
01:00083BA4 C07C007F        	  5657: 	AND.w		#$7F,d0			* clear exponent and sign bit
01:00083BA8 022B00800595    	  5658: 	ANDI.b	#$80,FAC1_s(a3)		* clear non sign bits in sign
01:00083BAE 806B0594        	  5659: 	OR.w		FAC1_e(a3),d0		* OR in exponent and sign
01:00083BB2 4840            	  5660: 	SWAP		d0				* move exponent and sign back to 16-31
01:00083BB4 2080            	  5661: 	MOVE.l	d0,(a0)			* store in destination
01:00083BB6 205F            	  5662: 	MOVE.l	(sp)+,a0			* restore pointer
01:00083BB8 4E75            	  5663: 	RTS
