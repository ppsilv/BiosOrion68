01:0008213C 7E1A            	   589: 	MOVEQ		#$1A,d7			* error code $1A "String too long" error
01:0008213E 6032            	   590: 	BRA.s		LAB_XERR			* do error #d7, then warm start
                            	   591: 
                            	   592: 
                            	   593: *************************************************************************************
                            	   594: *
                            	   595: * do type missmatch error
