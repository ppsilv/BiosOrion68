                            	  9220: 
                            	  9221: 
                            	  9222: *************************************************************************************
                            	  9223: * EhBASIC keywords quick reference list								*
                            	  9224: *************************************************************************************
                            	  9225: 
                            	  9226: * glossary
                            	  9227: 
                            	  9228: *		<.>		  required
                            	  9229: *		{.|.}		  one of required
                            	  9230: *		[.]		  optional
                            	  9231: *		...		  may repeat as last
                            	  9232: 
                            	  9233: *		any		= anything
                            	  9234: *		num		= number
                            	  9235: *		state		= statement
                            	  9236: *		n		= positive integer
                            	  9237: *		str		= string
                            	  9238: *		var		= variable
                            	  9239: *		nvar		= numeric variable
                            	  9240: *		svar		= string variable
                            	  9241: *		expr		= expression
                            	  9242: *		nexpr		= numeric expression
                            	  9243: *		sexpr		= string expression
                            	  9244: 
                            	  9245: * statement separator
                            	  9246: 
                            	  9247: * :		. [<state>] : [<state>]						* done
                            	  9248: 
                            	  9249: * number bases
                            	  9250: 
                            	  9251: * %		. %<binary num>							* done
                            	  9252: * $		. $<hex num>							* done
                            	  9253: 
                            	  9254: * commands
                            	  9255: 
                            	  9256: * END		. END									* done
                            	  9257: * FOR		. FOR <nvar>=<nexpr> TO <nexpr> [STEP <nexpr>]		* done
                            	  9258: * NEXT	. NEXT [<nvar>[,<nvar>]...]					* done
                            	  9259: * DATA	. DATA [{num|["]str["]}[,{num|["]str["]}]...]		* done
                            	  9260: * INPUT	. INPUT [<">str<">;] <var>[,<var>[,<var>]...]		* done
                            	  9261: * DIM		. DIM <var>(<nexpr>[,<nexpr>[,<nexpr>]])			* done
                            	  9262: * READ	. READ <var>[,<var>[,<var>]...]				* done
                            	  9263: * LET		. [LET] <var>=<expr>						* done
                            	  9264: * DEC		. DEC <nvar>[,<nvar>[,<nvar>]...]				* done
                            	  9265: * GOTO	. GOTO <n>								* done
                            	  9266: * RUN		. RUN [<n>]								* done
                            	  9267: * IF		. IF <expr>{GOTO<n>|THEN<{n|comm}>}[ELSE <{n|comm}>]	* done
                            	  9268: * RESTORE	. RESTORE [<n>]							* done
                            	  9269: * GOSUB	. GOSUB <n>								* done
                            	  9270: * RETURN	. RETURN								* done
                            	  9271: * REM		. REM [<any>]							* done
                            	  9272: * STOP	. STOP								* done
                            	  9273: * ON		. ON <nexpr>{GOTO|GOSUB}<n>[,<n>[,<n>]...]		* done
                            	  9274: * NULL	. NULL <nexpr>							* done
                            	  9275: * INC		. INC <nvar>[,<nvar>[,<nvar>]...]				* done
                            	  9276: * WAIT	. WAIT <nexpr>,<nexpr>[,<nexpr>]				* done
                            	  9277: * LOAD	. LOAD [<sexpr>]							* done for sim
                            	  9278: * SAVE	. SAVE [<sexpr>][,[<n>][-<n>]]				* done for sim
                            	  9279: * DEF		. DEF FN<var>(<var>)=<expr>					* done
                            	  9280: * POKE	. POKE <nexpr>,<nexpr>						* done
                            	  9281: * DOKE	. DOKE <nexpr>,<nexpr>						* done
                            	  9282: * LOKE	. LOKE <nexpr>,<nexpr>						* done
                            	  9283: * CALL	. CALL <nexpr>							* done
                            	  9284: * DO		. DO									* done
                            	  9285: * LOOP	. LOOP [{WHILE|UNTIL}<nexpr>]					* done
                            	  9286: * PRINT	. PRINT [{;|,}][<expr>][{;|,}[<expr>]...]			* done
                            	  9287: * CONT	. CONT								* done
                            	  9288: * LIST	. LIST [<n>][-<n>]						* done
                            	  9289: * CLEAR	. CLEAR								* done
                            	  9290: * NEW		. NEW									* done
                            	  9291: * WIDTH	. WIDTH [<n>][,<n>]						* done
                            	  9292: * GET		. GET <var>								* done
                            	  9293: * SWAP	. SWAP <var>,<var>						* done
                            	  9294: * BITSET	. BITSET <nexpr>,<nexpr>					* done
                            	  9295: * BITCLR	. BITCLR <nexpr>,<nexpr>					* done
                            	  9296: 
                            	  9297: * sub commands (may not start a statement)
                            	  9298: 
                            	  9299: * TAB		. TAB(<nexpr>)							* done
                            	  9300: * ELSE	. IF <expr>{GOTO<n>|THEN<{n|comm}>}[ELSE <{n|comm}>]	* done
                            	  9301: * TO		. FOR <nvar>=<nexpr> TO <nexpr> [STEP <nexpr>]		* done
                            	  9302: * FN		. FN <var>(<expr>)						* done
                            	  9303: * SPC		. SPC(<nexpr>)							* done
                            	  9304: * THEN	. IF <nexpr> {THEN <{n|comm}>|GOTO <n>}			* done
                            	  9305: * NOT		. NOT <nexpr>							* done
                            	  9306: * STEP	. FOR <nvar>=<nexpr> TO <nexpr> [STEP <nexpr>]		* done
                            	  9307: * UNTIL	. LOOP [{WHILE|UNTIL}<nexpr>]					* done
                            	  9308: * WHILE	. LOOP [{WHILE|UNTIL}<nexpr>]					* done
                            	  9309: 
                            	  9310: * operators
                            	  9311: 
                            	  9312: * +		. [expr] + <expr>							* done
                            	  9313: * -		. [nexpr] - <nexpr>						* done
                            	  9314: * *		. <nexpr> * <nexpr>						* done fast hardware
                            	  9315: * /		. <nexpr> / <nexpr>						* done fast hardware
                            	  9316: * ^		. <nexpr> ^ <nexpr>						* done
                            	  9317: * AND		. <nexpr> AND <nexpr>						* done
                            	  9318: * EOR		. <nexpr> EOR <nexpr>						* done
                            	  9319: * OR		. <nexpr> OR <nexpr>						* done
                            	  9320: * >>		. <nexpr> >> <nexpr>						* done
                            	  9321: * <<		. <nexpr> << <nexpr>						* done
                            	  9322: 
                            	  9323: * compare functions
                            	  9324: 
                            	  9325: * <		. <expr> < <expr>							* done
                            	  9326: * =		. <expr> = <expr>							* done
                            	  9327: * >		. <expr> > <expr>							* done
                            	  9328: 
                            	  9329: * functions
                            	  9330: 
                            	  9331: * SGN		. SGN(<nexpr>)							* done
                            	  9332: * INT		. INT(<nexpr>)							* done
                            	  9333: * ABS		. ABS(<nexpr>)							* done
                            	  9334: * USR		. USR(<expr>)							* done
                            	  9335: * FRE		. FRE(<expr>)							* done
                            	  9336: * POS		. POS(<expr>)							* done
                            	  9337: * SQR		. SQR(<nexpr>)							* done fast shift/sub
                            	  9338: * RND		. RND(<nexpr>)							* done 32 bit PRNG
                            	  9339: * LOG		. LOG(<nexpr>)							* done fast cordic
                            	  9340: * EXP		. EXP(<nexpr>)							* done fast cordic
                            	  9341: * COS		. COS(<nexpr>)							* done fast cordic
                            	  9342: * SIN		. SIN(<nexpr>)							* done fast cordic
                            	  9343: * TAN		. TAN(<nexpr>)							* done fast cordic
                            	  9344: * ATN		. ATN(<nexpr>)							* done fast cordic
                            	  9345: * PEEK	. PEEK(<nexpr>)							* done
                            	  9346: * DEEK	. DEEK(<nexpr>)							* done
                            	  9347: * LEEK	. LEEK(<nexpr>)							* done
                            	  9348: * LEN		. LEN(<sexpr>)							* done
                            	  9349: * STR$	. STR$(<nexpr>)							* done
                            	  9350: * VAL		. VAL(<sexpr>)							* done
                            	  9351: * ASC		. ASC(<sexpr>)							* done
                            	  9352: * UCASE$	. UCASE$(<sexpr>)							* done
                            	  9353: * LCASE$	. LCASE$(<sexpr>)							* done
                            	  9354: * CHR$	. CHR$(<nexpr>)							* done
                            	  9355: * HEX$	. HEX$(<nexpr>)							* done
                            	  9356: * BIN$	. BIN$(<nexpr>)							* done
                            	  9357: * BTST	. BTST(<nexpr>,<nexpr>)						* done
                            	  9358: * MAX		. MAX(<nexpr>[,<nexpr>[,<nexpr>]...])			* done
                            	  9359: * MIN		. MIN(<nexpr>[,<nexpr>[,<nexpr>]...])			* done
                            	  9360: * PI		. PI									* done
                            	  9361: * TWOPI	. TWOPI								* done
                            	  9362: * VARPTR	. VARPTR(<var>)							* done
                            	  9363: * SADD	. SADD(<svar>)							* done
                            	  9364: * LEFT$	. LEFT$(<sexpr>,<nexpr>)					* done
                            	  9365: * RIGHT$	. RIGHT$(<sexpr>,<nexpr>)					* done
                            	  9366: * MID$	. MID$(<sexpr>,<nexpr>[,<nexpr>])				* done
                            	  9367: * USING$	. USING$(<sexpr>,<nexpr>[,<nexpr>]...])			* done
                            	  9368: 
                            	  9369: 
                            	  9370: *************************************************************************************
                            	  9371: 
                            	  9372: 	END	code_start
