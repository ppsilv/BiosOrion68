                            	  7207: 							* save it to the new string
01:000845B2 5244            	  7208: 	ADDQ.w	#1,d4				* increment the new string index
01:000845B4 5242            	  7209: 	ADDQ.w	#1,d2				* increment the format string index
01:000845B6 BE42            	  7210: 	CMP.w		d2,d7				* compare the format index with the length
01:000845B8 6602            	  7211: 	BNE.s		LAB_D00E			* if not there skip the reset
                            	  7212: 
01:000845BA 7400            	  7213: 	MOVEQ		#0,d2				* else reset the format string index
                            	  7214: LAB_D00E
01:000845BC BC42            	  7215: 	CMP.w		d2,d6				* compare the index with this index
01:000845BE 66EC            	  7216: 	BNE.s		LAB_D00A			* if not equal go do the next character
                            	  7217: 
01:000845C0 4E75            	  7218: 	RTS
