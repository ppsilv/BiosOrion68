                            	  2613: * type match check, set C for string, clear C for numeric
                            	  2614: 
                            	  2615: LAB_CKTM
01:00082C34 082B000705B5    	  2616: 	BTST.b	#7,Dtypef(a3)		* test data type flag, don't change carry
01:00082C3A 6606            	  2617: 	BNE.s		LAB_1ABA			* branch if data type is string
                            	  2618: 
                            	  2619: 							* else data type was numeric
01:00082C3C 6500F502        	  2620: 	BCS		LAB_TMER			* if required type is string do type mismatch
                            	  2621: 							* error
                            	  2622: 
01:00082C40 4E75            	  2623: 	RTS
                            	  2624: 							* data type was string, now check required type
                            	  2625: LAB_1ABA
01:00082C42 6400F4FC        	  2626: 	BCC		LAB_TMER			* if required type is numeric do type mismatch
                            	  2627: 							* error
01:00082C46 4E75            	  2628: 	RTS
                            	  2629: 
                            	  2630: 
                            	  2631: *************************************************************************************
                            	  2632: *
                            	  2633: * this routine evaluates any type of expression. first it pushes an end marker so
                            	  2634: * it knows when the expression has been evaluated, this is a precedence value of zero.
                            	  2635: * next the first value is evaluated, this can be an in line value, either numeric or
                            	  2636: * string, a variable or array element of any type, a function or even an expression
                            	  2637: * in parenthesis. this value is kept in FAC_1
                            	  2638: * after the value is evaluated a test is made on the next BASIC program byte, if it
                            	  2639: * is a comparrison operator i.e. "<", "=" or ">", then the corresponding bit is set
                            	  2640: * in the comparison evaluation flag. this test loops until no more comparrison operators
                            	  2641: * are found or more than one of any type is found. in the last case an error is generated
                            	  2642: 
                            	  2643: * evaluate expression
                            	  2644: 
                            	  2645: LAB_EVEX
01:00082C48 534D            	  2646: 	SUBQ.w	#1,a5				* decrement BASIC execute pointer
                            	  2647: LAB_EVEZ
01:00082C4A 7200            	  2648: 	MOVEQ		#0,d1				* clear precedence word
01:00082C4C 174105B5        	  2649: 	MOVE.b	d1,Dtypef(a3)		* clear the data type, $80=string, $40=integer,
                            	  2650: 							* $00=float
01:00082C50 601C            	  2651: 	BRA.s		LAB_1ACD			* enter loop
                            	  2652: 
                            	  2653: * get vector, set up operator then continue evaluation
                            	  2654: 
                            	  2655: LAB_1B43						*
01:00082C52 41FA22A6        	  2656: 	LEA		LAB_OPPT(pc),a0		* point to operator vector table
01:00082C56 30301002        	  2657: 	MOVE.w	2(a0,d1.w),d0		* get vector offset
01:00082C5A 48700000        	  2658: 	PEA		(a0,d0.w)			* push vector
                            	  2659: 
01:00082C5E 2F2B0590        	  2660: 	MOVE.l	FAC1_m(a3),-(sp)		* push FAC1 mantissa
01:00082C62 3F2B0594        	  2661: 	MOVE.w	FAC1_e(a3),-(sp)		* push sign and exponent
01:00082C66 1F2B05E3        	  2662: 	MOVE.b	comp_f(a3),-(sp)		* push comparison evaluation flag
                            	  2663: 
01:00082C6A 32301000        	  2664: 	MOVE.w	(a0,d1.w),d1		* get precedence value
                            	  2665: LAB_1ACD
01:00082C6E 3F01            	  2666: 	MOVE.w	d1,-(sp)			* push precedence value
01:00082C70 610000E4        	  2667: 	BSR		LAB_GVAL			* get value from line
01:00082C74 177C000005E3    	  2668: 	MOVE.b	#$00,comp_f(a3)		* clear compare function flag
                            	  2669: LAB_1ADB
01:00082C7A 6100012E        	  2670: 	BSR		LAB_GBYT			* scan memory
                            	  2671: LAB_1ADE
01:00082C7E 903C00BC        	  2672: 	SUB.b		#TK_GT,d0			* subtract token for > (lowest compare function)
01:00082C82 652A            	  2673: 	BCS.s		LAB_1AFA			* branch if < TK_GT
                            	  2674: 
01:00082C84 B03C0003        	  2675: 	CMP.b		#$03,d0			* compare with ">" to "<" tokens
01:00082C88 650A            	  2676: 	BCS.s		LAB_1AE0			* branch if <= TK_SGN (is compare function)
                            	  2677: 
01:00082C8A 4A2B05E3        	  2678: 	TST.b		comp_f(a3)			* test compare function flag
01:00082C8E 6660            	  2679: 	BNE.s		LAB_1B2A			* branch if compare function
                            	  2680: 
01:00082C90 60000086        	  2681: 	BRA		LAB_1B78			* go do functions
                            	  2682: 
                            	  2683: 							* was token for > = or < (d0 = 0, 1 or 2)
                            	  2684: LAB_1AE0
01:00082C94 7201            	  2685: 	MOVEQ		#1,d1				* set to 0000 0001
01:00082C96 E121            	  2686: 	ASL.b		d0,d1				* 1 if >, 2 if =, 4 if <
01:00082C98 102B05E3        	  2687: 	MOVE.b	comp_f(a3),d0		* copy old compare function flag
01:00082C9C B32B05E3        	  2688: 	EOR.b		d1,comp_f(a3)		* EOR in this compare function bit
01:00082CA0 B02B05E3        	  2689: 	CMP.b		comp_f(a3),d0		* compare old with new compare function flag
01:00082CA4 6400F4C6        	  2690: 	BCC		LAB_SNER			* if new <= old comp_f do syntax error and warm
                            	  2691: 							* start, there was more than one <, = or >
01:00082CA8 610000FE        	  2692: 	BSR		LAB_IGBY			* increment & scan memory
01:00082CAC 60D0            	  2693: 	BRA.s		LAB_1ADE			* go do next character
                            	  2694: 
                            	  2695: 							* token is < ">" or > "<" tokens
                            	  2696: LAB_1AFA
01:00082CAE 4A2B05E3        	  2697: 	TST.b		comp_f(a3)			* test compare function flag
01:00082CB2 663C            	  2698: 	BNE.s		LAB_1B2A			* branch if compare function
                            	  2699: 
                            	  2700: 							* was < TK_GT so is operator or lower
01:00082CB4 D03C000A        	  2701: 	ADD.b	#(TK_GT-TK_PLUS),d0		* add # of operators (+ - * / ^ AND OR EOR)
01:00082CB8 645E            	  2702: 	BCC.s		LAB_1B78			* branch if < + operator
                            	  2703: 
01:00082CBA 6608            	  2704: 	BNE.s		LAB_1B0B			* branch if not + token
                            	  2705: 
01:00082CBC 4A2B05B5        	  2706: 	TST.b		Dtypef(a3)			* test data type, $80=string, $40=integer,
                            	  2707: 							* $00=float
01:00082CC0 6B000872        	  2708: 	BMI		LAB_224D			* type is string & token was +
                            	  2709: 
                            	  2710: LAB_1B0B
01:00082CC4 7200            	  2711: 	MOVEQ		#0,d1				* clear longword
01:00082CC6 D000            	  2712: 	ADD.b		d0,d0				* *2
01:00082CC8 D000            	  2713: 	ADD.b		d0,d0				* *4
01:00082CCA 1200            	  2714: 	MOVE.b	d0,d1				* copy to index
                            	  2715: LAB_1B13
01:00082CCC 301F            	  2716: 	MOVE.w	(sp)+,d0			* pull previous precedence
01:00082CCE 41FA222A        	  2717: 	LEA		LAB_OPPT(pc),a0		* set pointer to operator table
01:00082CD2 B0701000        	  2718: 	CMP.w		(a0,d1.w),d0		* compare with this opperator precedence
01:00082CD6 6446            	  2719: 	BCC.s		LAB_1B7D			* branch if previous precedence (d0) >=
                            	  2720: 
01:00082CD8 6100FF58        	  2721: 	BSR		LAB_CTNM			* check if source is numeric, else type mismatch
                            	  2722: LAB_1B1C
01:00082CDC 3F00            	  2723: 	MOVE.w	d0,-(sp)			* save precedence
                            	  2724: LAB_1B1D
01:00082CDE 6100FF72        	  2725: 	BSR		LAB_1B43			* get vector, set-up operator and continue
                            	  2726: 							* evaluation
01:00082CE2 301F            	  2727: 	MOVE.w	(sp)+,d0			* restore precedence
01:00082CE4 222B05D8        	  2728: 	MOVE.l	prstk(a3),d1		* get stacked function pointer
01:00082CE8 6A22            	  2729: 	BPL.s		LAB_1B3C			* branch if stacked values
                            	  2730: 
01:00082CEA 3000            	  2731: 	MOVE.w	d0,d0				* copy precedence (set flags)
01:00082CEC 672E            	  2732: 	BEQ.s		LAB_1B7B			* exit if done
                            	  2733: 
01:00082CEE 603C            	  2734: 	BRA.s		LAB_1B86			* else pop FAC2 & return (do function)
                            	  2735: 
                            	  2736: 							* was compare function (< = >)
                            	  2737: LAB_1B2A
01:00082CF0 102B05B5        	  2738: 	MOVE.b	Dtypef(a3),d0		* get data type flag
01:00082CF4 122B05E3        	  2739: 	MOVE.b	comp_f(a3),d1		* get compare function flag
01:00082CF8 D000            	  2740: 	ADD.b		d0,d0				* string bit flag into X bit
01:00082CFA D301            	  2741: 	ADDX.b	d1,d1				* shift compare function flag
                            	  2742: 
01:00082CFC 177C000005B5    	  2743: 	MOVE.b	#0,Dtypef(a3)		* clear data type flag, $00=float
01:00082D02 174105E3        	  2744: 	MOVE.b	d1,comp_f(a3)		* save new compare function flag
01:00082D06 534D            	  2745: 	SUBQ.w	#1,a5				* decrement BASIC execute pointer
01:00082D08 7230            	  2746: 	MOVEQ		#(TK_LT-TK_PLUS)*4,d1	* set offset to last operator entry
01:00082D0A 60C0            	  2747: 	BRA.s		LAB_1B13			* branch always
                            	  2748: 
                            	  2749: LAB_1B3C
01:00082D0C 41FA21EC        	  2750: 	LEA		LAB_OPPT(pc),a0		* point to function vector table
01:00082D10 B0701000        	  2751: 	CMP.w		(a0,d1.w),d0		* compare with this opperator precedence
01:00082D14 6416            	  2752: 	BCC.s		LAB_1B86			* branch if d0 >=, pop FAC2 & return
                            	  2753: 
01:00082D16 60C4            	  2754: 	BRA.s		LAB_1B1C			* branch always
