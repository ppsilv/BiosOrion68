                            	  7302: *************************************************************************************
                            	  7303: *
                            	  7304: * perform BIN$()
                            	  7305: * # of leading 0s is in d1, the number is in d0
                            	  7306: 
                            	  7307: LAB_BINS
01:00084638 B23C0021        	  7308: 	CMP.b		#$21,d1			* max + 1
01:0008463C 6400DB22        	  7309: 	BCC		LAB_FCER			* exit if too big ( > or = )
                            	  7310: 
01:00084640 741F            	  7311: 	MOVEQ		#$1F,d2			* bit count-1
01:00084642 41EB05B6        	  7312: 	LEA		Binss(a3),a0		* point to string
01:00084646 7830            	  7313: 	MOVEQ		#$30,d4			* "0" character for ADDX
                            	  7314: NextB1
01:00084648 7600            	  7315: 	MOVEQ		#0,d3				* clear byte
01:0008464A E288            	  7316: 	LSR.l		#1,d0				* shift bit into Xb
01:0008464C D704            	  7317: 	ADDX.b	d4,d3				* add carry and character to zero
01:0008464E 11832000        	  7318: 	MOVE.b	d3,(a0,d2.w)		* save character to string
01:00084652 51CAFFF4        	  7319: 	DBF		d2,NextB1			* decrement and loop if not done
                            	  7320: 
                            	  7321: * this is the exit code and is also used by HEX$()
                            	  7322: 
                            	  7323: EndBHS
01:00084656 177C000005D6    	  7324: 	MOVE.b	#0,BHsend(a3)		* null terminate the string
01:0008465C 4A01            	  7325: 	TST.b		d1				* test # of characters
01:0008465E 670E            	  7326: 	BEQ.s		NextB2			* go truncate string
                            	  7327: 
01:00084660 4481            	  7328: 	NEG.l		d1				* make -ve
01:00084662 D2BC000005D6    	  7329: 	ADD.l		#BHsend,d1			* effectively (end-length)
01:00084668 41F31000        	  7330: 	LEA		0(a3,d1.w),a0		* effectively add (end-length) to pointer
01:0008466C 600E            	  7331: 	BRA.s		BinPr				* go print string
                            	  7332: 
                            	  7333: * truncate string to remove leading "0"s
                            	  7334: 
                            	  7335: NextB2
01:0008466E 1010            	  7336: 	MOVE.b	(a0),d0			* get byte
01:00084670 670A            	  7337: 	BEQ.s		BinPr				* if null then end of string so add 1 and go
                            	  7338: 							* print it
                            	  7339: 
01:00084672 B03C0030        	  7340: 	CMP.b		#'0',d0			* compare with "0"
01:00084676 660E            	  7341: 	BNE.s		GoPr				* if not "0" then go print string from here
                            	  7342: 
01:00084678 5248            	  7343: 	ADDQ.w	#1,a0				* else increment pointer
01:0008467A 60F2            	  7344: 	BRA.s		NextB2			* loop always
                            	  7345: 
                            	  7346: * make fixed length output string - ignore overflows!
                            	  7347: 
                            	  7348: BinPr
01:0008467C 43EB05D6        	  7349: 	LEA		BHsend(a3),a1		* get string end
01:00084680 B1C9            	  7350: 	CMPA.l	a1,a0				* are we at the string end
01:00084682 6602            	  7351: 	BNE.s		GoPr				* branch if not
                            	  7352: 
01:00084684 5348            	  7353: 	SUBQ.w	#1,a0				* else need at least one zero
                            	  7354: GoPr
01:00084686 6000ED34        	  7355: 	BRA		LAB_20AE			* print " terminated string to FAC1, stack & RET
                            	  7356: 
