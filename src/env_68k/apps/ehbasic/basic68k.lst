01:000848D8 646C            	  7738: 	BCC.s		LAB_2902			* exit loop if not a digit
                            	  7739: 
                            	  7740: LAB_28FE
01:000848DA 610001A8        	  7741: 	BSR		d1x10				* multiply d1 by 10 and add character
01:000848DE 64F4            	  7742: 	BCC.s		LAB_28FD			* loop for more if no overflow
                            	  7743: 
                            	  7744: LAB_28FF
                            	  7745: 							* overflowed mantissa, count 10s exponent
01:000848E0 5283            	  7746: 	ADDQ.l	#1,d3				* increment mantissa decimal exponent count
01:000848E2 6100E4C4        	  7747: 	BSR		LAB_IGBY			* get next character
