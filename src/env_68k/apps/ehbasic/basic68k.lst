                            	  5707: 
                            	  5708: LAB_27CA
01:00083BF4 7000            	  5709: 	MOVEQ		#0,d0				* clear d0
01:00083BF6 102B0594        	  5710: 	MOVE.b	FAC1_e(a3),d0		* get FAC1 exponent
01:00083BFA 67F6            	  5711: 	BEQ.s		RTS_017			* exit if zero (already correct SGN(0)=0)
                            	  5712: 
                            	  5713: 
                            	  5714: *************************************************************************************
                            	  5715: *
                            	  5716: * return d0=-1,C=1/-ve d0=+1,C=0/+ve
                            	  5717: * no = 0 check
                            	  5718: 
                            	  5719: LAB_27CE
01:00083BFC 102B0595        	  5720: 	MOVE.b	FAC1_s(a3),d0		* else get FAC1 sign (b7)
                            	  5721: 
                            	  5722: 
                            	  5723: *************************************************************************************
                            	  5724: *
                            	  5725: * return d0=-1,C=1/-ve d0=+1,C=0/+ve
                            	  5726: * no = 0 check, sign in d0
                            	  5727: 
                            	  5728: LAB_27D0
01:00083C00 4880            	  5729: 	EXT.w		d0				* make word
01:00083C02 48C0            	  5730: 	EXT.l		d0				* make longword
01:00083C04 E080            	  5731: 	ASR.l		#8,d0				* move sign bit through byte to carry
01:00083C06 65EA            	  5732: 	BCS.s		RTS_017			* exit if carry set
                            	  5733: 
01:00083C08 7001            	  5734: 	MOVEQ		#1,d0				* set result for +ve sign
01:00083C0A 4E75            	  5735: 	RTS
                            	  5736: 
                            	  5737: 
                            	  5738: *************************************************************************************
                            	  5739: *
