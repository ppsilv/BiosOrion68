01:00084572 2248            	  7157: 	MOVEA.l	a0,a1				* copy the string result pointer
01:00084574 3200            	  7158: 	MOVE.w	d0,d1				* copy the string result length
                            	  7159: 
                            	  7160: * pop the format string off the descriptor stack
                            	  7161: 
01:00084576 205F            	  7162: 	MOVEA.l	(sp)+,a0			* pull the format string descriptor pointer
01:00084578 6100F032        	  7163: 	BSR		LAB_22BA			* pop (a0) descriptor, returns with ..
                            	  7164: 							* d0 = length, a0 = pointer
                            	  7165: 
01:0008457C 508F            	  7166: 	LEA		fend(sp),sp			* dump the saved values
                            	  7167: 
