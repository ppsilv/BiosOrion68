                            	  7358: *************************************************************************************
                            	  7359: *
                            	  7360: * perform HEX$()
                            	  7361: * # of leading 0s is in d1, the number is in d0
                            	  7362: 
                            	  7363: LAB_HEXS
01:0008468A B23C0009        	  7364: 	CMP.b		#$09,d1			* max + 1
01:0008468E 6400DAD0        	  7365: 	BCC		LAB_FCER			* exit if too big ( > or = )
                            	  7366: 
01:00084692 7407            	  7367: 	MOVEQ		#$07,d2			* nibble count-1
01:00084694 41EB05CE        	  7368: 	LEA		Hexss(a3),a0		* point to string
01:00084698 7830            	  7369: 	MOVEQ		#$30,d4			* "0" character for ABCD
                            	  7370: NextH1
01:0008469A 1600            	  7371: 	MOVE.b	d0,d3				* copy lowest byte
01:0008469C E898            	  7372: 	ROR.l		#4,d0				* shift nibble into 0-3
01:0008469E C63C000F        	  7373: 	AND.b		#$0F,d3			* just this nibble
01:000846A2 1A03            	  7374: 	MOVE.b	d3,d5				* copy it
01:000846A4 DA3C00F6        	  7375: 	ADD.b		#$F6,d5			* set extend bit
01:000846A8 C704            	  7376: 	ABCD		d4,d3				* decimal add extend and character to zero
01:000846AA 11832000        	  7377: 	MOVE.b	d3,(a0,d2.w)		* save character to string
01:000846AE 51CAFFEA        	  7378: 	DBF		d2,NextH1			* decrement and loop if not done
                            	  7379: 
01:000846B2 60A2            	  7380: 	BRA.s		EndBHS			* go process string
