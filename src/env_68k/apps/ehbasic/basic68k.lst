                            	  6448: *************************************************************************************
                            	  6449: *
                            	  6450: * RND(n), 32 bit Galois version. make n=0 for 19th next number in sequence or n<>0
                            	  6451: * to get 19th next number in sequence after seed n. This version of the PRNG uses
                            	  6452: * the Galois method and a sample of 65536 bytes produced gives the following values.
                            	  6453: 
                            	  6454: * Entropy = 7.997442 bits per byte
                            	  6455: * Optimum compression would reduce these 65536 bytes by 0 percent
                            	  6456: 
                            	  6457: * Chi square distribution for 65536 samples is 232.01, and
                            	  6458: * randomly would exceed this value 75.00 percent of the time
                            	  6459: 
                            	  6460: * Arithmetic mean value of data bytes is 127.6724, 127.5 would be random
                            	  6461: * Monte Carlo value for Pi is 3.122871269, error 0.60 percent
                            	  6462: * Serial correlation coefficient is -0.000370, totally uncorrelated would be 0.0
                            	  6463: 
                            	  6464: LAB_RND
01:000840D6 4A2B0594        	  6465: 	TST.b		FAC1_e(a3)			* get FAC1 exponent
01:000840DA 6708            	  6466: 	BEQ.s		NextPRN			* do next random number if zero
                            	  6467: 
                            	  6468: 							* else get seed into random number store
01:000840DC 41EB05A0        	  6469: 	LEA		PRNlword(a3),a0		* set PRNG pointer
01:000840E0 6100FAB2        	  6470: 	BSR		LAB_2778			* pack FAC1 into (a0)
                            	  6471: NextPRN
01:000840E4 72AF            	  6472: 	MOVEQ		#$AF-$100,d1		* set EOR value
01:000840E6 7412            	  6473: 	MOVEQ		#18,d2			* do this 19 times
01:000840E8 202B05A0        	  6474: 	MOVE.l	PRNlword(a3),d0		* get current
                            	  6475: Ninc0
01:000840EC D080            	  6476: 	ADD.l		d0,d0				* shift left 1 bit
01:000840EE 6402            	  6477: 	BCC.s		Ninc1				* branch if bit 32 not set
                            	  6478: 
01:000840F0 B300            	  6479: 	EOR.b		d1,d0				* do Galois LFSR feedback
                            	  6480: Ninc1
01:000840F2 51CAFFF8        	  6481: 	DBF		d2,Ninc0			* loop
                            	  6482: 
01:000840F6 274005A0        	  6483: 	MOVE.l	d0,PRNlword(a3)		* save back to seed word
01:000840FA 27400590        	  6484: 	MOVE.l	d0,FAC1_m(a3)		* copy to FAC1 mantissa
01:000840FE 377C80000594    	  6485: 	MOVE.w	#$8000,FAC1_e(a3)		* set the exponent and clear the sign
01:00084104 6000F7F2        	  6486: 	BRA		LAB_24D5			* normalise FAC1 & return
