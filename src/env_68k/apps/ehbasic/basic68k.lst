                            	  7406: 
                            	  7407: *************************************************************************************
                            	  7408: *
                            	  7409: * get byte from input device, no waiting
                            	  7410: * returns with carry set if byte in A
                            	  7411: 
                            	  7412: INGET
01:000846DA 4EAB040C        	  7413: 	JSR		V_INPT(a3)			* call scan input device
01:000846DE 650A            	  7414: 	BCS.s		LAB_FB95			* if byte go reset timer
                            	  7415: 
01:000846E0 102B05EA        	  7416: 	MOVE.b	ccnull(a3),d0		* get countdown
01:000846E4 67F2            	  7417: 	BEQ.s		RTS_022			* exit if empty
                            	  7418: 
01:000846E6 102B05E9        	  7419: 	MOVE.b	ccbyte(a3),d0		* get last received byte
                            	  7420: LAB_FB95
01:000846EA 177C000005EA    	  7421: 	MOVE.b	#$00,ccnull(a3)		* clear timer because we got a byte
01:000846F0 003C0001        	  7422: 	ORI.b		#1,CCR			* set carry, flag we got a byte
01:000846F4 4E75            	  7423: 	RTS
