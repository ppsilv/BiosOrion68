                            	   487: *
                            	   488: * do address error
                            	   489: 
                            	   490: LAB_ADER
01:0008211C 7E2A            	   491: 	MOVEQ		#$2A,d7			* error code $2A "Address" error
01:0008211E 6052            	   492: 	BRA.s		LAB_XERR			* do error #d7, then warm start
                            	   493: 
                            	   494: 
                            	   495: *************************************************************************************
                            	   496: *
                            	   497: * do wrong dimensions error
                            	   498: 
                            	   499: LAB_WDER
01:00082120 7E28            	   500: 	MOVEQ		#$28,d7			* error code $28 "Wrong dimensions" error
01:00082122 604E            	   501: 	BRA.s		LAB_XERR			* do error #d7, then warm start
                            	   502: 
                            	   503: 
                            	   504: *************************************************************************************
                            	   505: *
                            	   506: * do undimensioned array error
                            	   507: 
                            	   508: LAB_UDER
01:00082124 7E26            	   509: 	MOVEQ		#$26,d7			* error code $26 "undimensioned array" error
01:00082126 604A            	   510: 	BRA.s		LAB_XERR			* do error #d7, then warm start
                            	   511: 
                            	   512: 
                            	   513: *************************************************************************************
                            	   514: *
                            	   515: * do undefined variable error
                            	   516: 
                            	   517: LAB_UVER
                            	   518: 
                            	   519: * if you do want a non existant variable to return an error then leave the novar
                            	   520: * value at the top of this file set to zero
                            	   521: 
                            	   522:  ifeq	novar
                            	   523: 
01:00082128 7E24            	   524: 	MOVEQ		#$24,d7			* error code $24 "undefined variable" error
01:0008212A 6046            	   525: 	BRA.s		LAB_XERR			* do error #d7, then warm start
                            	   526: 
                            	   527:  endc
                            	   528: 
                            	   529: * if you want a non existant variable to return a null value then set the novar
                            	   530: * value at the top of this file to some non zero value
                            	   531: 
                            	   532:  ifne	novar
                            	   533: 
                            	   534: 	ADD.l		d0,d0				* .......$ .......& ........ .......0
                            	   535: 	SWAP		d0				* ........ .......0 .......$ .......&
                            	   536: 	ROR.b		#1,d0				* ........ .......0 .......$ &.......
                            	   537: 	LSR.w		#1,d0				* ........ .......0 0....... $&.....­.
                            	   538: 	AND.b		#$C0,d0			* mask the type bits
                            	   539: 	MOVE.b	d0,Dtypef(a3)		* save the data type
                            	   540: 
                            	   541: 	MOVEQ		#0,d0				* clear d0 and set the zero flag
                            	   542: 	MOVEA.l	d0,a0				* return a null address
                            	   543: 	RTS
                            	   544: 
                            	   545:  endc
                            	   546: 
                            	   547: 
                            	   548: *************************************************************************************
                            	   549: *
                            	   550: * do loop without do error
                            	   551: 
                            	   552: LAB_LDER
01:0008212C 7E22            	   553: 	MOVEQ		#$22,d7			* error code $22 "LOOP without DO" error
01:0008212E 6042            	   554: 	BRA.s		LAB_XERR			* do error #d7, then warm start
                            	   555: 
                            	   556: 
