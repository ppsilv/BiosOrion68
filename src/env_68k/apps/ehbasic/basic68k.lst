                            	   597: LAB_TMER
01:00082140 7E18            	   598: 	MOVEQ		#$18,d7			* error code $18 "Type mismatch" error
01:00082142 602E            	   599: 	BRA.s		LAB_XERR			* do error #d7, then warm start
                            	   600: 
                            	   601: 
                            	   602: *************************************************************************************
                            	   603: *
