                            	  5869: 
                            	  5870: *************************************************************************************
                            	  5871: *
                            	  5872: * print " in line [LINE #]"
                            	  5873: 
                            	  5874: LAB_2953
01:00083CA8 41FA17F0        	  5875: 	LEA		LAB_LMSG(pc),a0		* point to " in line " message
01:00083CAC 6100ED30        	  5876: 	BSR		LAB_18C3			* print null terminated string
                            	  5877: 
                            	  5878: 							* Print Basic line #
01:00083CB0 202B0452        	  5879: 	MOVE.l	Clinel(a3),d0		* get current line
                            	  5880: 
                            	  5881: 
                            	  5882: *************************************************************************************
                            	  5883: *
                            	  5884: * print d0 as unsigned integer
                            	  5885: 
                            	  5886: LAB_295E
01:00083CB4 43FA0DDE        	  5887: 	LEA		Bin2dec(pc),a1		* get table address
01:00083CB8 7200            	  5888: 	MOVEQ		#0,d1				* table index
01:00083CBA 41EB05CC        	  5889: 	LEA		Usdss(a3),a0		* output string start
01:00083CBE 2401            	  5890: 	MOVE.l	d1,d2				* output string index
                            	  5891: LAB_2967
01:00083CC0 26311000        	  5892: 	MOVE.l	(a1,d1.w),d3		* get table value
01:00083CC4 6714            	  5893: 	BEQ.s		LAB_2969			* exit if end marker
                            	  5894: 
01:00083CC6 782F            	  5895: 	MOVEQ		#'0'-1,d4			* set character to "0"-1
                            	  5896: LAB_2968
01:00083CC8 5244            	  5897: 	ADDQ.w	#1,d4				* next numeric character
01:00083CCA 9083            	  5898: 	SUB.l		d3,d0				* subtract table value
01:00083CCC 6AFA            	  5899: 	BPL.s		LAB_2968			* not overdone so loop
                            	  5900: 
01:00083CCE D083            	  5901: 	ADD.l		d3,d0				* correct value
01:00083CD0 11842000        	  5902: 	MOVE.b	d4,(a0,d2.w)		* character out to string
01:00083CD4 5841            	  5903: 	ADDQ.w	#4,d1				* increment table pointer
01:00083CD6 5242            	  5904: 	ADDQ.w	#1,d2				* increment output string pointer
01:00083CD8 60E6            	  5905: 	BRA.s		LAB_2967			* loop
                            	  5906: 
                            	  5907: LAB_2969
01:00083CDA D03C0030        	  5908: 	ADD.b		#'0',d0			* make last character
01:00083CDE 11802000        	  5909: 	MOVE.b	d0,(a0,d2.w)		* character out to string
01:00083CE2 5348            	  5910: 	SUBQ.w	#1,a0				* decrement a0 (allow simple loop)
                            	  5911: 
                            	  5912: 							* now find non zero start of string
                            	  5913: LAB_296A
01:00083CE4 5248            	  5914: 	ADDQ.w	#1,a0				* increment a0 (this will never carry to b16)
01:00083CE6 43EB05D5        	  5915: 	LEA		BHsend-1(a3),a1		* get string end
01:00083CEA B1C9            	  5916: 	CMPA.l	a1,a0				* are we at end
01:00083CEC 6700ECF0        	  5917: 	BEQ		LAB_18C3			* if so print null terminated string and RETURN
                            	  5918: 
01:00083CF0 0C100030        	  5919: 	CMPI.b	#'0',(a0)			* is character "0" ?
01:00083CF4 67EE            	  5920: 	BEQ.s		LAB_296A			* loop if so
                            	  5921: 
01:00083CF6 6000ECE6        	  5922: 	BRA		LAB_18C3			* print null terminated string from memory & RET
                            	  5923: 
                            	  5924: 
                            	  5925: *************************************************************************************
                            	  5926: *
                            	  5927: * convert FAC1 to ASCII string result in (a0)
                            	  5928: * STR$() function enters here
                            	  5929: 
                            	  5930: * now outputs 7 significant digits
                            	  5931: 
                            	  5932: * d0 is character out
                            	  5933: * d1 is save index
                            	  5934: * d2 is gash
                            	  5935: 
                            	  5936: * a0 is output string pointer
                            	  5937: 
                            	  5938: LAB_2970
01:00083CFA 43EB05C6        	  5939: 	LEA		Decss(a3),a1		* set output string start
                            	  5940: 
01:00083CFE 7420            	  5941: 	MOVEQ		#' ',d2			* character = " ", assume +ve
01:00083D00 08AB00070595    	  5942: 	BCLR.b	#7,FAC1_s(a3)		* test and clear FAC1 sign (b7)
01:00083D06 6702            	  5943: 	BEQ.s		LAB_2978			* branch if +ve
                            	  5944: 
01:00083D08 742D            	  5945: 	MOVEQ		#'-',d2			* else character = "-"
                            	  5946: LAB_2978
01:00083D0A 1282            	  5947: 	MOVE.b	d2,(a1)			* save the sign character
01:00083D0C 142B0594        	  5948: 	MOVE.b	FAC1_e(a3),d2		* get FAC1 exponent
01:00083D10 6608            	  5949: 	BNE.s		LAB_2989			* branch if FAC1<>0
                            	  5950: 
