01:00084110 276B05900598    	  6497: 	MOVE.l	FAC1_m(a3),FAC2_m(a3)	* copy FAC1 mantissa to FAC2 mantissa
01:00084116 27410590        	  6498: 	MOVE.l	d1,FAC1_m(a3)		* get COS(x) mantissa
01:0008411A 17430594        	  6499: 	MOVE.b	d3,FAC1_e(a3)		* get COS(x) exponent
