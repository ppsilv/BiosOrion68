                            	  5741: 
                            	  5742: LAB_SGN
01:00083C0C 61E6            	  5743: 	BSR.s		LAB_27CA			* get FAC1 sign
                            	  5744: 							* return d0=-1/-ve d0=+1/+ve
                            	  5745: 
                            	  5746: 
                            	  5747: *************************************************************************************
                            	  5748: *
                            	  5749: * save d0 as integer longword
                            	  5750: 
                            	  5751: LAB_27DB
01:00083C0E 27400590        	  5752: 	MOVE.l	d0,FAC1_m(a3)		* save FAC1 mantissa
01:00083C12 377CA0000594    	  5753: 	MOVE.w	#$A000,FAC1_e(a3)		* set FAC1 exponent & sign
01:00083C18 D080            	  5754: 	ADD.l		d0,d0				* top bit into carry
01:00083C1A 6000FCD2        	  5755: 	BRA		LAB_24D0			* do +/- (carry is sign) & normalise FAC1
                            	  5756: 
                            	  5757: 
                            	  5758: *************************************************************************************
                            	  5759: *
                            	  5760: * perform ABS()
                            	  5761: 
