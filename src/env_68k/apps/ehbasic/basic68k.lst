01:000846B4 4A2B05E8        	  7388: 	TST.b		ccflag(a3)			* check [CTRL-C] check flag
01:000846B8 661E            	  7389: 	BNE.s		RTS_022			* exit if [CTRL-C] check inhibited
                            	  7390: 
01:000846BA 4EAB040C        	  7391: 	JSR		V_INPT(a3)			* scan input device
01:000846BE 640E            	  7392: 	BCC.s		LAB_FBA0			* exit if buffer empty
                            	  7393: 
01:000846C0 174005E9        	  7394: 	MOVE.b	d0,ccbyte(a3)		* save received byte
01:000846C4 177C002005EA    	  7395: 	MOVE.b	#$20,ccnull(a3)		* set "life" timer for bytes countdown
01:000846CA 6000DF06        	  7396: 	BRA		LAB_1636			* return to BASIC
                            	  7397: 
                            	  7398: LAB_FBA0
01:000846CE 4A2B05EA        	  7399: 	TST.b		ccnull(a3)			* get countdown byte
01:000846D2 6704            	  7400: 	BEQ.s		RTS_022			* exit if finished
                            	  7401: 
01:000846D4 532B05EA        	  7402: 	SUBQ.b	#1,ccnull(a3)		* else decrement countdown
                            	  7403: RTS_022
01:000846D8 4E75            	  7404: 	RTS
