                            	  5666: *************************************************************************************
                            	  5667: *
                            	  5668: * copy FAC2 to FAC1
                            	  5669: 
                            	  5670: LAB_279B
01:00083BBA 376B059C0594    	  5671: 	MOVE.w	FAC2_e(a3),FAC1_e(a3)	* copy exponent & sign
01:00083BC0 276B05980590    	  5672: 	MOVE.l	FAC2_m(a3),FAC1_m(a3)	* copy mantissa
01:00083BC6 4E75            	  5673: 	RTS
                            	  5674: 
                            	  5675: 
                            	  5676: *************************************************************************************
                            	  5677: *
                            	  5678: * round FAC1
                            	  5679: 
                            	  5680: LAB_27BA
01:00083BC8 102B0594        	  5681: 	MOVE.b	FAC1_e(a3),d0		* get FAC1 exponent
01:00083BCC 6720            	  5682: 	BEQ.s		LAB_27C4			* branch if zero
                            	  5683: 
01:00083BCE 202B0590        	  5684: 	MOVE.l	FAC1_m(a3),d0		* get FAC1
01:00083BD2 D0BC00000080    	  5685: 	ADD.l		#$80,d0			* round to 24 bit
01:00083BD8 640A            	  5686: 	BCC.s		LAB_27C3			* branch if no overflow
                            	  5687: 
01:00083BDA E290            	  5688: 	ROXR.l	#1,d0				* shift FAC1 mantissa
01:00083BDC 522B0594        	  5689: 	ADDQ.b	#1,FAC1_e(a3)		* correct exponent
01:00083BE0 6500E57A        	  5690: 	BCS		LAB_OFER			* if carry do overflow error & warm start
                            	  5691: 
                            	  5692: LAB_27C3
01:00083BE4 C03C0000        	  5693: 	AND.b		#$00,d0			* clear guard byte
01:00083BE8 27400590        	  5694: 	MOVE.l	d0,FAC1_m(a3)		* save back to FAC1
01:00083BEC 4E75            	  5695: 	RTS
                            	  5696: 
                            	  5697: LAB_27C4
01:00083BEE 17400595        	  5698: 	MOVE.b	d0,FAC1_s(a3)		* make zero always +ve
                            	  5699: RTS_017
01:00083BF2 4E75            	  5700: 	RTS
                            	  5701: 
                            	  5702: 
                            	  5703: *************************************************************************************
                            	  5704: *
                            	  5705: * get FAC1 sign
