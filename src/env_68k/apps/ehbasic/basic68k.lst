01:00083C1E 177C00000595    	  5763: 	MOVE.b	#0,FAC1_s(a3)		* clear FAC1 sign
01:00083C24 4E75            	  5764: 	RTS
                            	  5765: 
                            	  5766: 
                            	  5767: *************************************************************************************
                            	  5768: *
                            	  5769: * compare FAC1 with FAC2
                            	  5770: * returns d0=+1 Cb=0 if FAC1 > FAC2
                            	  5771: * returns d0= 0 Cb=0 if FAC1 = FAC2
                            	  5772: * returns d0=-1 Cb=1 if FAC1 < FAC2
                            	  5773: 
                            	  5774: LAB_27FA
01:00083C26 122B059C        	  5775: 	MOVE.b	FAC2_e(a3),d1		* get FAC2 exponent
01:00083C2A 67C8            	  5776: 	BEQ.s		LAB_27CA			* branch if FAC2 exponent=0 & get FAC1 sign
                            	  5777: 							* d0=-1,C=1/-ve d0=+1,C=0/+ve
                            	  5778: 
01:00083C2C 102B059E        	  5779: 	MOVE.b	FAC_sc(a3),d0		* get FAC sign compare
01:00083C30 6BCA            	  5780: 	BMI.s		LAB_27CE			* if signs <> do return d0=-1,C=1/-ve
                            	  5781: 							* d0=+1,C=0/+ve & return
                            	  5782: 
01:00083C32 102B0595        	  5783: 	MOVE.b	FAC1_s(a3),d0		* get FAC1 sign
01:00083C36 B22B0594        	  5784: 	CMP.b		FAC1_e(a3),d1		* compare FAC1 exponent with FAC2 exponent
01:00083C3A 660A            	  5785: 	BNE.s		LAB_2828			* branch if different
                            	  5786: 
01:00083C3C 222B0598        	  5787: 	MOVE.l	FAC2_m(a3),d1		* get FAC2 mantissa
01:00083C40 B2AB0590        	  5788: 	CMP.l		FAC1_m(a3),d1		* compare mantissas
01:00083C44 6708            	  5789: 	BEQ.s		LAB_282F			* exit if mantissas equal
                            	  5790: 
                            	  5791: * gets here if number <> FAC1
                            	  5792: 
                            	  5793: LAB_2828
01:00083C46 65B8            	  5794: 	BCS.s		LAB_27D0			* if FAC1 > FAC2 return d0=-1,C=1/-ve d0=+1,
                            	  5795: 							* C=0/+ve
                            	  5796: 
01:00083C48 0A000080        	  5797: 	EORI.b	#$80,d0			* else toggle FAC1 sign
                            	  5798: LAB_282E
01:00083C4C 60B2            	  5799: 	BRA.s		LAB_27D0			* return d0=-1,C=1/-ve d0=+1,C=0/+ve
                            	  5800: 
                            	  5801: LAB_282F
01:00083C4E 7000            	  5802: 	MOVEQ		#0,d0				* clear result
01:00083C50 4E75            	  5803: 	RTS
