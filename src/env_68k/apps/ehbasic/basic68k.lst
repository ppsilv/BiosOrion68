                            	  5806: *************************************************************************************
                            	  5807: *
                            	  5808: * convert FAC1 floating to fixed
                            	  5809: * result in d0 and Itemp, sets flags correctly
                            	  5810: 
                            	  5811: LAB_2831
01:00083C52 202B0590        	  5812: 	MOVE.l	FAC1_m(a3),d0		* copy mantissa
01:00083C56 6730            	  5813: 	BEQ.s		LAB_284J			* branch if mantissa = 0
                            	  5814: 
01:00083C58 2F01            	  5815: 	MOVE.l	d1,-(sp)			* save d1
01:00083C5A 72A0            	  5816: 	MOVEQ		#$A0,d1			* set for no floating bits
01:00083C5C 922B0594        	  5817: 	SUB.b		FAC1_e(a3),d1		* subtract FAC1 exponent
01:00083C60 6500E4FA        	  5818: 	BCS		LAB_OFER			* do overflow if too big
                            	  5819: 
01:00083C64 660E            	  5820: 	BNE.s		LAB_284G			* branch if exponent was not $A0
                            	  5821: 
01:00083C66 4A2B0595        	  5822: 	TST.b		FAC1_s(a3)			* test FAC1 sign
01:00083C6A 6A1A            	  5823: 	BPL.s		LAB_284H			* branch if FAC1 +ve
                            	  5824: 
01:00083C6C 4480            	  5825: 	NEG.l		d0
01:00083C6E 6916            	  5826: 	BVS.s		LAB_284H			* branch if was $80000000
                            	  5827: 
01:00083C70 6000E4EA        	  5828: 	BRA		LAB_OFER			* do overflow if too big
                            	  5829: 
                            	  5830: LAB_284G
01:00083C74 B23C0020        	  5831: 	CMP.b		#$20,d1			* compare with minimum result for integer
01:00083C78 6502            	  5832: 	BCS.s		LAB_284L			* if < minimum just do shift
                            	  5833: 
01:00083C7A 7000            	  5834: 	MOVEQ		#0,d0				* else return zero
                            	  5835: LAB_284L
01:00083C7C E2A8            	  5836: 	LSR.l		d1,d0				* shift integer
                            	  5837: 
01:00083C7E 4A2B0595        	  5838: 	TST.b		FAC1_s(a3)			* test FAC1 sign (b7)
01:00083C82 6A02            	  5839: 	BPL.s		LAB_284H			* branch if FAC1 +ve
                            	  5840: 
01:00083C84 4480            	  5841: 	NEG.l		d0				* negate integer value
                            	  5842: LAB_284H
01:00083C86 221F            	  5843: 	MOVE.l	(sp)+,d1			* restore d1
                            	  5844: LAB_284J
01:00083C88 2740042A        	  5845: 	MOVE.l	d0,Itemp(a3)		* save result to Itemp
01:00083C8C 4E75            	  5846: 	RTS
                            	  5847: 
                            	  5848: 
                            	  5849: *************************************************************************************
                            	  5850: *
                            	  5851: * perform INT()
                            	  5852: 
                            	  5853: LAB_INT
01:00083C8E 70A0            	  5854: 	MOVEQ		#$A0,d0			* set for no floating bits
01:00083C90 902B0594        	  5855: 	SUB.b		FAC1_e(a3),d0		* subtract FAC1 exponent
01:00083C94 6310            	  5856: 	BLS.s		LAB_IRTS			* exit if exponent >= $A0
                            	  5857: 							* (too big for fraction part!)
                            	  5858: 
01:00083C96 B03C0020        	  5859: 	CMP.b		#$20,d0			* compare with minimum result for integer
01:00083C9A 6400025E        	  5860: 	BCC		LAB_POZE			* if >= minimum go return 0
                            	  5861: 							* (too small for integer part!)
                            	  5862: 
01:00083C9E 72FF            	  5863: 	MOVEQ		#-1,d1			* set integer mask
01:00083CA0 E1A1            	  5864: 	ASL.l		d0,d1				* shift mask [8+2*d0]
01:00083CA2 C3AB0590        	  5865: 	AND.l		d1,FAC1_m(a3)		* mask mantissa
                            	  5866: LAB_IRTS
01:00083CA6 4E75            	  5867: 	RTS
