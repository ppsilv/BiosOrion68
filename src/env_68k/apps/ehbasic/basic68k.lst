01:000845A4 226F0004        	  7202: 	MOVEA.l	4+fsd(sp),a1		* get the format string descriptor pointer
01:000845A8 2251            	  7203: 	MOVEA.l	(a1),a1			* get the format string pointer
01:000845AA 7800            	  7204: 	MOVEQ		#0,d4				* clear the new string index
                            	  7205: LAB_D00A
