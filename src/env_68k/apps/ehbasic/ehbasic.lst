01:00001D5C 376B419C4194    	  5647: 	MOVE.w	FAC2_e(a3),FAC1_e(a3)	* copy exponent & sign
01:00001D62 276B41984190    	  5648: 	MOVE.l	FAC2_m(a3),FAC1_m(a3)	* copy mantissa
01:00001D68 4E75            	  5649: 	RTS
                            	  5650: 
