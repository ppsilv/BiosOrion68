                            	   312: *************************************************************************************
                            	   313: *
                            	   314: * Start of code
                            	   315: code_start
                            	   316: * to tell EhBASIC where and how much RAM it has pass the address in a0 and the size
                            	   317: * in d0. these values are at the end of the .inc file
                            	   318: 
01:000001D2 48E77FFE        	   319: 	MOVEM.l d1-d7/a0-a6,-(sp)	* Save the OS registers
01:000001D6 224F            	   320:     MOVE.l  sp,a1               * copy the system stack pointer
                            	   321: 
01:000001D8 207C00100000    	   322: 	MOVEA.l	#ram_addr,a0		* tell BASIC where RAM starts
01:000001DE 203C00800000    	   323: 	MOVE.l	#ram_size,d0		* tell BASIC how big RAM is
                            	   324: 
                            	   325: 
                            	   326: ****************************************************************************************
                            	   327: ****************************************************************************************
                            	   328: ****************************************************************************************
                            	   329: ****************************************************************************************
                            	   330: *
                            	   331: * Register use :- (must improve this !!)
                            	   332: *
                            	   333: *	a6 -	temp Bpntr			* temporary BASIC execute pointer
                            	   334: *	a5 -	Bpntr				* BASIC execute (get byte) pointer
                            	   335: *	a4 -	des_sk				* descriptor stack pointer
                            	   336: *	a3 -	ram_strt			* start of RAM. all RAM references are offsets
                            	   337: *								* from this value
                            	   338: *
                            	   339: 
                            	   340: *************************************************************************************
                            	   341: *
                            	   342: * BASIC cold start entry point. assume entry with RAM address in a0 and RAM length
                            	   343: * in d0
                            	   344: 
                            	   345: LAB_COLD
01:000001E4 B0BC00004000    	   346: 	CMP.l	#$4000,d0			* compare size with 16k
01:000001EA 6C04            	   347: 	BGE.s	LAB_sizok			* branch if >= 16k
                            	   348: 
01:000001EC 7005            	   349: 	MOVEQ	#5,d0				* error 5 - not enough RAM
01:000001EE 4E75            	   350: 	RTS							* just exit. this as stands will never execute
                            	   351: 								* but could be used to exit back to an OS
                            	   352: 
                            	   353: LAB_sizok
01:000001F0 2648            	   354: 	MOVEA.l	a0,a3				* copy RAM base to a3
01:000001F2 D1C0            	   355: 	ADDA.l	d0,a0				* a0 is top of RAM
01:000001F4 2748404A        	   356: 	MOVE.l	a0,Ememl(a3)		* set end of mem
01:000001F8 4FEB4000        	   357: 	LEA		ram_base(a3),sp		* set stack to RAM start + 4k
01:000001FC 27494208        	   358:     MOVE.L  a1,sys_stack(a3)     * save the system stack pointer
                            	   359: 
01:00000200 303C4EF9        	   360: 	MOVE.w	#$4EF9,d0			* JMP opcode
01:00000204 204F            	   361: 	MOVEA.l	sp,a0				* point to start of vector table
                            	   362: 
01:00000206 30C0            	   363: 	MOVE.w	d0,(a0)+			* LAB_WARM
01:00000208 43FAFFDA        	   364: 	LEA		LAB_COLD,a1			* initial warm start vector
01:0000020C 20C9            	   365: 	MOVE.l	a1,(a0)+			* set vector
                            	   366: 
01:0000020E 30C0            	   367: 	MOVE.w	d0,(a0)+			* Usrjmp
01:00000210 43FA00E4        	   368: 	LEA		LAB_FCER,a1			* initial user function vector
                            	   369: 								* "Function call" error
01:00000214 20C9            	   370: 	MOVE.l	a1,(a0)+			* set vector
                            	   371: 
01:00000216 30C0            	   372: 	MOVE.w	d0,(a0)+			* V_INPT JMP opcode
01:00000218 43FAFE08        	   373: 	LEA		VEC_IN,a1			* get byte from input device vector
01:0000021C 20C9            	   374: 	MOVE.l	a1,(a0)+			* set vector
                            	   375: 
