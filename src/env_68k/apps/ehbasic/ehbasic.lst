                            	  2645: LAB_1ADB
01:00000E1C 6100012E        	  2646: 	BSR		LAB_GBYT			* scan memory
                            	  2647: LAB_1ADE
01:00000E20 903C00BD        	  2648: 	SUB.b	#TK_GT,d0			* subtract token for > (lowest compare function)
01:00000E24 652A            	  2649: 	BCS.s	LAB_1AFA			* branch if < TK_GT
                            	  2650: 
01:00000E26 B03C0003        	  2651: 	CMP.b	#$03,d0 			* compare with ">" to "<" tokens
01:00000E2A 650A            	  2652: 	BCS.s	LAB_1AE0			* branch if <= TK_SGN (is compare function)
                            	  2653: 
01:00000E2C 4A2B41E3        	  2654: 	TST.b	comp_f(a3)			* test compare function flag
01:00000E30 6660            	  2655: 	BNE.s	LAB_1B2A			* branch if compare function
                            	  2656: 
01:00000E32 60000086        	  2657: 	BRA		LAB_1B78			* go do functions
                            	  2658: 
