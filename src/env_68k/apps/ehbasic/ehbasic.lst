01:00002B38 17704000419C    	  7828: 	MOVE.b	(a0,d4.w),FAC2_e(a3)	* copy exponent for multiply
01:00002B3E 277040024198    	  7829: 	MOVE.l	2(a0,d4.w),FAC2_m(a3)	* copy table mantissa
01:00002B44 205F            	  7830: 	MOVE.l	(sp)+,a0			* restore register
