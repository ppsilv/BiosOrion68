                            	  2660: LAB_1AE0
01:00000E36 7201            	  2661: 	MOVEQ	#1,d1				* set to 0000 0001
01:00000E38 E121            	  2662: 	ASL.b	d0,d1				* 1 if >, 2 if =, 4 if <
01:00000E3A 102B41E3        	  2663: 	MOVE.b	comp_f(a3),d0		* copy old compare function flag
01:00000E3E B32B41E3        	  2664: 	EOR.b	d1,comp_f(a3)		* EOR in this compare function bit
01:00000E42 B02B41E3        	  2665: 	CMP.b	comp_f(a3),d0		* compare old with new compare function flag
01:00000E46 6400F4BA        	  2666: 	BCC		LAB_SNER			* if new <= old comp_f do syntax error and warm
                            	  2667: 		    					* start, there was more than one <, = or >
01:00000E4A 610000FE        	  2668: 	BSR		LAB_IGBY			* increment & scan memory
01:00000E4E 60D0            	  2669: 	BRA.s	LAB_1ADE			* go do next character
