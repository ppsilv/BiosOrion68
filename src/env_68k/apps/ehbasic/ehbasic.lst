                            	  7338: 
                            	  7339: LAB_HEXS
01:0000282C B23C0009        	  7340: 	CMP.b	#$09,d1			    * max + 1
01:00002830 6400DAC4        	  7341: 	BCC		LAB_FCER			* exit if too big ( > or = )
                            	  7342: 
01:00002834 7407            	  7343: 	MOVEQ	#$07,d2		    	* nibble count-1
01:00002836 41EB41CE        	  7344: 	LEA		Hexss(a3),a0		* point to string
01:0000283A 7830            	  7345: 	MOVEQ	#$30,d4	    		* "0" character for ABCD
                            	  7346: NextH1
01:0000283C 1600            	  7347: 	MOVE.b	d0,d3				* copy lowest byte
01:0000283E E898            	  7348: 	ROR.l	#4,d0				* shift nibble into 0-3
01:00002840 C63C000F        	  7349: 	AND.b	#$0F,d3		    	* just this nibble
01:00002844 1A03            	  7350: 	MOVE.b	d3,d5				* copy it
01:00002846 DA3C00F6        	  7351: 	ADD.b	#$F6,d5	    		* set extend bit
01:0000284A C704            	  7352: 	ABCD	d4,d3				* decimal add extend and character to zero
01:0000284C 11832000        	  7353: 	MOVE.b	d3,(a0,d2.w)		* save character to string
01:00002850 51CAFFEA        	  7354: 	DBF		d2,NextH1			* decrement and loop if not done
                            	  7355: 
01:00002854 60A2            	  7356: 	BRA.s	EndBHS  			* go process string
                            	  7357: 
