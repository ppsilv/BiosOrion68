                            	  7177: 
01:00002746 226F0004        	  7178: 	MOVEA.l	4+fsd(sp),a1		* get the format string descriptor pointer
01:0000274A 2251            	  7179: 	MOVEA.l	(a1),a1 			* get the format string pointer
01:0000274C 7800            	  7180: 	MOVEQ	#0,d4				* clear the new string index
                            	  7181: LAB_D00A
01:0000274E 11B120004000    	  7182: 	MOVE.b	(a1,d2.w),(a0,d4.w)	* get a character from the format string and
                            	  7183: 					    		* save it to the new string
01:00002754 5244            	  7184: 	ADDQ.w	#1,d4				* increment the new string index
01:00002756 5242            	  7185: 	ADDQ.w	#1,d2				* increment the format string index
01:00002758 BE42            	  7186: 	CMP.w	d2,d7				* compare the format index with the length
01:0000275A 6602            	  7187: 	BNE.s	LAB_D00E			* if not there skip the reset
                            	  7188: 
01:0000275C 7400            	  7189: 	MOVEQ	#0,d2				* else reset the format string index
                            	  7190: LAB_D00E
01:0000275E BC42            	  7191: 	CMP.w	d2,d6				* compare the index with this index
01:00002760 66EC            	  7192: 	BNE.s	LAB_D00A			* if not equal go do the next character
                            	  7193: 
01:00002762 4E75            	  7194: 	RTS
