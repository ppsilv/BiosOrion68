                            	  7654: *************************************************************************************
                            	  7655: *
                            	  7656: * get ASCII string equivalent into FAC1 as integer32 or float
                            	  7657: 
                            	  7658: * entry is with a5 pointing to the first character of the string
                            	  7659: * exit with a5 pointing to the first character after the string
                            	  7660: 
                            	  7661: * d0 is character
                            	  7662: * d1 is mantissa
                            	  7663: * d2 is partial and table mantissa
                            	  7664: * d3 is mantissa exponent (decimal & binary)
                            	  7665: * d4 is decimal exponent
                            	  7666: 
                            	  7667: * get FAC1 from string
                            	  7668: * this routine now handles hex and binary values from strings
                            	  7669: * starting with "$" and "%" respectively
                            	  7670: 
                            	  7671: LAB_2887
01:00002A24 48E77C00        	  7672: 	MOVEM.l	d1-d5,-(sp)			* save registers
01:00002A28 7200            	  7673: 	MOVEQ	#$00,d1	    		* clear temp accumulator
01:00002A2A 2601            	  7674: 	MOVE.l	d1,d3				* set mantissa decimal exponent count
01:00002A2C 2801            	  7675: 	MOVE.l	d1,d4				* clear decimal exponent
01:00002A2E 17414195        	  7676: 	MOVE.b	d1,FAC1_s(a3)		* clear sign byte
01:00002A32 174141B5        	  7677: 	MOVE.b	d1,Dtypef(a3)		* set float data type
01:00002A36 174141AF        	  7678: 	MOVE.b	d1,expneg(a3)		* clear exponent sign
01:00002A3A 6100E510        	  7679: 	BSR		LAB_GBYT			* get first byte back
01:00002A3E 653C            	  7680: 	BCS.s	LAB_28FE			* go get floating if 1st character numeric
                            	  7681: 
01:00002A40 B03C002D        	  7682: 	CMP.b	#'-',d0	    		* or is it -ve number
01:00002A44 6608            	  7683: 	BNE.s	LAB_289A			* branch if not
                            	  7684: 
01:00002A46 177C00FF4195    	  7685: 	MOVE.b	#$FF,FAC1_s(a3)		* set sign byte
01:00002A4C 6006            	  7686: 	BRA.s	LAB_289C			* now go scan & check for hex/bin/int
                            	  7687: 
                            	  7688: LAB_289A
                            	  7689: 					    		* first character wasn't numeric or -
01:00002A4E B03C002B        	  7690: 	CMP.b	#'+',d0	    		* compare with '+'
01:00002A52 6606            	  7691: 	BNE.s	LAB_289D			* branch if not '+' (go check for '.'/hex/binary
                            	  7692: 					    		* /integer)
                            	  7693: 
                            	  7694: LAB_289C
                            	  7695: 				    			* was "+" or "-" to start, so get next character
01:00002A54 6100E4F4        	  7696: 	BSR		LAB_IGBY			* increment & scan memory
01:00002A58 6522            	  7697: 	BCS.s	LAB_28FE			* branch if numeric character
                            	  7698: 
                            	  7699: LAB_289D
01:00002A5A B03C002E        	  7700: 	CMP.b	#'.',d0		    	* else compare with '.'
01:00002A5E 67000092        	  7701: 	BEQ		LAB_2904			* branch if '.'
                            	  7702: 
                            	  7703: 							    * code here for hex/binary/integer numbers
01:00002A62 B03C0024        	  7704: 	CMP.b	#'$',d0		    	* compare with '$'
01:00002A66 6700010A        	  7705: 	BEQ		LAB_CHEX			* branch if '$'
                            	  7706: 
01:00002A6A B03C0025        	  7707: 	CMP.b	#'%',d0	    		* else compare with '%'
01:00002A6E 67000164        	  7708: 	BEQ		LAB_CBIN			* branch if '%'
                            	  7709: 
01:00002A72 6000008C        	  7710: 	BRA		LAB_2Y01			* not #.$%& so return 0
                            	  7711: 
                            	  7712: LAB_28FD
01:00002A76 6100E4D2        	  7713: 	BSR		LAB_IGBY			* get next character
01:00002A7A 646C            	  7714: 	BCC.s	LAB_2902			* exit loop if not a digit
                            	  7715: 
                            	  7716: LAB_28FE
01:00002A7C 610001A8        	  7717: 	BSR		d1x10				* multiply d1 by 10 and add character
01:00002A80 64F4            	  7718: 	BCC.s	LAB_28FD			* loop for more if no overflow
                            	  7719: 
                            	  7720: LAB_28FF
                            	  7721: 			    				* overflowed mantissa, count 10s exponent
01:00002A82 5283            	  7722: 	ADDQ.l	#1,d3				* increment mantissa decimal exponent count
01:00002A84 6100E4C4        	  7723: 	BSR		LAB_IGBY			* get next character
01:00002A88 65F8            	  7724: 	BCS.s	LAB_28FF			* loop while numeric character
                            	  7725: 
                            	  7726: 			    				* done overflow, now flush fraction or do E
01:00002A8A B03C002E        	  7727: 	CMP.b	#'.',d0	    		* else compare with '.'
01:00002A8E 6606            	  7728: 	BNE.s	LAB_2901			* branch if not '.'
                            	  7729: 
                            	  7730: LAB_2900
                            	  7731: 				    			* flush remaining fraction digits
01:00002A90 6100E4B8        	  7732: 	BSR		LAB_IGBY			* get next character
01:00002A94 65FA            	  7733: 	BCS		LAB_2900			* loop while numeric character
                            	  7734: 
                            	  7735: LAB_2901
                            	  7736: 							    * done number, only (possible) exponent remains
01:00002A96 B03C0045        	  7737: 	CMP.b	#'E',d0		    	* else compare with 'E'
01:00002A9A 6664            	  7738: 	BNE.s	LAB_2Y01			* if not 'E' all done, go evaluate
                            	  7739: 
                            	  7740: 					    		* process exponent
01:00002A9C 6100E4AC        	  7741: 	BSR		LAB_IGBY			* get next character
01:00002AA0 6528            	  7742: 	BCS.s	LAB_2X04			* branch if digit
                            	  7743: 
01:00002AA2 B03C002D        	  7744: 	CMP.b	#'-',d0 			* or is it -ve number
01:00002AA6 6706            	  7745: 	BEQ.s	LAB_2X01			* branch if so
                            	  7746: 
01:00002AA8 B03C00B4        	  7747: 	CMP.b	#TK_MINUS,d0		* or is it -ve number
01:00002AAC 6608            	  7748: 	BNE.s	LAB_2X02			* branch if not
                            	  7749: 
                            	  7750: LAB_2X01
01:00002AAE 177C00FF41AF    	  7751: 	MOVE.b	#$FF,expneg(a3)		* set exponent sign
01:00002AB4 600E            	  7752: 	BRA.s	LAB_2X03			* now go scan & check exponent
                            	  7753: 
                            	  7754: LAB_2X02
01:00002AB6 B03C002B        	  7755: 	CMP.b	#'+',d0	    		* or is it +ve number
01:00002ABA 6708            	  7756: 	BEQ.s	LAB_2X03			* branch if so
                            	  7757: 
01:00002ABC B03C00B3        	  7758: 	CMP.b	#TK_PLUS,d0			* or is it +ve number
01:00002AC0 6600D840        	  7759: 	BNE		LAB_SNER			* wasn't - + TK_MINUS TK_PLUS or # so do error
                            	  7760: 
                            	  7761: LAB_2X03
01:00002AC4 6100E484        	  7762: 	BSR		LAB_IGBY			* get next character
01:00002AC8 6436            	  7763: 	BCC.s	LAB_2Y01			* if not digit all done, go evaluate
                            	  7764: LAB_2X04
