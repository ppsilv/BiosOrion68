01:00001DAE 61E6            	  5719: 	BSR.s	LAB_27CA			* get FAC1 sign
                            	  5720: 			    				* return d0=-1/-ve d0=+1/+ve
                            	  5721: 
                            	  5722: 
                            	  5723: *************************************************************************************
                            	  5724: *
                            	  5725: * save d0 as integer longword
                            	  5726: 
                            	  5727: LAB_27DB
01:00001DB0 27404190        	  5728: 	MOVE.l	d0,FAC1_m(a3)		* save FAC1 mantissa
01:00001DB4 377CA0004194    	  5729: 	MOVE.w	#$A000,FAC1_e(a3)	* set FAC1 exponent & sign
01:00001DBA D080            	  5730: 	ADD.l	d0,d0				* top bit into carry
01:00001DBC 6000FCD2        	  5731: 	BRA		LAB_24D0			* do +/- (carry is sign) & normalise FAC1
                            	  5732: 
                            	  5733: 
                            	  5734: *************************************************************************************
                            	  5735: *
                            	  5736: * perform ABS()
