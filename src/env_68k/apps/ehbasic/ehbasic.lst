                            	  5743: *************************************************************************************
                            	  5744: *
                            	  5745: * compare FAC1 with FAC2
                            	  5746: * returns d0=+1 Cb=0 if FAC1 > FAC2
                            	  5747: * returns d0= 0 Cb=0 if FAC1 = FAC2
                            	  5748: * returns d0=-1 Cb=1 if FAC1 < FAC2
                            	  5749: 
                            	  5750: LAB_27FA
01:00001DC8 122B419C        	  5751: 	MOVE.b	FAC2_e(a3),d1		* get FAC2 exponent
01:00001DCC 67C8            	  5752: 	BEQ.s	LAB_27CA			* branch if FAC2 exponent=0 & get FAC1 sign
                            	  5753: 			    				* d0=-1,C=1/-ve d0=+1,C=0/+ve
                            	  5754: 
01:00001DCE 102B419E        	  5755: 	MOVE.b	FAC_sc(a3),d0		* get FAC sign compare
01:00001DD2 6BCA            	  5756: 	BMI.s	LAB_27CE			* if signs <> do return d0=-1,C=1/-ve
                            	  5757: 				    			* d0=+1,C=0/+ve & return
                            	  5758: 
01:00001DD4 102B4195        	  5759: 	MOVE.b	FAC1_s(a3),d0		* get FAC1 sign
01:00001DD8 B22B4194        	  5760: 	CMP.b	FAC1_e(a3),d1		* compare FAC1 exponent with FAC2 exponent
01:00001DDC 660A            	  5761: 	BNE.s	LAB_2828			* branch if different
                            	  5762: 
01:00001DDE 222B4198        	  5763: 	MOVE.l	FAC2_m(a3),d1		* get FAC2 mantissa
01:00001DE2 B2AB4190        	  5764: 	CMP.l	FAC1_m(a3),d1		* compare mantissas
01:00001DE6 6708            	  5765: 	BEQ.s	LAB_282F			* exit if mantissas equal
                            	  5766: 
                            	  5767: * gets here if number <> FAC1
                            	  5768: 
                            	  5769: LAB_2828
01:00001DE8 65B8            	  5770: 	BCS.s	LAB_27D0			* if FAC1 > FAC2 return d0=-1,C=1/-ve d0=+1,
                            	  5771: 					    		* C=0/+ve
                            	  5772: 
01:00001DEA 0A000080        	  5773: 	EORI.b	#$80,d0		    	* else toggle FAC1 sign
                            	  5774: LAB_282E
01:00001DEE 60B2            	  5775: 	BRA.s	LAB_27D0			* return d0=-1,C=1/-ve d0=+1,C=0/+ve
                            	  5776: 
                            	  5777: LAB_282F
01:00001DF0 7000            	  5778: 	MOVEQ	#0,d0				* clear result
01:00001DF2 4E75            	  5779: 	RTS
