01:00000244 174041E5        	   397: 	MOVE.b	d0,TPos(a3)			* clear terminal position
01:00000248 174041E8        	   398: 	MOVE.b	d0,ccflag(a3)		* allow CTRL-C check
01:0000024C 37404212        	   399: 	MOVE.w	d0,prg_strt-2(a3)	* clear start word
01:00000250 374041D6        	   400: 	MOVE.w	d0,BHsend(a3)		* clear value to string end word
                            	   401: 
01:00000254 177C000041E6    	   402: 	MOVE.b	#$0,TWidth(a3)		* Unlimited width, handled by OS
                            	   403: 	*MOVE.b	#$50,TWidth(a3)		* default terminal width byte for simulator
01:0000025A 177C000E41E2    	   404: 	MOVE.b	#$0E,TabSiz(a3)		* save default tab size = 14
                            	   405: 
01:00000260 177C003841E7    	   406: 	MOVE.b	#$38,Iclim(a3)		* default limit for TAB = 14 for simulator
                            	   407: 
