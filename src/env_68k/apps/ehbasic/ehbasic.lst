01:000002B0 6056            	   453: 	BRA.s	LAB_XERR			* do error #d7, then warm start
                            	   454: 
                            	   455: 
                            	   456: *************************************************************************************
                            	   457: *
                            	   458: * do address error
                            	   459: 
                            	   460: LAB_ADER
01:000002B2 7E2A            	   461: 	MOVEQ	#$2A,d7				* error code $2A "Address" error
01:000002B4 6052            	   462: 	BRA.s	LAB_XERR			* do error #d7, then warm start
                            	   463: 
                            	   464: 
                            	   465: *************************************************************************************
                            	   466: *
                            	   467: * do wrong dimensions error
                            	   468: 
                            	   469: LAB_WDER
01:000002B6 7E28            	   470: 	MOVEQ	#$28,d7				* error code $28 "Wrong dimensions" error
01:000002B8 604E            	   471: 	BRA.s	LAB_XERR			* do error #d7, then warm start
                            	   472: 
                            	   473: 
                            	   474: *************************************************************************************
                            	   475: *
                            	   476: * do undimensioned array error
                            	   477: 
                            	   478: LAB_UDER
01:000002BA 7E26            	   479: 	MOVEQ	#$26,d7				* error code $26 "undimensioned array" error
01:000002BC 604A            	   480: 	BRA.s	LAB_XERR			* do error #d7, then warm start
                            	   481: 
                            	   482: 
                            	   483: *************************************************************************************
                            	   484: *
                            	   485: * do undefined variable error
                            	   486: 
                            	   487: LAB_UVER
                            	   488: 
                            	   489: * if you do want a non existant variable to return an error then leave the novar
                            	   490: * value at the top of this file set to zero
                            	   491: 
                            	   492:  ifeq	novar
                            	   493: 
01:000002BE 7E24            	   494: 	MOVEQ	#$24,d7				* error code $24 "undefined variable" error
01:000002C0 6046            	   495: 	BRA.s	LAB_XERR			* do error #d7, then warm start
                            	   496: 
                            	   497:  endc
                            	   498: 
                            	   499: * if you want a non existant variable to return a null value then set the novar
                            	   500: * value at the top of this file to some non zero value
                            	   501: 
                            	   502:  ifne	novar
                            	   503: 
                            	   504: 	ADD.l	d0,d0				* .......$ .......& ........ .......0
                            	   505: 	SWAP	d0					* ........ .......0 .......$ .......&
                            	   506: 	ROR.b	#1,d0				* ........ .......0 .......$ &.......
                            	   507: 	LSR.w	#1,d0				* ........ .......0 0....... $&.....�.
                            	   508: 	AND.b	#$C0,d0				* mask the type bits
                            	   509: 	MOVE.b	d0,Dtypef(a3)		* save the data type
