01:00000230 43FAFEFE        	   385: 	LEA		VEC_SV,a1			* save BASIC program vector
01:00000234 20C9            	   386: 	MOVE.l	a1,(a0)+			* set vector
                            	   387: 
01:00000236 30C0            	   388: 	MOVE.w	d0,(a0)+			* V_CTLC JMP opcode
01:00000238 43FA261C        	   389: 	LEA		VEC_CC,a1			* save CTRL-C check vector
01:0000023C 20C9            	   390: 	MOVE.l	a1,(a0)+			* set vector
                            	   391: 
                            	   392: * set-up start values
                            	   393: 
                            	   394: *##LAB_GMEM
01:0000023E 7000            	   395: 	MOVEQ	#$00,d0				* clear d0
