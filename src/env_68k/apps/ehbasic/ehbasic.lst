                            	  5245: 			    				* now sort out the result
                            	  5246: LAB_LOCX
01:00001B6A DC86            	  5247: 	ADD.l	d6,d6				* *2
01:00001B6C 2006            	  5248: 	MOVE.l	d6,d0				* setup for d7 = 0
                            	  5249: LAB_LONN
01:00001B6E 2800            	  5250: 	MOVE.l	d0,d4				* save cordic result
01:00001B70 7A00            	  5251: 	MOVEQ	#0,d5				* set default exponent sign
01:00001B72 4A87            	  5252: 	TST.l	d7	    			* check original exponent sign
01:00001B74 6716            	  5253: 	BEQ.s	LAB_LOXO			* branch if original was 0
                            	  5254: 
01:00001B76 6A04            	  5255: 	BPL.s	LAB_LOXP			* branch if was +ve
                            	  5256: 
01:00001B78 4487            	  5257: 	NEG.l	d7		    		* make original exponent +ve
01:00001B7A 7A80            	  5258: 	MOVEQ	#$80-$100,d5		* make sign -ve
                            	  5259: LAB_LOXP
01:00001B7C 17454195        	  5260: 	MOVE.b	d5,FAC1_s(a3)		* save original exponent sign
01:00001B80 4847            	  5261: 	SWAP	d7			    	* 16 bit shift
01:00001B82 E18F            	  5262: 	LSL.l	#8,d7				* easy first part
01:00001B84 7A88            	  5263: 	MOVEQ	#$88-$100,d5		* start with byte
                            	  5264: LAB_LONE
01:00001B86 5385            	  5265: 	SUBQ.l	#1,d5				* decrement exponent
01:00001B88 DE87            	  5266: 	ADD.l	d7,d7				* shift mantissa
01:00001B8A 6AFA            	  5267: 	BPL.s	LAB_LONE			* loop if not normal
                            	  5268: 
                            	  5269: LAB_LOXO
01:00001B8C 27474190        	  5270: 	MOVE.l	d7,FAC1_m(a3)		* save original exponent as mantissa
01:00001B90 17454194        	  5271: 	MOVE.b	d5,FAC1_e(a3)		* save exponent for this
01:00001B94 277CB17217F84198	  5272: 	MOVE.l	#$B17217F8,FAC2_m(a3)	* LOG(2) mantissa
01:00001B9C 377C8000419C    	  5273: 	MOVE.w	#$8000,FAC2_e(a3)		* LOG(2) exponent & sign
01:00001BA2 176B4195419E    	  5274: 	MOVE.b	FAC1_s(a3),FAC_sc(a3)	* make sign compare = FAC1 sign
01:00001BA8 6118            	  5275: 	BSR.s	LAB_MULTIPLY		* do multiply
01:00001BAA 27444198        	  5276: 	MOVE.l	d4,FAC2_m(a3)		* save cordic result
01:00001BAE 6710            	  5277: 	BEQ.s	LAB_LOWZ			* branch if zero
                            	  5278: 
01:00001BB0 377C8200419C    	  5279: 	MOVE.w	#$8200,FAC2_e(a3)		* set exponent & sign
01:00001BB6 176B4195419E    	  5280: 	MOVE.b	FAC1_s(a3),FAC_sc(a3)	* clear sign compare
01:00001BBC 6100FE62        	  5281: 	BSR		LAB_ADD		    	* and add for final result
                            	  5282: 
                            	  5283: LAB_LOWZ
01:00001BC0 4E75            	  5284: 	RTS
                            	  5285: 
                            	  5286: 
                            	  5287: *************************************************************************************
                            	  5288: *
                            	  5289: * multiply FAC1 by FAC2
                            	  5290: 
                            	  5291: LAB_MULTIPLY
01:00001BC2 48E7F800        	  5292: 	MOVEM.l	d0-d4,-(sp)			* save registers
01:00001BC6 4A2B4194        	  5293: 	TST.b	FAC1_e(a3)			* test FAC1 exponent
01:00001BCA 6776            	  5294: 	BEQ.s	LAB_MUUF			* if exponent zero go make result zero
                            	  5295: 
01:00001BCC 102B419C        	  5296: 	MOVE.b	FAC2_e(a3),d0		* get FAC2 exponent
01:00001BD0 6770            	  5297: 	BEQ.s	LAB_MUUF			* if exponent zero go make result zero
                            	  5298: 
01:00001BD2 176B419E4195    	  5299: 	MOVE.b	FAC_sc(a3),FAC1_s(a3)	* sign compare becomes sign
                            	  5300: 
01:00001BD8 D02B4194        	  5301: 	ADD.b	FAC1_e(a3),d0		* multiply exponents by adding
01:00001BDC 640A            	  5302: 	BCC.s	LAB_MNOC			* branch if no carry
                            	  5303: 
01:00001BDE 903C0080        	  5304: 	SUB.b	#$80,d0	    		* normalise result
01:00001BE2 6400E70E        	  5305: 	BCC		LAB_OFER			* if no carry do overflow
                            	  5306: 
01:00001BE6 6006            	  5307: 	BRA.s	LAB_MADD			* branch
                            	  5308: 
                            	  5309: 					    		* no carry for exponent add
                            	  5310: LAB_MNOC
01:00001BE8 903C0080        	  5311: 	SUB.b	#$80,d0		    	* normalise result
01:00001BEC 6554            	  5312: 	BCS.s	LAB_MUUF			* return zero if underflow
                            	  5313: 
                            	  5314: LAB_MADD
01:00001BEE 17404194        	  5315: 	MOVE.b	d0,FAC1_e(a3)		* save exponent
                            	  5316: 
                            	  5317: 						    	* d1 (FAC1) x d2 (FAC2)
01:00001BF2 222B4190        	  5318: 	MOVE.l	FAC1_m(a3),d1		* get FAC1 mantissa
01:00001BF6 242B4198        	  5319: 	MOVE.l	FAC2_m(a3),d2		* get FAC2 mantissa
                            	  5320: 
01:00001BFA 3801            	  5321: 	MOVE.w	d1,d4				* copy low word FAC1
01:00001BFC 2001            	  5322: 	MOVE.l	d1,d0				* copy long word FAC1
01:00001BFE 4840            	  5323: 	SWAP	d0  				* high word FAC1 to low word FAC1
01:00001C00 3600            	  5324: 	MOVE.w	d0,d3				* copy high word FAC1
                            	  5325: 
01:00001C02 C2C2            	  5326: 	MULU	d2,d1				* low word FAC2 x low word FAC1
01:00001C04 C0C2            	  5327: 	MULU	d2,d0				* low word FAC2 x high word FAC1
01:00001C06 4842            	  5328: 	SWAP	d2  				* high word FAC2 to low word FAC2
01:00001C08 C8C2            	  5329: 	MULU	d2,d4				* high word FAC2 x low word FAC1
01:00001C0A C6C2            	  5330: 	MULU	d2,d3				* high word FAC2 x high word FAC1
                            	  5331: 
                            	  5332: * done multiply, now add partial products
                            	  5333: 
                            	  5334: *		d1 =				aaaa  ----	FAC2_L x FAC1_L
                            	  5335: *		d0 =				bbbb  aaaa	FAC2_L x FAC1_H
                            	  5336: *		d4 =				bbbb  aaaa	FAC2_H x FAC1_L
                            	  5337: *		d3 =	    		cccc  bbbb	FAC2_H x FAC1_H
                            	  5338: *		product =	    	mmmm  mmmm
                            	  5339: 
01:00001C0C D2BC00008000    	  5340: 	ADD.L	#$8000,d1   		* round up lowest word
01:00001C12 4241            	  5341: 	CLR.w	d1			    	* clear low word, don't need it
01:00001C14 4841            	  5342: 	SWAP	d1				    * align high word
01:00001C16 D280            	  5343: 	ADD.l	d0,d1				* add FAC2_L x FAC1_H (can't be carry)
                            	  5344: LAB_MUF1
01:00001C18 D284            	  5345: 	ADD.l	d4,d1				* now add intermediate (FAC2_H x FAC1_L)
01:00001C1A 6406            	  5346: 	BCC.s	LAB_MUF2			* branch if no carry
                            	  5347: 
01:00001C1C D6BC00010000    	  5348: 	ADD.l	#$10000,d3			* else correct result
                            	  5349: LAB_MUF2
01:00001C22 D2BC00008000    	  5350: 	ADD.l	#$8000,d1			* round up low word
01:00001C28 4241            	  5351: 	CLR.w	d1		    		* clear low word
01:00001C2A 4841            	  5352: 	SWAP	d1			    	* align for final add
01:00001C2C D283            	  5353: 	ADD.l	d3,d1				* add FAC2_H x FAC1_H, result
01:00001C2E 6B08            	  5354: 	BMI.s	LAB_MUF3			* branch if normalisation not needed
                            	  5355: 
01:00001C30 D281            	  5356: 	ADD.l	d1,d1				* shift mantissa
01:00001C32 532B4194        	  5357: 	SUBQ.b	#1,FAC1_e(a3)		* adjust exponent
01:00001C36 670A            	  5358: 	BEQ.s	LAB_MUUF			* branch if underflow
                            	  5359: 
                            	  5360: LAB_MUF3
01:00001C38 27414190        	  5361: 	MOVE.l	d1,FAC1_m(a3)		* save mantissa
                            	  5362: LAB_MUEX
01:00001C3C 4CDF001F        	  5363: 	MOVEM.l	(sp)+,d0-d4			* restore registers
01:00001C40 4E75            	  5364: 	RTS
                            	  5365: 							    * either zero or underflow result
                            	  5366: LAB_MUUF
01:00001C42 7000            	  5367: 	MOVEQ	#0,d0				* quick clear
01:00001C44 27404190        	  5368: 	MOVE.l	d0,FAC1_m(a3)		* clear mantissa
01:00001C48 37404194        	  5369: 	MOVE.w	d0,FAC1_e(a3)		* clear sign and exponent
01:00001C4C 60EE            	  5370: 	BRA.s	LAB_MUEX			* restore regs & exit
                            	  5371: 
                            	  5372: 
                            	  5373: *************************************************************************************
                            	  5374: *
                            	  5375: * do FAC2/FAC1, result in FAC1
                            	  5376: * fast hardware divide version
                            	  5377: 
                            	  5378: LAB_DIVIDE
01:00001C4E 2F07            	  5379: 	MOVE.l	d7,-(sp)			* save d7
01:00001C50 7000            	  5380: 	MOVEQ	#0,d0				* clear FAC2 exponent
01:00001C52 2400            	  5381: 	MOVE.l	d0,d2				* clear FAC1 exponent
                            	  5382: 
01:00001C54 142B4194        	  5383: 	MOVE.b	FAC1_e(a3),d2		* get FAC1 exponent
01:00001C58 6700E684        	  5384: 	BEQ		LAB_DZER			* if zero go do /0 error
                            	  5385: 
01:00001C5C 102B419C        	  5386: 	MOVE.b	FAC2_e(a3),d0		* get FAC2 exponent
01:00001C60 6766            	  5387: 	BEQ.s	LAB_DIV0			* if zero return zero
                            	  5388: 
01:00001C62 9042            	  5389: 	SUB.w	d2,d0				* get result exponent by subtracting
01:00001C64 D07C0080        	  5390: 	ADD.w	#$80,d0		    	* correct 16 bit exponent result
                            	  5391: 
01:00001C68 176B419E4195    	  5392: 	MOVE.b	FAC_sc(a3),FAC1_s(a3)	* sign compare is result sign
                            	  5393: 
                            	  5394: * now to do 32/32 bit mantissa divide
                            	  5395: 
01:00001C6E 422B419F        	  5396: 	CLR.b	flag(a3)			* clear 'flag' byte
01:00001C72 262B4190        	  5397: 	MOVE.l	FAC1_m(a3),d3		* get FAC1 mantissa
01:00001C76 282B4198        	  5398: 	MOVE.l	FAC2_m(a3),d4		* get FAC2 mantissa
01:00001C7A B883            	  5399: 	CMP.l	d3,d4				* compare FAC2 with FAC1 mantissa
01:00001C7C 6744            	  5400: 	BEQ.s	LAB_MAN1			* set mantissa result = 1 if equal
                            	  5401: 
01:00001C7E 6506            	  5402: 	BCS.s	AC1gtAC2			* branch if FAC1 > FAC2
                            	  5403: 
01:00001C80 9883            	  5404: 	SUB.l	d3,d4				* subtract FAC1 from FAC2, result now must be <1
01:00001C82 562B419F        	  5405: 	ADDQ.b	#3,flag(a3)			* FAC2>FAC1 so set 'flag' byte
                            	  5406: AC1gtAC2
01:00001C86 6146            	  5407: 	BSR.s	LAB_32_16			* do 32/16 divide
01:00001C88 4841            	  5408: 	SWAP	d1			    	* move 16 bit result to high word
01:00001C8A 2802            	  5409: 	MOVE.l	d2,d4				* copy remainder longword
01:00001C8C 6142            	  5410: 	BSR.s	LAB_3216			* do 32/16 divide again (skip copy d4 to d2)
01:00001C8E 84C5            	  5411: 	DIVU.w	d5,d2				* now divide remainder to make guard word
01:00001C90 1E2B419F        	  5412: 	MOVE.b	flag(a3),d7			* now normalise, get flag byte back
01:00001C94 6708            	  5413: 	BEQ.s	LAB_DIVX			* skip add if null
                            	  5414: 
                            	  5415: * else result was >1 so we need to add 1 to result mantissa and adjust exponent
                            	  5416: 
01:00001C96 E20F            	  5417: 	LSR.b	#1,d7				* shift 1 into eXtend
01:00001C98 E291            	  5418: 	ROXR.l	#1,d1				* shift extend result >>
01:00001C9A E252            	  5419: 	ROXR.w	#1,d2				* shift extend guard word >>
01:00001C9C 5200            	  5420: 	ADDQ.b	#1,d0				* adjust exponent
                            	  5421: 
                            	  5422: * now round result to 32 bits
                            	  5423: 
                            	  5424: LAB_DIVX
01:00001C9E D442            	  5425: 	ADD.w	d2,d2				* guard bit into eXtend bit
01:00001CA0 6408            	  5426: 	BCC.s	L_DIVRND			* branch if guard=0
                            	  5427: 
01:00001CA2 5281            	  5428: 	ADDQ.l	#1,d1				* add guard to mantissa
01:00001CA4 6404            	  5429: 	BCC.s	L_DIVRND			* branch if no overflow
                            	  5430: 
                            	  5431: LAB_SET1
01:00001CA6 E291            	  5432: 	ROXR.l	#1,d1				* shift extend result >>
01:00001CA8 5240            	  5433: 	ADDQ.w	#1,d0				* adjust exponent
                            	  5434: 
                            	  5435: 			    				* test for over/under flow
                            	  5436: L_DIVRND
01:00001CAA 3600            	  5437: 	MOVE.w	d0,d3				* copy exponent
01:00001CAC 6B1A            	  5438: 	BMI.s	LAB_DIV0			* if -ve return zero
                            	  5439: 
01:00001CAE 0243FF00        	  5440: 	ANDI.w	#$FF00,d3			* mask word high byte
01:00001CB2 6600E63E        	  5441: 	BNE		LAB_OFER			* branch if overflow
                            	  5442: 
                            	  5443: 			    				* move result into FAC1
                            	  5444: LAB_XDIV
01:00001CB6 2E1F            	  5445: 	MOVE.l	(sp)+,d7			* restore d7
01:00001CB8 17404194        	  5446: 	MOVE.b	d0,FAC1_e(a3)		* save result exponent
01:00001CBC 27414190        	  5447: 	MOVE.l	d1,FAC1_m(a3)		* save result mantissa
01:00001CC0 4E75            	  5448: 	RTS
                            	  5449: 
                            	  5450: * FAC1 mantissa = FAC2 mantissa so set result mantissa
                            	  5451: 
                            	  5452: LAB_MAN1
01:00001CC2 7201            	  5453: 	MOVEQ	#1,d1				* set bit
01:00001CC4 E2A9            	  5454: 	LSR.l	d1,d1				* bit into eXtend
01:00001CC6 60DE            	  5455: 	BRA.s	LAB_SET1			* set mantissa, adjust exponent and exit
                            	  5456: 
                            	  5457: * result is zero
                            	  5458: 
                            	  5459: LAB_DIV0
01:00001CC8 7000            	  5460: 	MOVEQ	#0,d0				* zero exponent & sign
01:00001CCA 2200            	  5461: 	MOVE.l	d0,d1				* zero mantissa
01:00001CCC 60E8            	  5462: 	BRA		LAB_XDIV			* exit divide
                            	  5463: 
                            	  5464: * divide 16 bits into 32, AB/Ex
                            	  5465: *
                            	  5466: * d4			AAAA	BBBB	* 32 bit numerator
                            	  5467: * d3			EEEE	xxxx	* 16 bit denominator
                            	  5468: *
                            	  5469: * returns -
                            	  5470: *
                            	  5471: * d1			xxxx	DDDD	* 16 bit result
                            	  5472: * d2			HHHH	IIII	* 32 bit remainder
                            	  5473: 
                            	  5474: LAB_32_16
01:00001CCE 2404            	  5475: 	MOVE.l	d4,d2				* copy FAC2 mantissa		(AB)
                            	  5476: LAB_3216
01:00001CD0 2A03            	  5477: 	MOVE.l	d3,d5				* copy FAC1 mantissa		(EF)
01:00001CD2 4245            	  5478: 	CLR.w	d5	    			* clear low word d1		(Ex)
01:00001CD4 4845            	  5479: 	SWAP	d5		    		* swap high word to low word	(xE)
                            	  5480: 
                            	  5481: * d3		EEEE	FFFF		* denominator copy
                            	  5482: * d5		0000	EEEE		* denominator high word
                            	  5483: * d2		AAAA	BBBB		* numerator copy
                            	  5484: * d4		AAAA	BBBB		* numerator
                            	  5485: 
01:00001CD6 88C5            	  5486: 	DIVU.w	d5,d4				* do FAC2/FAC1 high word	(AB/E)
01:00001CD8 6802            	  5487: 	BVC.s	LAB_LT_1			* if no overflow DIV was ok
                            	  5488: 
01:00001CDA 78FF            	  5489: 	MOVEQ	#-1,d4	    		* else set default value
                            	  5490: 
                            	  5491: * done the divide, now check the result, we have ...
                            	  5492: 
                            	  5493: * d3		EEEE	FFFF		* denominator copy
                            	  5494: * d5		0000	EEEE		* denominator high word
                            	  5495: * d2		AAAA	BBBB		* numerator copy
                            	  5496: * d4		MMMM	DDDD		* result MOD and DIV
                            	  5497: 
                            	  5498: LAB_LT_1
01:00001CDC 3C04            	  5499: 	MOVE.w	d4,d6				* copy 16 bit result
01:00001CDE 3204            	  5500: 	MOVE.w	d4,d1				* copy 16 bit result again
                            	  5501: 
                            	  5502: * we now have ..
                            	  5503: * d3		EEEE	FFFF		* denominator copy
                            	  5504: * d5		0000	EEEE		* denominator high word
                            	  5505: * d6		xxxx    DDDD		* result DIV copy
                            	  5506: * d1		xxxx    DDDD		* result DIV copy
                            	  5507: * d2		AAAA	BBBB		* numerator copy
                            	  5508: * d4		MMMM	DDDD		* result MOD and DIV
                            	  5509: 
                            	  5510: * now multiply out 32 bit denominator by 16 bit result
                            	  5511: * QRS = AB*D
                            	  5512: 
01:00001CE0 CCC3            	  5513: 	MULU.w	d3,d6				* FFFF * DDDD =       rrrr  SSSS
01:00001CE2 C8C5            	  5514: 	MULU.w	d5,d4				* EEEE * DDDD = QQQQ  rrrr
                            	  5515: 
                            	  5516: * we now have ..
                            	  5517: * d3		EEEE	FFFF		* denominator copy
                            	  5518: * d5		0000	EEEE		* denominator high word
                            	  5519: * d6		rrrr    SSSS		* 48 bit result partial low
                            	  5520: * d1		xxxx    DDDD		* result DIV copy
                            	  5521: * d2		AAAA	BBBB		* numerator copy
                            	  5522: * d4		QQQQ	rrrr		* 48 bit result partial
                            	  5523: 
01:00001CE4 3E06            	  5524: 	MOVE.w	d6,d7				* copy low word of low multiply
                            	  5525: 
                            	  5526: * d7		xxxx	SSSS		* 48 bit result partial low
                            	  5527: 
01:00001CE6 4246            	  5528: 	CLR.w	d6  				* clear low word of low multiply
01:00001CE8 4846            	  5529: 	SWAP	d6	    			* high word of low multiply to low word
                            	  5530: 
                            	  5531: * d6		0000	rrrr		* high word of 48 bit result partial low
                            	  5532: 
01:00001CEA D886            	  5533: 	ADD.l	d6,d4
                            	  5534: 
                            	  5535: * d4		QQQQ	RRRR		* 48 bit result partial high longword
                            	  5536: 
01:00001CEC 7C00            	  5537: 	MOVEQ	#0,d6				* clear to extend numerator to 48 bits
                            	  5538: 
                            	  5539: * now do GHI = AB0 - QRS (which is the remainder)
                            	  5540: 
01:00001CEE 9C47            	  5541: 	SUB.w	d7,d6				* low word subtract
                            	  5542: 
                            	  5543: * d6		xxxx	IIII		* remainder low word
                            	  5544: 
01:00001CF0 9584            	  5545: 	SUBX.l	d4,d2				* high longword subtract
                            	  5546: 
                            	  5547: * d2		GGGG	HHHH		* remainder high longword
                            	  5548: 
                            	  5549: * now if we got the divide correct then the remainder high longword will be +ve
                            	  5550: 
01:00001CF2 6A08            	  5551: 	BPL.s	L_DDIV  			* branch if result is ok (<needed)
                            	  5552: 
                            	  5553: * remainder was -ve so DDDD is too big
                            	  5554: 
                            	  5555: LAB_REMM
01:00001CF4 5341            	  5556: 	SUBQ.w	#1,d1				* adjust DDDD
                            	  5557: 
                            	  5558: * d3		xxxx	FFFF		* denominator copy
                            	  5559: * d6		xxxx	IIII		* remainder low word
                            	  5560: 
01:00001CF6 DC43            	  5561: 	ADD.w	d3,d6				* add EF*1 low remainder low word
                            	  5562: 
                            	  5563: * d5		0000	EEEE		* denominator high word
                            	  5564: * d2		GGGG	HHHH		* remainder high longword
                            	  5565: 
01:00001CF8 D585            	  5566: 	ADDX.l	d5,d2				* add extend EF*1 to remainder high longword
01:00001CFA 6BF8            	  5567: 	BMI.s	LAB_REMM			* loop if result still too big
                            	  5568: 
                            	  5569: * all done and result correct or <
                            	  5570: 
                            	  5571: L_DDIV
01:00001CFC 4842            	  5572: 	SWAP	d2			    	* remainder mid word to high word
                            	  5573: 
                            	  5574: * d2		HHHH	GGGG		* (high word /should/ be $0000)
                            	  5575: 
01:00001CFE 3406            	  5576: 	MOVE.w	d6,d2				* remainder in high word
                            	  5577: 
                            	  5578: * d2			HHHH	IIII	* now is 32 bit remainder
                            	  5579: * d1			xxxx	DDDD	* 16 bit result
                            	  5580: 
01:00001D00 4E75            	  5581: 	RTS
