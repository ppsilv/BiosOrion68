                            	  7156: LAB_DupFmt
01:00002726 226F0004        	  7157: 	MOVEA.l	4+fsd(sp),a1		* get the format string descriptor pointer
01:0000272A 3E290004        	  7158: 	MOVE.w	4(a1),d7			* get the format string length
01:0000272E 342F000A        	  7159: 	MOVE.w	4+fsli(sp),d2		* get the format string last index
01:00002732 3C2F0008        	  7160: 	MOVE.w	4+fsti(sp),d6		* get the format string this index
01:00002736 3206            	  7161: 	MOVE.w	d6,d1				* copy the format string this index
01:00002738 9242            	  7162: 	SUB.w	d2,d1				* subtract the format string last index
01:0000273A 6202            	  7163: 	BHI.s	LAB_D002			* if > 0 skip the correction
                            	  7164: 
01:0000273C D247            	  7165: 	ADD.w	d7,d1				* else add the format string length as the
                            	  7166: 			    				* correction
                            	  7167: LAB_D002
01:0000273E 6100EE7E        	  7168: 	BSR		LAB_2115			* make string space d1 bytes long
                            	  7169: 				    			* return a0/Sutill = pointer, others unchanged
                            	  7170: 
