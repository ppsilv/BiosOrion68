                            	  9206: 
                            	  9207: 
                            	  9208: *************************************************************************************
                            	  9209: * EhBASIC keywords quick reference list								*
                            	  9210: *************************************************************************************
                            	  9211: 
                            	  9212: * glossary
                            	  9213: 
                            	  9214: *		<.>		  required
                            	  9215: *		{.|.}		  one of required
                            	  9216: *		[.]		  optional
                            	  9217: *		...		  may repeat as last
                            	  9218: 
                            	  9219: *		any		= anything
                            	  9220: *		num		= number
                            	  9221: *		state		= statement
                            	  9222: *		n		= positive integer
                            	  9223: *		str		= string
                            	  9224: *		var		= variable
                            	  9225: *		nvar		= numeric variable
                            	  9226: *		svar		= string variable
                            	  9227: *		expr		= expression
                            	  9228: *		nexpr		= numeric expression
                            	  9229: *		sexpr		= string expression
                            	  9230: 
                            	  9231: * statement separator
                            	  9232: 
                            	  9233: * :		. [<state>] : [<state>]						* done
                            	  9234: 
                            	  9235: * number bases
                            	  9236: 
                            	  9237: * %		. %<binary num>							* done
                            	  9238: * $		. $<hex num>							* done
                            	  9239: 
                            	  9240: * commands
                            	  9241: 
                            	  9242: * END		. END									* done
                            	  9243: * FOR		. FOR <nvar>=<nexpr> TO <nexpr> [STEP <nexpr>]		* done
                            	  9244: * NEXT	. NEXT [<nvar>[,<nvar>]...]					* done
                            	  9245: * DATA	. DATA [{num|["]str["]}[,{num|["]str["]}]...]		* done
                            	  9246: * INPUT	. INPUT [<">str<">;] <var>[,<var>[,<var>]...]		* done
                            	  9247: * DIM		. DIM <var>(<nexpr>[,<nexpr>[,<nexpr>]])			* done
                            	  9248: * READ	. READ <var>[,<var>[,<var>]...]				* done
                            	  9249: * LET		. [LET] <var>=<expr>						* done
                            	  9250: * DEC		. DEC <nvar>[,<nvar>[,<nvar>]...]				* done
                            	  9251: * GOTO	. GOTO <n>								* done
                            	  9252: * RUN		. RUN [<n>]								* done
                            	  9253: * IF		. IF <expr>{GOTO<n>|THEN<{n|comm}>}[ELSE <{n|comm}>]	* done
                            	  9254: * RESTORE	. RESTORE [<n>]							* done
                            	  9255: * GOSUB	. GOSUB <n>								* done
                            	  9256: * RETURN	. RETURN								* done
                            	  9257: * REM		. REM [<any>]							* done
                            	  9258: * STOP	. STOP								* done
                            	  9259: * ON		. ON <nexpr>{GOTO|GOSUB}<n>[,<n>[,<n>]...]		* done
                            	  9260: * NULL	. NULL <nexpr>							* done
                            	  9261: * INC		. INC <nvar>[,<nvar>[,<nvar>]...]				* done
                            	  9262: * WAIT	. WAIT <nexpr>,<nexpr>[,<nexpr>]				* done
                            	  9263: * LOAD	. LOAD [<sexpr>]							* done for sim
                            	  9264: * SAVE	. SAVE [<sexpr>][,[<n>][-<n>]]				* done for sim
                            	  9265: * DEF		. DEF FN<var>(<var>)=<expr>					* done
                            	  9266: * POKE	. POKE <nexpr>,<nexpr>						* done
                            	  9267: * DOKE	. DOKE <nexpr>,<nexpr>						* done
                            	  9268: * LOKE	. LOKE <nexpr>,<nexpr>						* done
                            	  9269: * CALL	. CALL <nexpr>							* done
                            	  9270: * DO		. DO									* done
                            	  9271: * LOOP	. LOOP [{WHILE|UNTIL}<nexpr>]					* done
                            	  9272: * PRINT	. PRINT [{;|,}][<expr>][{;|,}[<expr>]...]			* done
                            	  9273: * CONT	. CONT								* done
                            	  9274: * LIST	. LIST [<n>][-<n>]						* done
                            	  9275: * CLEAR	. CLEAR								* done
                            	  9276: * NEW		. NEW									* done
                            	  9277: * WIDTH	. WIDTH [<n>][,<n>]						* done
                            	  9278: * GET		. GET <var>								* done
                            	  9279: * SWAP	. SWAP <var>,<var>						* done
                            	  9280: * BITSET	. BITSET <nexpr>,<nexpr>					* done
                            	  9281: * BITCLR	. BITCLR <nexpr>,<nexpr>					* done
                            	  9282: 
                            	  9283: * sub commands (may not start a statement)
                            	  9284: 
                            	  9285: * TAB		. TAB(<nexpr>)							* done
                            	  9286: * ELSE	. IF <expr>{GOTO<n>|THEN<{n|comm}>}[ELSE <{n|comm}>]	* done
                            	  9287: * TO		. FOR <nvar>=<nexpr> TO <nexpr> [STEP <nexpr>]		* done
                            	  9288: * FN		. FN <var>(<expr>)						* done
                            	  9289: * SPC		. SPC(<nexpr>)							* done
                            	  9290: * THEN	. IF <nexpr> {THEN <{n|comm}>|GOTO <n>}			* done
                            	  9291: * NOT		. NOT <nexpr>							* done
                            	  9292: * STEP	. FOR <nvar>=<nexpr> TO <nexpr> [STEP <nexpr>]		* done
                            	  9293: * UNTIL	. LOOP [{WHILE|UNTIL}<nexpr>]					* done
                            	  9294: * WHILE	. LOOP [{WHILE|UNTIL}<nexpr>]					* done
                            	  9295: 
                            	  9296: * operators
                            	  9297: 
                            	  9298: * +		. [expr] + <expr>							* done
                            	  9299: * -		. [nexpr] - <nexpr>						* done
                            	  9300: * *		. <nexpr> * <nexpr>						* done fast hardware
                            	  9301: * /		. <nexpr> / <nexpr>						* done fast hardware
                            	  9302: * ^		. <nexpr> ^ <nexpr>						* done
                            	  9303: * AND		. <nexpr> AND <nexpr>						* done
                            	  9304: * EOR		. <nexpr> EOR <nexpr>						* done
                            	  9305: * OR		. <nexpr> OR <nexpr>						* done
                            	  9306: * >>		. <nexpr> >> <nexpr>						* done
                            	  9307: * <<		. <nexpr> << <nexpr>						* done
                            	  9308: 
                            	  9309: * compare functions
                            	  9310: 
                            	  9311: * <		. <expr> < <expr>							* done
                            	  9312: * =		. <expr> = <expr>							* done
                            	  9313: * >		. <expr> > <expr>							* done
                            	  9314: 
                            	  9315: * functions
                            	  9316: 
                            	  9317: * SGN		. SGN(<nexpr>)							* done
                            	  9318: * INT		. INT(<nexpr>)							* done
                            	  9319: * ABS		. ABS(<nexpr>)							* done
                            	  9320: * USR		. USR(<expr>)							* done
                            	  9321: * FRE		. FRE(<expr>)							* done
                            	  9322: * POS		. POS(<expr>)							* done
                            	  9323: * SQR		. SQR(<nexpr>)							* done fast shift/sub
                            	  9324: * RND		. RND(<nexpr>)							* done 32 bit PRNG
                            	  9325: * LOG		. LOG(<nexpr>)							* done fast cordic
                            	  9326: * EXP		. EXP(<nexpr>)							* done fast cordic
                            	  9327: * COS		. COS(<nexpr>)							* done fast cordic
                            	  9328: * SIN		. SIN(<nexpr>)							* done fast cordic
                            	  9329: * TAN		. TAN(<nexpr>)							* done fast cordic
                            	  9330: * ATN		. ATN(<nexpr>)							* done fast cordic
                            	  9331: * PEEK	. PEEK(<nexpr>)							* done
                            	  9332: * DEEK	. DEEK(<nexpr>)							* done
                            	  9333: * LEEK	. LEEK(<nexpr>)							* done
                            	  9334: * LEN		. LEN(<sexpr>)							* done
                            	  9335: * STR$	. STR$(<nexpr>)							* done
                            	  9336: * VAL		. VAL(<sexpr>)							* done
                            	  9337: * ASC		. ASC(<sexpr>)							* done
                            	  9338: * UCASE$	. UCASE$(<sexpr>)							* done
                            	  9339: * LCASE$	. LCASE$(<sexpr>)							* done
                            	  9340: * CHR$	. CHR$(<nexpr>)							* done
                            	  9341: * HEX$	. HEX$(<nexpr>)							* done
                            	  9342: * BIN$	. BIN$(<nexpr>)							* done
                            	  9343: * BTST	. BTST(<nexpr>,<nexpr>)						* done
                            	  9344: * MAX		. MAX(<nexpr>[,<nexpr>[,<nexpr>]...])			* done
                            	  9345: * MIN		. MIN(<nexpr>[,<nexpr>[,<nexpr>]...])			* done
                            	  9346: * PI		. PI									* done
                            	  9347: * TWOPI	. TWOPI								* done
                            	  9348: * VARPTR	. VARPTR(<var>)							* done
                            	  9349: * SADD	. SADD(<svar>)							* done
                            	  9350: * LEFT$	. LEFT$(<sexpr>,<nexpr>)					* done
                            	  9351: * RIGHT$	. RIGHT$(<sexpr>,<nexpr>)					* done
                            	  9352: * MID$	. MID$(<sexpr>,<nexpr>[,<nexpr>])				* done
                            	  9353: * USING$	. USING$(<sexpr>,<nexpr>[,<nexpr>]...])			* done
                            	  9354: 
                            	  9355: 
                            	  9356: *************************************************************************************
                            	  9357: 
                            	  9358: 	END	code_start
