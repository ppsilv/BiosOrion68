                            	  6488: LAB_COS
01:000022CC 277CC90FDAA34198	  6489: 	MOVE.l	#$C90FDAA3,FAC2_m(a3)	* pi/2 mantissa (LSB is rounded up so
                            	  6490: 				    			* COS(PI/2)=0)
01:000022D4 377C8100419C    	  6491: 	MOVE.w	#$8100,FAC2_e(a3)		* pi/2 exponent and sign
01:000022DA 176B4195419E    	  6492: 	MOVE.b	FAC1_s(a3),FAC_sc(a3)	* sign = FAC1 sign (b7)
01:000022E0 6100F73E        	  6493: 	BSR		LAB_ADD	    		* add FAC2 to FAC1, adjust for COS(x)
                            	  6494: 
