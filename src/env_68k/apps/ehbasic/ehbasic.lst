                            	  7197: **************************************************************************************
                            	  7198: *
                            	  7199: * process the format string
                            	  7200: 
                            	  7201: LAB_ProcFo
01:00002764 226F0004        	  7202: 	MOVEA.l	4+fsd(sp),a1		* get the format string descriptor pointer
01:00002768 3E290004        	  7203: 	MOVE.w	4(a1),d7			* get the format string length
01:0000276C 2251            	  7204: 	MOVEA.l	(a1),a1		    	* get the format string pointer
01:0000276E 3C2F000A        	  7205: 	MOVE.w	4+fsli(sp),d6		* get the format string last index
                            	  7206: 
01:00002772 3F47000C        	  7207: 	MOVE.w	d7,4+fsdpi(sp)		* set the format string decimal point index
                            	  7208: *##	MOVE.w	#-1,4+fsdpi(sp)		* set the format string decimal point index
01:00002776 7A00            	  7209: 	MOVEQ	#0,d5				* no decimal point
01:00002778 7600            	  7210: 	MOVEQ	#0,d3				* no decimal characters
01:0000277A 7400            	  7211: 	MOVEQ	#0,d2				* no special characters
                            	  7212: LAB_P004
01:0000277C 10316000        	  7213: 	MOVE.b	(a1,d6.w),d0		* get a format string byte
                            	  7214: 
01:00002780 B03C002C        	  7215: 	CMP.b	#',',d0		    	* compare it with ","
01:00002784 6742            	  7216: 	BEQ.s	LAB_P01A			* if "," go do the next format string byte
                            	  7217: 
01:00002786 B03C0023        	  7218: 	CMP.b	#'#',d0		    	* compare it with "#"
01:0000278A 6706            	  7219: 	BEQ.s	LAB_P008			* if "#" go flag special characters
                            	  7220: 
01:0000278C B03C0025        	  7221: 	CMP.b	#'%',d0			    * compare it with "%"
01:00002790 6608            	  7222: 	BNE.s	LAB_P00C			* if not "%" go try "+"
                            	  7223: 
                            	  7224: LAB_P008
01:00002792 4A85            	  7225: 	TST.l	d5			    	* test the decimal point flag
01:00002794 6A10            	  7226: 	BPL.s	LAB_P00E			* if no point skip counting decimal characters
                            	  7227: 
01:00002796 5243            	  7228: 	ADDQ.w	#1,d3				* else increment the decimal character count
01:00002798 602E            	  7229: 	BRA.s	LAB_P01A			* go do the next character
                            	  7230: 
                            	  7231: LAB_P00C
01:0000279A B03C002B        	  7232: 	CMP.b	#'+',d0	    		* compare it with "+"
01:0000279E 6706            	  7233: 	BEQ.s	LAB_P00E			* if "+" go flag special characters
                            	  7234: 
01:000027A0 B03C002D        	  7235: 	CMP.b	#'-',d0 			* compare it with "-"
01:000027A4 6604            	  7236: 	BNE.s	LAB_P010			* if not "-" go check decimal point
                            	  7237: 
                            	  7238: LAB_P00E
01:000027A6 8400            	  7239: 	OR.b	d0,d2				* flag special characters
01:000027A8 601E            	  7240: 	BRA.s	LAB_P01A			* go do the next character
                            	  7241: 
                            	  7242: LAB_P010
01:000027AA B03C002E        	  7243: 	CMP.b	#'.',d0		    	* compare it with "."
01:000027AE 6614            	  7244: 	BNE.s	LAB_P018			* if not "." go check next
                            	  7245: 
                            	  7246: * "." a decimal point
                            	  7247: 
01:000027B0 4A85            	  7248: 	TST.l	d5		    		* if there is already a decimal point
01:000027B2 6B14            	  7249: 	BMI.s	LAB_P01A			* go do the next character
                            	  7250: 
01:000027B4 3006            	  7251: 	MOVE.w	d6,d0				* copy the decimal point index
01:000027B6 906F000A        	  7252: 	SUB.w	4+fsli(sp),d0		* calculate it from the scan start
01:000027BA 3F40000C        	  7253: 	MOVE.w	d0,4+fsdpi(sp)		* save the decimal point index
01:000027BE 7AFF            	  7254: 	MOVEQ	#-1,d5  			* flag decimal point
01:000027C0 8400            	  7255: 	OR.b	d0,d2				* flag special characters
01:000027C2 6004            	  7256: 	BRA.s	LAB_P01A			* go do the next character
                            	  7257: 
                            	  7258: * was not a special character
                            	  7259: 
                            	  7260: LAB_P018
01:000027C4 4A02            	  7261: 	TST.b	d2	    			* test if there have been special characters
01:000027C6 6608            	  7262: 	BNE.s	LAB_P01E			* if so exit the format string process
                            	  7263: 
                            	  7264: LAB_P01A
01:000027C8 5246            	  7265: 	ADDQ.w	#1,d6				* increment the format string index
01:000027CA BE46            	  7266: 	CMP.w	d6,d7				* compare it with the format string length
01:000027CC 62AE            	  7267: 	BHI.s	LAB_P004			* if length > index go get the next character
                            	  7268: 
01:000027CE 7C00            	  7269: 	MOVEQ	#0,d6				* length = index so reset the format string
                            	  7270: 			    				* index
                            	  7271: LAB_P01E
01:000027D0 3F460008        	  7272: 	MOVE.w	d6,4+fsti(sp)		* save the format string this index
01:000027D4 3F43000E        	  7273: 	MOVE.w	d3,4+fsdc(sp)		* save the format string decimal characters
                            	  7274: 
01:000027D8 4E75            	  7275: 	RTS
