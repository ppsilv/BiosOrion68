00:00000000 00000000        	     6: ram_strt	ds.l	$1000	* allow 4K for the stack, this should be plenty
00:00000004 *
                            	     7: 							* for any BASIC program that doesn't do something
                            	     8: 							* silly, it could even be much less.
                            	     9: ram_base
                            	    10: 
00:00004000 0000            	    11: LAB_WARM	ds.w	1		* BASIC warm start entry point
00:00004002 00000000        	    12: Wrmjpv		ds.l	1		* BASIC warm start jump vector
                            	    13: 
00:00004006 0000            	    14: Usrjmp		ds.w	1		* USR function JMP address
00:00004008 00000000        	    15: Usrjpv		ds.l	1		* USR function JMP vector
                            	    16: 
                            	    17: * system dependant i/o vectors
                            	    18: * these are in RAM and are set at start-up
                            	    19: 
00:0000400C 0000            	    20: V_INPT		ds.w	1		* non halting scan input device entry point
00:0000400E 00000000        	    21: V_INPTv		ds.l	1		* non halting scan input device jump vector
                            	    22: 
00:00004012 0000            	    23: V_OUTP		ds.w	1		* send byte to output device entry point
00:00004014 00000000        	    24: V_OUTPv		ds.l	1		* send byte to output device jump vector
                            	    25: 
00:00004018 0000            	    26: V_LOAD		ds.w	1		* load BASIC program entry point
00:0000401A 00000000        	    27: V_LOADv		ds.l	1		* load BASIC program jump vector
                            	    28: 
00:0000401E 0000            	    29: V_SAVE		ds.w	1		* save BASIC program entry point
00:00004020 00000000        	    30: V_SAVEv		ds.l	1		* save BASIC program jump vector
                            	    31: 
00:00004024 0000            	    32: V_CTLC		ds.w	1		* save CTRL-C check entry point
00:00004026 00000000        	    33: V_CTLCv		ds.l	1		* save CTRL-C check jump vector
                            	    34: 
00:0000402A 00000000        	    35: Itemp		ds.l	1		* temporary integer	(for GOTO etc)
                            	    36: 
00:0000402E 00000000        	    37: Smeml		ds.l	1		* start of memory		(start of program)
                            	    38: 
                            	    39: * the program is stored as a series of lines each line having the following format
                            	    40: *
                            	    41: *		ds.l	1			* pointer to the next line or $00000000 if [EOT]
                            	    42: *		ds.l	1			* line number
                            	    43: *		ds.b	n			* program bytes
                            	    44: *		dc.b	$00			* [EOL] marker, there will be a second $00 byte, if
                            	    45: *							* needed, to pad the line to an even number of bytes
                            	    46: 
00:00004032 00000000        	    47: Sfncl		ds.l	1		* start of functions	(end of Program)
                            	    48: 
                            	    49: * the functions are stored as function name, function execute pointer and function
                            	    50: * variable name
                            	    51: *
                            	    52: *		ds.l	1			* name
                            	    53: *		ds.l	1			* execute pointer
                            	    54: *		ds.l	1			* function variable
                            	    55: 
00:00004036 00000000        	    56: Svarl		ds.l	1		* start of variables	(end of functions)
                            	    57: 
                            	    58: * the variables are stored as variable name, variable value
                            	    59: *
                            	    60: *		ds.l	1			* name
                            	    61: *		ds.l	1			* packed float or integer value
                            	    62: 
00:0000403A 00000000        	    63: Sstrl		ds.l	1		* start of strings	(end of variables)
                            	    64: 
                            	    65: * the strings are stored as string name, string pointer and string length
                            	    66: *
                            	    67: *		ds.l	1			* name
                            	    68: *		ds.l	1			* string pointer
                            	    69: *		ds.w	1			* string length
                            	    70: 
00:0000403E 00000000        	    71: Sarryl		ds.l	1		* start of arrays		(end of strings)
                            	    72: 
                            	    73: * the arrays are stored as array name, array size, array dimensions count, array
                            	    74: * dimensions upper bounds and array elements
                            	    75: *
                            	    76: *		ds.l	1			* name
                            	    77: *		ds.l	1			* size including this header
                            	    78: *		ds.w	1			* dimensions count
                            	    79: *		ds.w	1			* 1st dimension upper bound
                            	    80: *		ds.w	1			* 2nd dimension upper bound
                            	    81: *		...					* ...
                            	    82: *		ds.w	1			* nth dimension upper bound
                            	    83: *
                            	    84: * then (i1+1)*(i2+1)...*(in+1) of either ..
                            	    85: *
                            	    86: *		ds.l	1			* packed float or integer value
                            	    87: *
                            	    88: * .. if float or integer, or ..
                            	    89: *
                            	    90: *		ds.l	1			* string pointer
                            	    91: *		ds.w	1			* string length
                            	    92: *
                            	    93: * .. if string
                            	    94: 
00:00004042 00000000        	    95: Earryl		ds.l	1		* end of arrays		(start of free mem)
00:00004046 00000000        	    96: Sstorl		ds.l	1		* string storage	(moving down)
00:0000404A 00000000        	    97: Ememl		ds.l	1		* end of memory		(upper bound of RAM)
00:0000404E 00000000        	    98: Sutill		ds.l	1		* string utility ptr
00:00004052 00000000        	    99: Clinel		ds.l	1		* current line		(Basic line number)
00:00004056 00000000        	   100: Blinel		ds.l	1		* break line		(Basic line number)
                            	   101: 
00:0000405A 00000000        	   102: Cpntrl		ds.l	1		* continue pointer
00:0000405E 00000000        	   103: Dlinel		ds.l	1		* current DATA line
00:00004062 00000000        	   104: Dptrl		ds.l	1		* DATA pointer
00:00004066 00000000        	   105: Rdptrl		ds.l	1		* read pointer
00:0000406A 00000000        	   106: Varname		ds.l	1		* current var name
00:0000406E 00000000        	   107: Cvaral		ds.l	1		* current var address
00:00004072 00000000        	   108: Lvarpl		ds.l	1		* variable pointer for LET and FOR/NEXT
                            	   109: 
00:00004076 00000000        	   110: des_sk_e	ds.l	6		* descriptor stack end address
00:0000407A *
                            	   111: des_sk						* descriptor stack start address
                            	   112: 							* use a4 for the descriptor pointer
00:0000408E 0000            	   113: 			ds.w	1
00:00004090 00000000        	   114: Ibuffs		ds.l	$40		* start of input buffer
00:00004094 *
                            	   115: Ibuffe
                            	   116: 							* end of input buffer
                            	   117: 
00:00004190 00000000        	   118: FAC1_m		ds.l	1		* FAC1 mantissa1
00:00004194 0000            	   119: FAC1_e		ds.w	1		* FAC1 exponent
                            	   120: FAC1_s		EQU	FAC1_e+1	* FAC1 sign (b7)
00:00004196 0000            	   121: 			ds.w	1
                            	   122: 
00:00004198 00000000        	   123: FAC2_m		ds.l	1		* FAC2 mantissa1
00:0000419C 00000000        	   124: FAC2_e		ds.l	1		* FAC2 exponent
                            	   125: FAC2_s		EQU	FAC2_e+1	* FAC2 sign (b7)
                            	   126: FAC_sc		EQU	FAC2_e+2	* FAC sign comparison, Acc#1 vs #2
                            	   127: flag		EQU	FAC2_e+3	* flag byte for divide routine
                            	   128: 
00:000041A0 00000000        	   129: PRNlword	ds.l	1		* PRNG seed long word
                            	   130: 
00:000041A4 00000000        	   131: ut1_pl		ds.l	1		* utility pointer 1
                            	   132: 
00:000041A8 00000000        	   133: Asptl		ds.l	1		* array size/pointer
00:000041AC 00000000        	   134: Astrtl		ds.l	1		* array start pointer
                            	   135: 
                            	   136: numexp		EQU	Astrtl		* string to float number exponent count
                            	   137: expcnt		EQU	Astrtl+1	* string to float exponent count
                            	   138: 
                            	   139: expneg		EQU	Astrtl+3	* string to float eval exponent -ve flag
                            	   140: 
00:000041B0 00000000        	   141: func_l		ds.l	1		* function pointer
                            	   142: 
                            	   143: 
                            	   144: 							* these two need to be a word aligned pair !
00:000041B4 0000            	   145: Defdim		ds.w	1		* default DIM flag
                            	   146: cosout		EQU	Defdim		* flag which CORDIC output (re-use byte)
                            	   147: Dtypef		EQU	Defdim+1	* data type flag, $80=string, $40=integer, $00=float
                            	   148: 
                            	   149: 
00:000041B6 00000000        	   150: Binss		ds.l	4		* number to bin string start (32 chrs)
00:000041BA *
                            	   151: 
00:000041C6 00000000        	   152: Decss		ds.l	1		* number to decimal string start (16 chrs)
00:000041CA 0000            	   153: 			ds.w	1		*
00:000041CC 0000            	   154: Usdss		ds.w	1		* unsigned decimal string start (10 chrs)
                            	   155: 
00:000041CE 00000000        	   156: Hexss		ds.l	2		* number to hex string start (8 chrs)
00:000041D2 *
                            	   157: 
00:000041D6 0000            	   158: BHsend		ds.w	1		* bin/decimal/hex string end
                            	   159: 
                            	   160: 
00:000041D8 00              	   161: prstk		ds.b	1		* stacked function index
                            	   162: 
00:000041D9 00              	   163: tpower		ds.b	1		* remember CORDIC power
                            	   164: 
00:000041DA 00              	   165: Asrch		ds.b	1		* scan-between-quotes flag, alt search character
                            	   166: 
00:000041DB 00              	   167: Dimcnt		ds.b	1		* # of dimensions
                            	   168: 
00:000041DC 00              	   169: Breakf		ds.b	1		* break flag, $00=END else=break
00:000041DD 00              	   170: Oquote		ds.b	1		* open quote flag (Flag: DATA; LIST; memory)
00:000041DE 00              	   171: Gclctd		ds.b	1		* garbage collected flag
00:000041DF 00              	   172: Sufnxf		ds.b	1		* subscript/FNX flag, 1xxx xxx = FN(0xxx xxx)
00:000041E0 00              	   173: Imode		ds.b	1		* input mode flag, $00=INPUT, $98=READ
                            	   174: 
00:000041E1 00              	   175: Cflag		ds.b	1		* comparison evaluation flag
                            	   176: 
00:000041E2 00              	   177: TabSiz		ds.b	1		* TAB step size
                            	   178: 
00:000041E3 00              	   179: comp_f		ds.b	1		* compare function flag, bits 0,1 and 2 used
                            	   180: 							* bit 2 set if >
                            	   181: 							* bit 1 set if =
                            	   182: 							* bit 0 set if <
                            	   183: 
00:000041E4 00              	   184: Nullct		ds.b	1		* nulls output after each line
00:000041E5 00              	   185: TPos		ds.b	1		* BASIC terminal position byte
00:000041E6 00              	   186: TWidth		ds.b	1		* BASIC terminal width byte
00:000041E7 00              	   187: Iclim		ds.b	1		* input column limit
