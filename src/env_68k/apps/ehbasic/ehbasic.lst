01:00002BA8 903C0061        	  7885: 	SUB.b	#'a',d0	    		* subtract "a"
01:00002BAC 6506            	  7886: 	BCS.s	LAB_CHX3			* exit if <"a"
                            	  7887: 
01:00002BAE B03C0006        	  7888: 	CMP.b	#$06,d0		    	* compare normalised with $06 (max+1)
01:00002BB2 65E4            	  7889: 	BCS.s	LAB_CHX1			* loop if <="f"
