01:00002B72 177C004041B5    	  7858: 	MOVE.b	#$40,Dtypef(a3)		* set integer numeric data type
01:00002B78 7620            	  7859: 	MOVEQ	#32,d3  			* set up max binary exponent
                            	  7860: LAB_CHXX
01:00002B7A 6100E3CE        	  7861: 	BSR		LAB_IGBY			* increment & scan memory
01:00002B7E 6514            	  7862: 	BCS.s	LAB_ISHN			* branch if numeric character
                            	  7863: 
01:00002B80 803C0020        	  7864: 	OR.b	#$20,d0	    		* case convert, allow "A" to "F" and "a" to "f"
01:00002B84 903C0061        	  7865: 	SUB.b	#'a',d0		    	* subtract "a"
01:00002B88 652A            	  7866: 	BCS.s	LAB_CHX3			* exit if <"a"
                            	  7867: 
01:00002B8A B03C0006        	  7868: 	CMP.b	#$06,d0			    * compare normalised with $06 (max+1)
01:00002B8E 6424            	  7869: 	BCC.s	LAB_CHX3			* exit if >"f"
                            	  7870: 
01:00002B90 D03C003A        	  7871: 	ADD.b	#$3A,d0	    		* convert to nibble+"0"
