01:000022F8 176B4195419E    	  6505: 	MOVE.b	FAC1_s(a3),FAC_sc(a3)	* sign = FAC1 sign (b7)
01:000022FE 6100F8C2        	  6506: 	BSR		LAB_MULTIPLY		* multiply by 1/pi
                            	  6507: 
