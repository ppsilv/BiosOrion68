                            	  7803: LAB_2Y02
01:00002B08 D883            	  7804: 	ADD.l	d3,d4				* add mantissa decimal exponent
01:00002B0A 7620            	  7805: 	MOVEQ	#32,d3		    	* set up max binary exponent
01:00002B0C 4A81            	  7806: 	TST.l	d1		    		* test mantissa
01:00002B0E 6752            	  7807: 	BEQ.s	LAB_rtn0			* if mantissa=0 return 0
                            	  7808: 
