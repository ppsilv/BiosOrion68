                            	  5678: 
                            	  5679: *************************************************************************************
                            	  5680: *
                            	  5681: * get FAC1 sign
                            	  5682: * return d0=-1,C=1/-ve d0=+1,C=0/+ve
                            	  5683: 
                            	  5684: LAB_27CA
01:00001D96 7000            	  5685: 	MOVEQ	#0,d0				* clear d0
01:00001D98 102B4194        	  5686: 	MOVE.b	FAC1_e(a3),d0		* get FAC1 exponent
01:00001D9C 67F6            	  5687: 	BEQ.s	RTS_017			    * exit if zero (already correct SGN(0)=0)
                            	  5688: 
                            	  5689: 
                            	  5690: *************************************************************************************
                            	  5691: *
                            	  5692: * return d0=-1,C=1/-ve d0=+1,C=0/+ve
                            	  5693: * no = 0 check
                            	  5694: 
                            	  5695: LAB_27CE
01:00001D9E 102B4195        	  5696: 	MOVE.b	FAC1_s(a3),d0		* else get FAC1 sign (b7)
                            	  5697: 
                            	  5698: 
                            	  5699: *************************************************************************************
                            	  5700: *
                            	  5701: * return d0=-1,C=1/-ve d0=+1,C=0/+ve
                            	  5702: * no = 0 check, sign in d0
                            	  5703: 
                            	  5704: LAB_27D0
01:00001DA2 4880            	  5705: 	EXT.w	d0	    			* make word
01:00001DA4 48C0            	  5706: 	EXT.l	d0		    		* make longword
01:00001DA6 E080            	  5707: 	ASR.l	#8,d0				* move sign bit through byte to carry
01:00001DA8 65EA            	  5708: 	BCS.s	RTS_017		    	* exit if carry set
                            	  5709: 
01:00001DAA 7001            	  5710: 	MOVEQ	#1,d0				* set result for +ve sign
01:00001DAC 4E75            	  5711: 	RTS
                            	  5712: 
                            	  5713: 
                            	  5714: *************************************************************************************
                            	  5715: *
                            	  5716: * perform SGN()
                            	  5717: 
