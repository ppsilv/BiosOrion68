                            	    79: 							* RAM offset definitions
                            	    80: 
                            	    81: *	ORG		$000400			* past the vectors in a real system
                            	    82:     section .text
                            	    83: ehbasic::
01:00000000 600001D0        	    84: 	JMP 	code_start		* C ehbasic() entry point
                            	    85: 
                            	    86: *************************************************************************************
                            	    87: *
                            	    88: * the following code is simulator specific, change to suit your system
                            	    89: 
                            	    90: * output character to the console from register d0.b
                            	    91: 
                            	    92: VEC_OUT
01:00000004 48E7C080        	    93: 	MOVEM.l	d0-d1/a0,-(sp)      * save d0, d1, a0
01:00000008 7200            	    94:     CLR.l   d1
01:0000000A 1200            	    95: 	MOVE.b	d0,d1				* copy character
                            	    96: 
01:0000000C 7016            	    97:     MOVE.l	#SYS_BASIC_PUT_CHAR,d0 * get the key status
01:0000000E 274041EC        	    98:     MOVE.l  d0,syscall_command(a3) * save the syscall
01:00000012 274141F0        	    99:     MOVE.l  d1,syscall_d0(a3)      * character in d0
01:00000016 41EB41EC        	   100:     LEA     syscall_command(a3),a0 * pointer to struct
01:0000001A 4E4E            	   101: 	TRAP	#14				    * do I/O function
                            	   102: 
01:0000001C 4CDF0103        	   103: 	MOVEM.l	(sp)+,d0-d1/a0		* restore d0, d1
01:00000020 4E75            	   104: 	RTS
                            	   105: 
                            	   106: 
                            	   107: 
                            	   108: *************************************************************************************
                            	   109: *
                            	   110: * input a character from the console into register d0
                            	   111: * else return Cb=0 if there's no character available
                            	   112: 
                            	   113: VEC_IN
01:00000022 2F01            	   114:     MOVE.l  d1,-(sp)            * save d1
01:00000024 2F08            	   115:     MOVE.l  a0,-(sp)            * save a0
01:00000026 7014            	   116: 	MOVE.l	#SYS_BASIC_HAS_CHAR,d0 * get the key status
01:00000028 274041EC        	   117:     MOVE.l  d0,syscall_command(a3) * save the syscall
01:0000002C 41EB41EC        	   118:     LEA     syscall_command(a3),a0 * pointer to struct
01:00000030 4E4E            	   119: 	TRAP	#14				    * do I/O function
                            	   120: 
01:00000032 6608            	   121: 	BNE.s	RETCHR			    * if a character is waiting go get it
                            	   122: 
01:00000034 205F            	   123: 	MOVE.l	(sp)+,a0			* else restore a0
01:00000036 221F            	   124: 	MOVE.l	(sp)+,d1			* else restore d1
01:00000038 4A00            	   125: 	TST.b	d0				    * set the z flag
                            	   126: *	ANDI.b	#$FE,CCR			* clear the carry, flag we got no byte
                            	   127: *							    * done by the TST.b
01:0000003A 4E75            	   128: 	RTS
                            	   129: 
                            	   130: RETCHR
01:0000003C 7015            	   131: 	MOVE.l	#SYS_BASIC_GET_CHAR,d0 * get the key status
01:0000003E 274041EC        	   132:     MOVE.l  d0,syscall_command(a3) * save the syscall
01:00000042 41EB41EC        	   133:     LEA     syscall_command(a3),a0 * pointer to struct
01:00000046 4E4E            	   134:     TRAP    #14
                            	   135: 
01:00000048 205F            	   136: 	MOVE.l	(sp)+,a0			* restore a0
01:0000004A 221F            	   137: 	MOVE.l	(sp)+,d1			* restore d1
01:0000004C 4A00            	   138: 	TST.b	d0				    * set the z flag on the received byte
01:0000004E 003C0001        	   139: 	ORI.b	#1,CCR			    * set the carry, flag we got a byte
01:00000052 4E75            	   140: 	RTS
                            	   141: 
                            	   142: 
                            	   143: *************************************************************************************
                            	   144: *
                            	   145: * LOAD routine
                            	   146: VEC_LD
01:00000054 61000094        	   147: 	BSR		get_filename		* get the filename from the line
01:00000058 6700029C        	   148: 	BEQ		LAB_FCER			* if null do function call error then warm start
                            	   149: 
                            	   150:     * try to open the file
01:0000005C 48E77FFE        	   151:     MOVEM.l d1-d7/a0-a6,-(sp)
01:00000060 7001            	   152:     MOVE.l  #FA_READ,d0
01:00000062 2F00            	   153:     MOVE.l  d0,-(sp)            * push file mode to stack
01:00000064 4851            	   154:     PEA     (a1)                * push filename to stack
01:00000066 487900000000    	   155:     PEA     g_basic_file        * push FIL struct to stack
01:0000006C 4EB900000000    	   156:     JSR     f_open              * call f_open code
01:00000072 4FEF000C        	   157:     ADD.l   #12,sp              * clear the stack
01:00000076 4CDF7FFE        	   158:     MOVEM.l (sp)+,d1-d7/a0-a6	* restore registers
                            	   159: 
01:0000007A 4A40            	   160:     TST.w   d0                  * check if the file opened
01:0000007C 660C            	   161:     BNE.s   .LD_ERROR
                            	   162: 
01:0000007E 43FA000E        	   163: 	LEA		LOAD_in(pc),a1		* get byte from file vector
