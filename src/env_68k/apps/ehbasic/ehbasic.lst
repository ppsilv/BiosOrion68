                            	  5583: 
                            	  5584: *************************************************************************************
                            	  5585: *
                            	  5586: * unpack memory (a0) into FAC1
                            	  5587: 
                            	  5588: LAB_UFAC
01:00001D02 2010            	  5589: 	MOVE.l	(a0),d0		    	* get packed value
01:00001D04 4840            	  5590: 	SWAP	d0			    	* exponent and sign into least significant word
01:00001D06 37404194        	  5591: 	MOVE.w	d0,FAC1_e(a3)		* save exponent and sign
01:00001D0A 6708            	  5592: 	BEQ.s	LAB_NB1T			* branch if exponent (and the rest) zero
                            	  5593: 
01:00001D0C 807C0080        	  5594: 	OR.w	#$80,d0		    	* set MSb
01:00001D10 4840            	  5595: 	SWAP	d0			    	* word order back to normal
01:00001D12 E180            	  5596: 	ASL.l	#8,d0				* shift exponent & clear guard byte
                            	  5597: LAB_NB1T
01:00001D14 27404190        	  5598: 	MOVE.l	d0,FAC1_m(a3)		* move into FAC1
                            	  5599: 
01:00001D18 102B4194        	  5600: 	MOVE.b	FAC1_e(a3),d0		* get FAC1 exponent
01:00001D1C 4E75            	  5601: 	RTS
