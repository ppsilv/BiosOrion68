                            	  6424: *************************************************************************************
                            	  6425: *
                            	  6426: * RND(n), 32 bit Galois version. make n=0 for 19th next number in sequence or n<>0
                            	  6427: * to get 19th next number in sequence after seed n. This version of the PRNG uses
                            	  6428: * the Galois method and a sample of 65536 bytes produced gives the following values.
                            	  6429: 
                            	  6430: * Entropy = 7.997442 bits per byte
                            	  6431: * Optimum compression would reduce these 65536 bytes by 0 percent
                            	  6432: 
                            	  6433: * Chi square distribution for 65536 samples is 232.01, and
                            	  6434: * randomly would exceed this value 75.00 percent of the time
                            	  6435: 
                            	  6436: * Arithmetic mean value of data bytes is 127.6724, 127.5 would be random
                            	  6437: * Monte Carlo value for Pi is 3.122871269, error 0.60 percent
                            	  6438: * Serial correlation coefficient is -0.000370, totally uncorrelated would be 0.0
                            	  6439: 
                            	  6440: LAB_RND
01:00002278 4A2B4194        	  6441: 	TST.b	FAC1_e(a3)			* get FAC1 exponent
01:0000227C 6708            	  6442: 	BEQ.s	NextPRN	    		* do next random number if zero
                            	  6443: 
                            	  6444: 						    	* else get seed into random number store
01:0000227E 41EB41A0        	  6445: 	LEA		PRNlword(a3),a0		* set PRNG pointer
01:00002282 6100FAB2        	  6446: 	BSR		LAB_2778			* pack FAC1 into (a0)
                            	  6447: NextPRN
01:00002286 72AF            	  6448: 	MOVEQ	#$AF-$100,d1		* set EOR value
01:00002288 7412            	  6449: 	MOVEQ	#18,d2		    	* do this 19 times
01:0000228A 202B41A0        	  6450: 	MOVE.l	PRNlword(a3),d0		* get current
                            	  6451: Ninc0
01:0000228E D080            	  6452: 	ADD.l	d0,d0				* shift left 1 bit
01:00002290 6402            	  6453: 	BCC.s	Ninc1				* branch if bit 32 not set
                            	  6454: 
01:00002292 B300            	  6455: 	EOR.b	d1,d0				* do Galois LFSR feedback
                            	  6456: Ninc1
01:00002294 51CAFFF8        	  6457: 	DBF		d2,Ninc0			* loop
                            	  6458: 
01:00002298 274041A0        	  6459: 	MOVE.l	d0,PRNlword(a3)		* save back to seed word
01:0000229C 27404190        	  6460: 	MOVE.l	d0,FAC1_m(a3)		* copy to FAC1 mantissa
01:000022A0 377C80004194    	  6461: 	MOVE.w	#$8000,FAC1_e(a3)	* set the exponent and clear the sign
01:000022A6 6000F7F2        	  6462: 	BRA		LAB_24D5			* normalise FAC1 & return
                            	  6463: 
