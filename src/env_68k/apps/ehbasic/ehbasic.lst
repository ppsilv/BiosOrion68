                            	  5652: *************************************************************************************
                            	  5653: *
                            	  5654: * round FAC1
                            	  5655: 
                            	  5656: LAB_27BA
01:00001D6A 102B4194        	  5657: 	MOVE.b	FAC1_e(a3),d0		* get FAC1 exponent
01:00001D6E 6720            	  5658: 	BEQ.s	LAB_27C4			* branch if zero
                            	  5659: 
01:00001D70 202B4190        	  5660: 	MOVE.l	FAC1_m(a3),d0		* get FAC1
01:00001D74 D0BC00000080    	  5661: 	ADD.l	#$80,d0	    		* round to 24 bit
01:00001D7A 640A            	  5662: 	BCC.s	LAB_27C3			* branch if no overflow
                            	  5663: 
01:00001D7C E290            	  5664: 	ROXR.l	#1,d0				* shift FAC1 mantissa
01:00001D7E 522B4194        	  5665: 	ADDQ.b	#1,FAC1_e(a3)		* correct exponent
01:00001D82 6500E56E        	  5666: 	BCS		LAB_OFER			* if carry do overflow error & warm start
                            	  5667: 
                            	  5668: LAB_27C3
01:00001D86 C03C0000        	  5669: 	AND.b	#$00,d0 			* clear guard byte
01:00001D8A 27404190        	  5670: 	MOVE.l	d0,FAC1_m(a3)		* save back to FAC1
01:00001D8E 4E75            	  5671: 	RTS
                            	  5672: 
                            	  5673: LAB_27C4
01:00001D90 17404195        	  5674: 	MOVE.b	d0,FAC1_s(a3)		* make zero always +ve
                            	  5675: RTS_017
01:00001D94 4E75            	  5676: 	RTS
