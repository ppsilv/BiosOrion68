01:00001B60 5284            	  5239: 	ADDQ.l	#1,d4				* next i
01:00001B62 E28B            	  5240: 	LSR.l	#1,d3				* /2
01:00001B64 6704            	  5241: 	BEQ.s	LAB_LOCX			* branch y1 = 0
