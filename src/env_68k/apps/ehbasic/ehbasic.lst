                            	  7478: *
                            	  7479: * perform WIDTH
                            	  7480: 
                            	  7481: LAB_WDTH
01:00002908 B03C002C        	  7482: 	CMP.b	#',',d0 			* is next byte ","
01:0000290C 672C            	  7483: 	BEQ.s	LAB_TBSZ			* if so do tab size
                            	  7484: 
01:0000290E 6100EF9A        	  7485: 	BSR		LAB_GTBY			* get byte parameter, result in d0 and Itemp
01:00002912 4A00            	  7486: 	TST.b	d0		    		* test result
01:00002914 6712            	  7487: 	BEQ.s	LAB_NSTT			* branch if set for infinite line
                            	  7488: 
01:00002916 B03C0010        	  7489: 	CMP.b	#$10,d0		    	* else make min width = 16d
01:0000291A 6500D9DA        	  7490: 	BCS		LAB_FCER			* if less do function call error & exit
                            	  7491: 
                            	  7492: * this next compare ensures that we can't exit WIDTH via an error leaving the
                            	  7493: * tab size greater than the line length.
                            	  7494: 
01:0000291E B02B41E2        	  7495: 	CMP.b	TabSiz(a3),d0		* compare with tab size
01:00002922 6404            	  7496: 	BCC.s	LAB_NSTT			* branch if >= tab size
                            	  7497: 
01:00002924 174041E2        	  7498: 	MOVE.b	d0,TabSiz(a3)		* else make tab size = terminal width
                            	  7499: LAB_NSTT
01:00002928 174041E6        	  7500: 	MOVE.b	d0,TWidth(a3)		* set the terminal width
01:0000292C 6100E61E        	  7501: 	BSR		LAB_GBYT			* get BASIC byte back
01:00002930 672C            	  7502: 	BEQ.s	WExit				* exit if no following
                            	  7503: 
01:00002932 B03C002C        	  7504: 	CMP.b	#',',d0 			* else is it ","
01:00002936 6600D9CA        	  7505: 	BNE		LAB_SNER			* if not do syntax error
                            	  7506: 
                            	  7507: LAB_TBSZ
01:0000293A 6100EF6A        	  7508: 	BSR		LAB_SGBY			* increment and get byte, result in d0 and Itemp
01:0000293E 4A00            	  7509: 	TST.b	d0		    		* test TAB size
01:00002940 6B00D9B4        	  7510: 	BMI		LAB_FCER			* if >127 do function call error & exit
                            	  7511: 
01:00002944 B03C0001        	  7512: 	CMP.b	#1,d0				* compare with min-1
01:00002948 6500D9AC        	  7513: 	BCS		LAB_FCER			* if <=1 do function call error & exit
                            	  7514: 
01:0000294C 122B41E6        	  7515: 	MOVE.b	TWidth(a3),d1		* set flags for width
01:00002950 6708            	  7516: 	BEQ.s	LAB_SVTB			* skip check if infinite line
                            	  7517: 
01:00002952 B02B41E6        	  7518: 	CMP.b	TWidth(a3),d0		* compare TAB with width
01:00002956 6E00D99E        	  7519: 	BGT		LAB_FCER			* branch if too big
                            	  7520: 
                            	  7521: LAB_SVTB
01:0000295A 174041E2        	  7522: 	MOVE.b	d0,TabSiz(a3)		* save TAB size
                            	  7523: 
                            	  7524: * calculate tab column limit from TAB size. The Iclim is set to the last tab
                            	  7525: * position on a line that still has at least one whole tab width between it
                            	  7526: * and the end of the line.
                            	  7527: 
                            	  7528: WExit
01:0000295E 102B41E6        	  7529: 	MOVE.b	TWidth(a3),d0		* get width
01:00002962 670A            	  7530: 	BEQ.s	LAB_WDLP			* branch if infinite line
                            	  7531: 
01:00002964 B02B41E2        	  7532: 	CMP.b	TabSiz(a3),d0		* compare with tab size
01:00002968 6404            	  7533: 	BCC.s	LAB_WDLP			* branch if >= tab size
                            	  7534: 
01:0000296A 174041E2        	  7535: 	MOVE.b	d0,TabSiz(a3)		* else make tab size = terminal width
                            	  7536: LAB_WDLP
01:0000296E 902B41E2        	  7537: 	SUB.b	TabSiz(a3),d0		* subtract tab size
01:00002972 64FA            	  7538: 	BCC.s	LAB_WDLP			* loop while no borrow
                            	  7539: 
01:00002974 D02B41E2        	  7540: 	ADD.b	TabSiz(a3),d0		* add tab size back
01:00002978 D02B41E2        	  7541: 	ADD.b	TabSiz(a3),d0		* add tab size back again
                            	  7542: 
01:0000297C 4400            	  7543: 	NEG.b	d0  				* make -ve
01:0000297E D02B41E6        	  7544: 	ADD.b	TWidth(a3),d0		* subtract remainder from width
01:00002982 174041E7        	  7545: 	MOVE.b	d0,Iclim(a3)		* save tab column limit
