01:00002A14 277CC90FDAA24190	  7649: 	MOVE.l	#$C90FDAA2,FAC1_m(a3)	* 2pi mantissa (32 bit)
01:00002A1C 377C83004194    	  7650: 	MOVE.w	#$8300,FAC1_e(a3)		* 2pi exponent and sign
