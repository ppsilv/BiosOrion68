                            	  7278: *************************************************************************************
                            	  7279: *
                            	  7280: * perform BIN$()
                            	  7281: * # of leading 0s is in d1, the number is in d0
                            	  7282: 
                            	  7283: LAB_BINS
01:000027DA B23C0021        	  7284: 	CMP.b	#$21,d1			    * max + 1
01:000027DE 6400DB16        	  7285: 	BCC		LAB_FCER			* exit if too big ( > or = )
                            	  7286: 
01:000027E2 741F            	  7287: 	MOVEQ	#$1F,d2		    	* bit count-1
01:000027E4 41EB41B6        	  7288: 	LEA		Binss(a3),a0		* point to string
01:000027E8 7830            	  7289: 	MOVEQ	#$30,d4	    		* "0" character for ADDX
                            	  7290: NextB1
01:000027EA 7600            	  7291: 	MOVEQ	#0,d3				* clear byte
01:000027EC E288            	  7292: 	LSR.l	#1,d0				* shift bit into Xb
01:000027EE D704            	  7293: 	ADDX.b	d4,d3				* add carry and character to zero
01:000027F0 11832000        	  7294: 	MOVE.b	d3,(a0,d2.w)		* save character to string
01:000027F4 51CAFFF4        	  7295: 	DBF		d2,NextB1			* decrement and loop if not done
                            	  7296: 
                            	  7297: * this is the exit code and is also used by HEX$()
                            	  7298: 
                            	  7299: EndBHS
01:000027F8 177C000041D6    	  7300: 	MOVE.b	#0,BHsend(a3)		* null terminate the string
01:000027FE 4A01            	  7301: 	TST.b	d1		    		* test # of characters
01:00002800 670E            	  7302: 	BEQ.s	NextB2  			* go truncate string
                            	  7303: 
01:00002802 4481            	  7304: 	NEG.l	d1  				* make -ve
01:00002804 D2BC000041D6    	  7305: 	ADD.l	#BHsend,d1			* effectively (end-length)
01:0000280A 41F31000        	  7306: 	LEA		0(a3,d1.w),a0		* effectively add (end-length) to pointer
01:0000280E 600E            	  7307: 	BRA.s	BinPr				* go print string
                            	  7308: 
                            	  7309: * truncate string to remove leading "0"s
                            	  7310: 
                            	  7311: NextB2
01:00002810 1010            	  7312: 	MOVE.b	(a0),d0			    * get byte
01:00002812 670A            	  7313: 	BEQ.s	BinPr				* if null then end of string so add 1 and go
                            	  7314: 						    	* print it
                            	  7315: 
01:00002814 B03C0030        	  7316: 	CMP.b	#'0',d0	    		* compare with "0"
01:00002818 660E            	  7317: 	BNE.s	GoPr				* if not "0" then go print string from here
                            	  7318: 
01:0000281A 5248            	  7319: 	ADDQ.w	#1,a0				* else increment pointer
01:0000281C 60F2            	  7320: 	BRA.s	NextB2  			* loop always
                            	  7321: 
                            	  7322: * make fixed length output string - ignore overflows!
                            	  7323: 
                            	  7324: BinPr
01:0000281E 43EB41D6        	  7325: 	LEA		BHsend(a3),a1		* get string end
01:00002822 B1C9            	  7326: 	CMPA.l	a1,a0				* are we at the string end
01:00002824 6602            	  7327: 	BNE.s	GoPr				* branch if not
                            	  7328: 
01:00002826 5348            	  7329: 	SUBQ.w	#1,a0				* else need at least one zero
                            	  7330: GoPr
01:00002828 6000ED34        	  7331: 	BRA		LAB_20AE			* print " terminated string to FAC1, stack & RET
                            	  7332: 
