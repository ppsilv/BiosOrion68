                            	  5607: 
                            	  5608: LAB_PFAC
01:00001D1E 2F08            	  5609: 	MOVE.l	a0,-(sp)			* save pointer
01:00001D20 206B4072        	  5610: 	MOVEA.l	Lvarpl(a3),a0		* get destination pointer
01:00001D24 082B000641B5    	  5611: 	BTST	#6,Dtypef(a3)		* test data type
01:00001D2A 670C            	  5612: 	BEQ.s	LAB_277C			* branch if floating
                            	  5613: 
01:00001D2C 610000C6        	  5614: 	BSR		LAB_2831			* convert FAC1 floating to fixed
                            	  5615: 					    		* result in d0 and Itemp
01:00001D30 2080            	  5616: 	MOVE.l	d0,(a0)		    	* save in var
01:00001D32 205F            	  5617: 	MOVE.l	(sp)+,a0			* restore pointer
01:00001D34 4E75            	  5618: 	RTS
                            	  5619: 
                            	  5620: 
                            	  5621: *************************************************************************************
                            	  5622: *
                            	  5623: * normalise round and pack FAC1 into (a0)
                            	  5624: 
                            	  5625: LAB_2778
01:00001D36 2F08            	  5626: 	MOVE.l	a0,-(sp)			* save pointer
                            	  5627: LAB_277C
01:00001D38 6100FD60        	  5628: 	BSR		LAB_24D5			* normalise FAC1
01:00001D3C 612C            	  5629: 	BSR.s	LAB_27BA			* round FAC1
01:00001D3E 202B4190        	  5630: 	MOVE.l	FAC1_m(a3),d0		* get FAC1 mantissa
01:00001D42 E098            	  5631: 	ROR.l	#8,d0				* align 24/32 bit mantissa
01:00001D44 4840            	  5632: 	SWAP	d0			    	* exponent/sign into 0-15
01:00001D46 C07C007F        	  5633: 	AND.w	#$7F,d0			    * clear exponent and sign bit
01:00001D4A 022B00804195    	  5634: 	ANDI.b	#$80,FAC1_s(a3)		* clear non sign bits in sign
01:00001D50 806B4194        	  5635: 	OR.w	FAC1_e(a3),d0		* OR in exponent and sign
01:00001D54 4840            	  5636: 	SWAP	d0	    			* move exponent and sign back to 16-31
01:00001D56 2080            	  5637: 	MOVE.l	d0,(a0)	    		* store in destination
01:00001D58 205F            	  5638: 	MOVE.l	(sp)+,a0			* restore pointer
01:00001D5A 4E75            	  5639: 	RTS
