01:00000E56 D03C000A        	  2677: 	ADD.b	#(TK_GT-TK_PLUS),d0	* add # of operators (+ - * / ^ AND OR EOR)
01:00000E5A 645E            	  2678: 	BCC.s	LAB_1B78			* branch if < + operator
                            	  2679: 
01:00000E5C 6608            	  2680: 	BNE.s	LAB_1B0B			* branch if not + token
                            	  2681: 
