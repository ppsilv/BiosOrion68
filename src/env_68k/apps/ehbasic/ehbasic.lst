                            	  7550: *************************************************************************************
                            	  7551: *
                            	  7552: * perform SQR()
                            	  7553: 
                            	  7554: * d0 is number to find the root of
                            	  7555: * d1 is the root result
                            	  7556: * d2 is the remainder
                            	  7557: * d3 is a counter
                            	  7558: * d4 is temp
                            	  7559: 
                            	  7560: LAB_SQR
01:00002988 4A2B4195        	  7561: 	TST.b	FAC1_s(a3)			* test FAC1 sign
01:0000298C 6B00D968        	  7562: 	BMI		LAB_FCER			* if -ve do function call error
                            	  7563: 
01:00002990 4A2B4194        	  7564: 	TST.b	FAC1_e(a3)			* test exponent
01:00002994 67F0            	  7565: 	BEQ.s	RTS_023	    		* exit if zero
                            	  7566: 
01:00002996 48E77800        	  7567: 	MOVEM.l	d1-d4,-(sp)			* save registers
01:0000299A 202B4190        	  7568: 	MOVE.l	FAC1_m(a3),d0		* copy FAC1
01:0000299E 7400            	  7569: 	MOVEQ	#0,d2				* clear remainder
01:000029A0 2202            	  7570: 	MOVE.l	d2,d1				* clear root
                            	  7571: 
01:000029A2 761F            	  7572: 	MOVEQ	#$1F,d3		    	* $1F for DBF, 64 pairs of bits to
                            	  7573: 							    * do for a 32 bit result
01:000029A4 082B00004194    	  7574: 	BTST	#0,FAC1_e(a3)		* test exponent odd/even
01:000029AA 6606            	  7575: 	BNE.s	LAB_SQE2			* if odd only 1 shift first time
                            	  7576: 
                            	  7577: LAB_SQE1
01:000029AC D080            	  7578: 	ADD.l	d0,d0				* shift highest bit of number ..
01:000029AE D582            	  7579: 	ADDX.l	d2,d2				* .. into remainder .. never overflows
01:000029B0 D281            	  7580: 	ADD.l	d1,d1				* root = root * 2 .. never overflows
                            	  7581: LAB_SQE2
01:000029B2 D080            	  7582: 	ADD.l	d0,d0				* shift highest bit of number ..
01:000029B4 D582            	  7583: 	ADDX.l	d2,d2				* .. into remainder .. never overflows
                            	  7584: 
01:000029B6 2801            	  7585: 	MOVE.l	d1,d4				* copy root
01:000029B8 D884            	  7586: 	ADD.l	d4,d4				* 2n
01:000029BA 5284            	  7587: 	ADDQ.l	#1,d4				* 2n+1
                            	  7588: 
01:000029BC B484            	  7589: 	CMP.l	d4,d2				* compare 2n+1 to remainder
01:000029BE 6504            	  7590: 	BCS.s	LAB_SQNS			* skip sub if remainder smaller
                            	  7591: 
01:000029C0 9484            	  7592: 	SUB.l	d4,d2				* subtract temp from remainder
01:000029C2 5281            	  7593: 	ADDQ.l	#1,d1				* increment root
                            	  7594: LAB_SQNS
01:000029C4 51CBFFE6        	  7595: 	DBF		d3,LAB_SQE1			* loop if not all done
                            	  7596: 
01:000029C8 27414190        	  7597: 	MOVE.l	d1,FAC1_m(a3)		* save result mantissa
01:000029CC 102B4194        	  7598: 	MOVE.b	FAC1_e(a3),d0		* get exponent (d0 is clear here)
01:000029D0 907C0080        	  7599: 	SUB.w	#$80,d0	    		* normalise
01:000029D4 E248            	  7600: 	LSR.w	#1,d0				* /2
01:000029D6 6402            	  7601: 	BCC.s	LAB_SQNA			* skip increment if carry clear
                            	  7602: 
01:000029D8 5240            	  7603: 	ADDQ.w	#1,d0				* add bit zero back in (allow for half shift)
                            	  7604: LAB_SQNA
01:000029DA D07C0080        	  7605: 	ADD.w	#$80,d0 			* re-bias to $80
01:000029DE 17404194        	  7606: 	MOVE.b	d0,FAC1_e(a3)		* save it
01:000029E2 4CDF001E        	  7607: 	MOVEM.l	(sp)+,d1-d4			* restore registers
01:000029E6 6000F0B2        	  7608: 	BRA		LAB_24D5			* normalise FAC1 & return
