                            	  5781: 
                            	  5782: *************************************************************************************
                            	  5783: *
                            	  5784: * convert FAC1 floating to fixed
                            	  5785: * result in d0 and Itemp, sets flags correctly
                            	  5786: 
                            	  5787: LAB_2831
01:00001DF4 202B4190        	  5788: 	MOVE.l	FAC1_m(a3),d0		* copy mantissa
01:00001DF8 6730            	  5789: 	BEQ.s	LAB_284J			* branch if mantissa = 0
                            	  5790: 
01:00001DFA 2F01            	  5791: 	MOVE.l	d1,-(sp)			* save d1
01:00001DFC 72A0            	  5792: 	MOVEQ	#$A0,d1 			* set for no floating bits
01:00001DFE 922B4194        	  5793: 	SUB.b	FAC1_e(a3),d1		* subtract FAC1 exponent
01:00001E02 6500E4EE        	  5794: 	BCS		LAB_OFER			* do overflow if too big
                            	  5795: 
01:00001E06 660E            	  5796: 	BNE.s	LAB_284G			* branch if exponent was not $A0
                            	  5797: 
01:00001E08 4A2B4195        	  5798: 	TST.b	FAC1_s(a3)			* test FAC1 sign
01:00001E0C 6A1A            	  5799: 	BPL.s	LAB_284H			* branch if FAC1 +ve
                            	  5800: 
01:00001E0E 4480            	  5801: 	NEG.l	d0
01:00001E10 6916            	  5802: 	BVS.s	LAB_284H			* branch if was $80000000
                            	  5803: 
01:00001E12 6000E4DE        	  5804: 	BRA		LAB_OFER			* do overflow if too big
                            	  5805: 
                            	  5806: LAB_284G
01:00001E16 B23C0020        	  5807: 	CMP.b	#$20,d1	    		* compare with minimum result for integer
01:00001E1A 6502            	  5808: 	BCS.s	LAB_284L			* if < minimum just do shift
                            	  5809: 
01:00001E1C 7000            	  5810: 	MOVEQ	#0,d0				* else return zero
                            	  5811: LAB_284L
01:00001E1E E2A8            	  5812: 	LSR.l	d1,d0				* shift integer
                            	  5813: 
01:00001E20 4A2B4195        	  5814: 	TST.b	FAC1_s(a3)			* test FAC1 sign (b7)
01:00001E24 6A02            	  5815: 	BPL.s	LAB_284H			* branch if FAC1 +ve
                            	  5816: 
01:00001E26 4480            	  5817: 	NEG.l	d0		    		* negate integer value
                            	  5818: LAB_284H
01:00001E28 221F            	  5819: 	MOVE.l	(sp)+,d1			* restore d1
                            	  5820: LAB_284J
01:00001E2A 2740402A        	  5821: 	MOVE.l	d0,Itemp(a3)		* save result to Itemp
01:00001E2E 4E75            	  5822: 	RTS
                            	  5823: 
                            	  5824: 
                            	  5825: *************************************************************************************
                            	  5826: *
                            	  5827: * perform INT()
                            	  5828: 
                            	  5829: LAB_INT
01:00001E30 70A0            	  5830: 	MOVEQ	#$A0,d0 			* set for no floating bits
01:00001E32 902B4194        	  5831: 	SUB.b	FAC1_e(a3),d0		* subtract FAC1 exponent
01:00001E36 6310            	  5832: 	BLS.s	LAB_IRTS			* exit if exponent >= $A0
                            	  5833: 					    		* (too big for fraction part!)
                            	  5834: 
01:00001E38 B03C0020        	  5835: 	CMP.b	#$20,d0		    	* compare with minimum result for integer
01:00001E3C 6400025E        	  5836: 	BCC		LAB_POZE			* if >= minimum go return 0
                            	  5837: 						    	* (too small for integer part!)
                            	  5838: 
01:00001E40 72FF            	  5839: 	MOVEQ	#-1,d1		    	* set integer mask
01:00001E42 E1A1            	  5840: 	ASL.l	d0,d1				* shift mask [8+2*d0]
01:00001E44 C3AB4190        	  5841: 	AND.l	d1,FAC1_m(a3)		* mask mantissa
                            	  5842: LAB_IRTS
01:00001E48 4E75            	  5843: 	RTS
                            	  5844: 
                            	  5845: 
                            	  5846: *************************************************************************************
                            	  5847: *
                            	  5848: * print " in line [LINE #]"
                            	  5849: 
                            	  5850: LAB_2953
01:00001E4A 41FA181D        	  5851: 	LEA		LAB_LMSG(pc),a0		* point to " in line " message
01:00001E4E 6100ED30        	  5852: 	BSR		LAB_18C3			* print null terminated string
                            	  5853: 
                            	  5854: 							* Print Basic line #
01:00001E52 202B4052        	  5855: 	MOVE.l	Clinel(a3),d0		* get current line
                            	  5856: 
                            	  5857: 
                            	  5858: *************************************************************************************
                            	  5859: *
                            	  5860: * print d0 as unsigned integer
                            	  5861: 
                            	  5862: LAB_295E
01:00001E56 43FA0DDE        	  5863: 	LEA		Bin2dec(pc),a1		* get table address
01:00001E5A 7200            	  5864: 	MOVEQ	#0,d1				* table index
01:00001E5C 41EB41CC        	  5865: 	LEA		Usdss(a3),a0		* output string start
01:00001E60 2401            	  5866: 	MOVE.l	d1,d2				* output string index
                            	  5867: LAB_2967
01:00001E62 26311000        	  5868: 	MOVE.l	(a1,d1.w),d3		* get table value
01:00001E66 6714            	  5869: 	BEQ.s	LAB_2969			* exit if end marker
                            	  5870: 
01:00001E68 782F            	  5871: 	MOVEQ	#'0'-1,d4			* set character to "0"-1
                            	  5872: LAB_2968
01:00001E6A 5244            	  5873: 	ADDQ.w	#1,d4				* next numeric character
01:00001E6C 9083            	  5874: 	SUB.l	d3,d0				* subtract table value
01:00001E6E 6AFA            	  5875: 	BPL.s	LAB_2968			* not overdone so loop
                            	  5876: 
01:00001E70 D083            	  5877: 	ADD.l	d3,d0				* correct value
01:00001E72 11842000        	  5878: 	MOVE.b	d4,(a0,d2.w)		* character out to string
01:00001E76 5841            	  5879: 	ADDQ.w	#4,d1				* increment table pointer
01:00001E78 5242            	  5880: 	ADDQ.w	#1,d2				* increment output string pointer
01:00001E7A 60E6            	  5881: 	BRA.s	LAB_2967			* loop
                            	  5882: 
                            	  5883: LAB_2969
01:00001E7C D03C0030        	  5884: 	ADD.b	#'0',d0	    		* make last character
01:00001E80 11802000        	  5885: 	MOVE.b	d0,(a0,d2.w)		* character out to string
01:00001E84 5348            	  5886: 	SUBQ.w	#1,a0				* decrement a0 (allow simple loop)
                            	  5887: 
                            	  5888: 						    	* now find non zero start of string
                            	  5889: LAB_296A
01:00001E86 5248            	  5890: 	ADDQ.w	#1,a0				* increment a0 (this will never carry to b16)
01:00001E88 43EB41D5        	  5891: 	LEA		BHsend-1(a3),a1		* get string end
01:00001E8C B1C9            	  5892: 	CMPA.l	a1,a0				* are we at end
01:00001E8E 6700ECF0        	  5893: 	BEQ		LAB_18C3			* if so print null terminated string and RETURN
                            	  5894: 
01:00001E92 0C100030        	  5895: 	CMPI.b	#'0',(a0)			* is character "0" ?
01:00001E96 67EE            	  5896: 	BEQ.s	LAB_296A			* loop if so
                            	  5897: 
01:00001E98 6000ECE6        	  5898: 	BRA		LAB_18C3			* print null terminated string from memory & RET
                            	  5899: 
                            	  5900: 
                            	  5901: *************************************************************************************
                            	  5902: *
                            	  5903: * convert FAC1 to ASCII string result in (a0)
                            	  5904: * STR$() function enters here
                            	  5905: 
                            	  5906: * now outputs 7 significant digits
                            	  5907: 
                            	  5908: * d0 is character out
                            	  5909: * d1 is save index
                            	  5910: * d2 is gash
                            	  5911: 
                            	  5912: * a0 is output string pointer
                            	  5913: 
                            	  5914: LAB_2970
01:00001E9C 43EB41C6        	  5915: 	LEA		Decss(a3),a1		* set output string start
                            	  5916: 
01:00001EA0 7420            	  5917: 	MOVEQ	#' ',d2 			* character = " ", assume +ve
01:00001EA2 08AB00074195    	  5918: 	BCLR.b	#7,FAC1_s(a3)		* test and clear FAC1 sign (b7)
01:00001EA8 6702            	  5919: 	BEQ.s	LAB_2978			* branch if +ve
                            	  5920: 
01:00001EAA 742D            	  5921: 	MOVEQ	#'-',d2			    * else character = "-"
                            	  5922: LAB_2978
01:00001EAC 1282            	  5923: 	MOVE.b	d2,(a1)		    	* save the sign character
01:00001EAE 142B4194        	  5924: 	MOVE.b	FAC1_e(a3),d2		* get FAC1 exponent
01:00001EB2 6608            	  5925: 	BNE.s	LAB_2989			* branch if FAC1<>0
                            	  5926: 
