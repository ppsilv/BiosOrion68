                            	   409: 
01:0000026A 41EB4214        	   410: 	LEA		prg_strt(a3),a0		* get start of mem
01:0000026E 2748402E        	   411: 	MOVE.l	a0,Smeml(a3)		* save start of mem
                            	   412: 
