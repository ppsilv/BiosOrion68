                            	  6465: *************************************************************************************
                            	  6466: *
                            	  6467: * cordic TAN(x) routine, TAN(x) = SIN(x)/COS(x)
                            	  6468: * x = angle in radians
                            	  6469: 
                            	  6470: LAB_TAN
01:000022AA 6138            	  6471: 	BSR.s	LAB_SIN		    	* go do SIN/COS cordic compute
01:000022AC 376B4194419C    	  6472: 	MOVE.w	FAC1_e(a3),FAC2_e(a3)	* copy exponent & sign from FAC1 to FAC2
01:000022B2 276B41904198    	  6473: 	MOVE.l	FAC1_m(a3),FAC2_m(a3)	* copy FAC1 mantissa to FAC2 mantissa
01:000022B8 27414190        	  6474: 	MOVE.l	d1,FAC1_m(a3)		* get COS(x) mantissa
01:000022BC 17434194        	  6475: 	MOVE.b	d3,FAC1_e(a3)		* get COS(x) exponent
01:000022C0 6700E030        	  6476: 	BEQ		LAB_OFER			* do overflow if COS = 0
                            	  6477: 
01:000022C4 6100F7D4        	  6478: 	BSR		LAB_24D5			* normalise FAC1
01:000022C8 6000F984        	  6479: 	BRA		LAB_DIVIDE			* do FAC2/FAC1 and return, FAC_sc set by SIN
                            	  6480: 							    * COS calculation
