                            	  2607: *************************************************************************************
                            	  2608: *
                            	  2609: * this routine evaluates any type of expression. first it pushes an end marker so
                            	  2610: * it knows when the expression has been evaluated, this is a precedence value of zero.
                            	  2611: * next the first value is evaluated, this can be an in line value, either numeric or
                            	  2612: * string, a variable or array element of any type, a function or even an expression
                            	  2613: * in parenthesis. this value is kept in FAC_1
                            	  2614: * after the value is evaluated a test is made on the next BASIC program byte, if it
                            	  2615: * is a comparrison operator i.e. "<", "=" or ">", then the corresponding bit is set
                            	  2616: * in the comparison evaluation flag. this test loops until no more comparrison operators
                            	  2617: * are found or more than one of any type is found. in the last case an error is generated
                            	  2618: 
                            	  2619: * evaluate expression
                            	  2620: 
                            	  2621: LAB_EVEX
01:00000DEA 534D            	  2622: 	SUBQ.w	#1,a5				* decrement BASIC execute pointer
                            	  2623: LAB_EVEZ
01:00000DEC 7200            	  2624: 	MOVEQ	#0,d1				* clear precedence word
01:00000DEE 174141B5        	  2625: 	MOVE.b	d1,Dtypef(a3)		* clear the data type, $80=string, $40=integer,
                            	  2626: 			    				* $00=float
01:00000DF2 601C            	  2627: 	BRA.s	LAB_1ACD			* enter loop
                            	  2628: 
