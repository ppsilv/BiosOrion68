01:00000DF8 30301002        	  2633: 	MOVE.w	2(a0,d1.w),d0		* get vector offset
01:00000DFC 48700000        	  2634: 	PEA		(a0,d0.w)			* push vector
                            	  2635: 
01:00000E00 2F2B4190        	  2636: 	MOVE.l	FAC1_m(a3),-(sp)	* push FAC1 mantissa
01:00000E04 3F2B4194        	  2637: 	MOVE.w	FAC1_e(a3),-(sp)	* push sign and exponent
01:00000E08 1F2B41E3        	  2638: 	MOVE.b	comp_f(a3),-(sp)	* push comparison evaluation flag
                            	  2639: 
01:00000E0C 32301000        	  2640: 	MOVE.w	(a0,d1.w),d1		* get precedence value
                            	  2641: LAB_1ACD
