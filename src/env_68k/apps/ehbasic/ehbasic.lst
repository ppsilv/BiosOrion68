01:000019CA 3480            	  4910: 	MOVE.w	d0,(a2)		    	* save string 2 length to string 1 length
                            	  4911: 
                            	  4912:  endc
                            	  4913: 
                            	  4914: 
                            	  4915: * if you want a non existant variable to return a null value then set the novar
                            	  4916: * value at the top of this file to some non zero value
                            	  4917: 
                            	  4918:  ifne	novar
                            	  4919: 
                            	  4920: 	MOVE.l	a2,d2				* copy the variable 1 pointer
                            	  4921: 	MOVE.l	d2,d3				* and again for any length
                            	  4922: 	BEQ.s	no_variable1		* if variable 1 doesn't exist skip the
                            	  4923: 			    				* value get
                            	  4924: 
                            	  4925: 	MOVE.l	(a2),d2	    		* get variable 1 value
                            	  4926: 	TST.b	d4			    	* check the data type
                            	  4927: 	BPL.s	no_variable1		* if not string skip the length get
                            	  4928: 
                            	  4929: 	MOVE.w	4(a2),d3			* else get variable 1 string length
                            	  4930: no_variable1
                            	  4931: 	MOVE.l	a0,d0				* copy the variable 2 pointer
                            	  4932: 	MOVE.l	d0,d1				* and again for any length
                            	  4933: 	BEQ.s	no_variable2		* if variable 2 doesn't exist skip the
                            	  4934: 		    					* value get and the new value save
                            	  4935: 
                            	  4936: 	MOVE.l	(a0),d0	    		* get variable 2 value
                            	  4937: 	MOVE.l	d2,(a0)+			* save variable 2 new value
                            	  4938: 	TST.b	d4		    		* check the data type
                            	  4939: 	BPL.s	no_variable2		* if not string skip the length get and
                            	  4940: 						    	* new length save
                            	  4941: 
                            	  4942: 	MOVE.w	(a0),d1		    	* else get variable 2 string length
                            	  4943: 	MOVE.w	d3,(a0)	    		* save variable 2 new string length
                            	  4944: no_variable2
                            	  4945: 	TST.l	d2				    * test if variable 1 exists
                            	  4946: 	BEQ.s	EXIT_SWAP			* if variable 1 doesn't exist skip the
                            	  4947: 						    	* new value save
                            	  4948: 
                            	  4949: 	MOVE.l	d0,(a2)+			* save variable 1 new value
                            	  4950: 	TST.b	d4		    		* check the data type
                            	  4951: 	BPL.s	EXIT_SWAP			* if not string skip the new length save
                            	  4952: 
                            	  4953: 	MOVE.w	d1,(a2)		    	* save variable 1 new string length
                            	  4954: EXIT_SWAP
                            	  4955: 
                            	  4956:  endc
                            	  4957: 
