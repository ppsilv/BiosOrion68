01:0000271A 6100F032        	  7139: 	BSR		LAB_22BA			* pop (a0) descriptor, returns with ..
                            	  7140: 				    			* d0 = length, a0 = pointer
                            	  7141: 
01:0000271E 508F            	  7142: 	LEA		fend(sp),sp			* dump the saved values
