                            	  2702: 	    						* evaluation
01:00000E84 301F            	  2703: 	MOVE.w	(sp)+,d0			* restore precedence
01:00000E86 222B41D8        	  2704: 	MOVE.l	prstk(a3),d1		* get stacked function pointer
01:00000E8A 6A22            	  2705: 	BPL.s	LAB_1B3C			* branch if stacked values
                            	  2706: 
01:00000E8C 3000            	  2707: 	MOVE.w	d0,d0				* copy precedence (set flags)
01:00000E8E 672E            	  2708: 	BEQ.s	LAB_1B7B			* exit if done
                            	  2709: 
01:00000E90 603C            	  2710: 	BRA.s	LAB_1B86			* else pop FAC2 & return (do function)
                            	  2711: 
                            	  2712: 			    				* was compare function (< = >)
                            	  2713: LAB_1B2A
01:00000E92 102B41B5        	  2714: 	MOVE.b	Dtypef(a3),d0		* get data type flag
01:00000E96 122B41E3        	  2715: 	MOVE.b	comp_f(a3),d1		* get compare function flag
01:00000E9A D000            	  2716: 	ADD.b	d0,d0				* string bit flag into X bit
01:00000E9C D301            	  2717: 	ADDX.b	d1,d1				* shift compare function flag
                            	  2718: 
01:00000E9E 177C000041B5    	  2719: 	MOVE.b	#0,Dtypef(a3)		* clear data type flag, $00=float
01:00000EA4 174141E3        	  2720: 	MOVE.b	d1,comp_f(a3)		* save new compare function flag
01:00000EA8 534D            	  2721: 	SUBQ.w	#1,a5				* decrement BASIC execute pointer
01:00000EAA 7230            	  2722: 	MOVEQ	#(TK_LT-TK_PLUS)*4,d1	* set offset to last operator entry
01:00000EAC 60C0            	  2723: 	BRA.s	LAB_1B13			* branch always
                            	  2724: 
